--source include/have_debug.inc

--echo #
--echo # PS-11300 S2: storage-level approximate kNN over the in-memory HNSW
--echo # graph (debug interpreter vec_knn), and the label -> row_ref map
--echo # that links graph hits back to base-PK images. No visibility
--echo # filtering here — that is the handler layer's job (S3).
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(2),
                 VECTOR KEY (v) TYPE hnsw WITH (M = 4, ef_construction = 32));

INSERT INTO t1 VALUES (100, STRING_TO_VECTOR('[0,0]')),
                      (101, STRING_TO_VECTOR('[1,0]')),
                      (102, STRING_TO_VECTOR('[0,1]')),
                      (103, STRING_TO_VECTOR('[2,2]')),
                      (104, STRING_TO_VECTOR('[5,5]'));

--echo # kNN from the origin: closer-first, exact L2^2 distances, refs are
--echo # the base PKs.
SET SESSION innodb_interpreter = 'vec_knn test/t1 0,0 3';
SELECT @@session.innodb_interpreter_output;

--echo # k larger than the point count returns everything.
SET SESSION innodb_interpreter = 'vec_knn test/t1 0,0 10';
SELECT @@session.innodb_interpreter_output;

--echo # Explicit ef only widens the search; results identical here.
SET SESSION innodb_interpreter = 'vec_knn test/t1 0,0 3 100';
SELECT @@session.innodb_interpreter_output;

--echo # DELETE: the tombstoned point disappears from search results
--echo # (hnswlib skips markDeleted nodes).
DELETE FROM t1 WHERE id = 101;
SET SESSION innodb_interpreter = 'vec_knn test/t1 0,0 10';
SELECT @@session.innodb_interpreter_output;

--echo # Rollback of a DELETE revives the point.
BEGIN;
DELETE FROM t1 WHERE id = 100;
SET SESSION innodb_interpreter = 'vec_knn test/t1 0,0 10';
SELECT @@session.innodb_interpreter_output;
ROLLBACK;
SET SESSION innodb_interpreter = 'vec_knn test/t1 0,0 10';
SELECT @@session.innodb_interpreter_output;

--echo # PK-only UPDATE repoints the map: label keeps its identity, ref
--echo # follows the new PK.
UPDATE t1 SET id = 90 WHERE id = 102;
SET SESSION innodb_interpreter = 'vec_knn test/t1 0,1 1';
SELECT @@session.innodb_interpreter_output;

--echo # ... and its rollback restores the old ref (REFRESHED tracking).
BEGIN;
UPDATE t1 SET id = 91 WHERE id = 90;
ROLLBACK;
SET SESSION innodb_interpreter = 'vec_knn test/t1 0,1 1';
SELECT @@session.innodb_interpreter_output;

--echo # Restart: map and graph rebuild from the aux on first access;
--echo # tombstones stay gone, refs intact.
--source include/restart_mysqld.inc
SELECT id FROM t1 ORDER BY id;
SET SESSION innodb_interpreter = 'vec_knn test/t1 0,0 10';
SELECT @@session.innodb_interpreter_output;

DROP TABLE t1;

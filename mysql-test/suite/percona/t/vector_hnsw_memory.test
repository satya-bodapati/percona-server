--source include/have_debug.inc

--echo #
--echo # PS-11300 C5: innodb_hnsw_max_memory bounds the total memory of all
--echo # in-memory HNSW graphs. A graph whose initial capacity does not fit
--echo # is refused at load (open only warns; the INSERT retries the load
--echo # and surfaces the failure), and raising the limit unblocks it.
--echo #

call mtr.add_suppression("Vector index graph for .* needs .* bytes but innodb_hnsw_max_memory");
call mtr.add_suppression("Failed to load vector index graph for table");

SELECT @@global.innodb_hnsw_max_memory;

--echo # VECTOR(2048) rows are ~8.2KB per graph node; the initial capacity
--echo # of 1024 nodes needs ~8.4MB — over a 1MB budget.
SET GLOBAL innodb_hnsw_max_memory = 1048576;

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(2048),
                 VECTOR KEY (v) TYPE hnsw WITH (M = 4));

--disable_query_log
--let $csv = 1.5
--let $i = 2
while ($i <= 2048) {
  --let $csv = $csv,1.5
  --inc $i
}
--enable_query_log
--error ER_OUT_OF_RESOURCES
--eval INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[$csv]'))

--echo # Nothing reached the aux table.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # Raise the budget: the deferred load succeeds and the insert works.
SET GLOBAL innodb_hnsw_max_memory = 1073741824;
--disable_query_log
--eval INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[$csv]'))
--enable_query_log
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # Shrinking the budget below current usage makes further inserts
--echo # fail (terminal until raised) but leaves loaded graphs intact.
SET GLOBAL innodb_hnsw_max_memory = 1048576;
--disable_query_log
--error ER_OUT_OF_RESOURCES
--eval INSERT INTO t1 VALUES (2, STRING_TO_VECTOR('[$csv]'))
--enable_query_log
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;

SET GLOBAL innodb_hnsw_max_memory = default;
--disable_query_log
--eval INSERT INTO t1 VALUES (2, STRING_TO_VECTOR('[$csv]'))
--enable_query_log
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;

DROP TABLE t1;

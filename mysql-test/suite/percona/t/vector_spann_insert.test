--source include/have_debug.inc
--source include/not_valgrind.inc

--echo #
--echo # SPANN S3: the INSERT path. write_row routes each vector through
--echo # the RAM head graph (loaded from the _meta HEAD range) and appends
--echo # 1..closure posting rows on the USER transaction — inserts only,
--echo # no aux updates, no rollback tracking (pure undo). A fresh table
--echo # has no heads: the implicit genesis head (head_id 0, zero vector)
--echo # exists exactly while _meta has no HEAD rows, so the head set is
--echo # never empty. spann_dump's "mem" lines show the runtime view:
--echo # head count (genesis included) and per-list appends since load.
--echo #

CREATE TABLE ti (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4),
                 VECTOR KEY vk (v) TYPE spann);

--echo # Fresh table: every insert routes to the genesis list (head 0).
--echo # The NULL vector consumes a label but is not indexed.
INSERT INTO ti VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'));
INSERT INTO ti VALUES (2, STRING_TO_VECTOR('[2,0,0,0]'));
INSERT INTO ti VALUES (3, STRING_TO_VECTOR('[3,0,0,0]'));
INSERT INTO ti VALUES (4, NULL);
SET SESSION innodb_interpreter = 'spann_dump test/ti';
SELECT @@session.innodb_interpreter_output;

--echo # Rollback is pure undo: the posting rows vanish with the trx.
--echo # The RAM append counter is a since-load delta, not transactional
--echo # (it feeds LIRE's split heuristic, nothing else) — it keeps the
--echo # bump; the disk state does not.
BEGIN;
INSERT INTO ti VALUES (5, STRING_TO_VECTOR('[4,0,0,0]'));
ROLLBACK;
SET SESSION innodb_interpreter = 'spann_dump test/ti';
SELECT @@session.innodb_interpreter_output;

--echo # Populate to 21 indexed rows (same data as the S2 build test) and
--echo # rebuild with the fixed seed: real heads replace the genesis head.
--disable_query_log
let $i = 5;
while ($i <= 20) {
  eval INSERT INTO ti VALUES ($i, STRING_TO_VECTOR('[$i, 0, 0, 0]'));
  inc $i;
}
--enable_query_log
INSERT INTO ti VALUES (22, STRING_TO_VECTOR('[11.5, 0, 0, 0]'));
ALTER TABLE ti DROP KEY vk;
SET SESSION debug = '+d,spann_build_seed_42';
ALTER TABLE ti ADD VECTOR KEY vk (v) TYPE spann, ALGORITHM=INPLACE;
SET SESSION debug = '-d,spann_build_seed_42';

--echo # Post-build insert routes to the nearest REAL head. The runtime
--echo # was re-opened after the ALTER, so the append counters restart.
INSERT INTO ti VALUES (23, STRING_TO_VECTOR('[4.9, 0, 0, 0]'));
SET SESSION innodb_interpreter = 'spann_dump test/ti';
SELECT @@session.innodb_interpreter_output;

--echo # Cold start: the first insert after a restart lazy-loads the head
--echo # graph from _meta and routes normally.
--source include/restart_mysqld.inc
INSERT INTO ti VALUES (24, STRING_TO_VECTOR('[14.9, 0, 0, 0]'));
SET SESSION innodb_interpreter = 'spann_dump test/ti';
SELECT @@session.innodb_interpreter_output;

--echo # Crash BEFORE the commit: recovery has neither the base row nor
--echo # its postings (they rode the same trx).
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SET SESSION debug = '+d,crash_commit_before';
--error 2013
INSERT INTO ti VALUES (25, STRING_TO_VECTOR('[13.1, 0, 0, 0]'));
--source include/wait_until_connected_again.inc
SELECT id FROM ti WHERE id >= 23 ORDER BY id;
SET SESSION innodb_interpreter = 'spann_dump test/ti';
SELECT @@session.innodb_interpreter_output;

--echo # Crash AFTER the commit: both sides recover to present.
--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
SET SESSION debug = '+d,crash_commit_after';
--error 2013
INSERT INTO ti VALUES (26, STRING_TO_VECTOR('[13.1, 0, 0, 0]'));
--source include/wait_until_connected_again.inc
SELECT id FROM ti WHERE id >= 23 ORDER BY id;
--echo # label_max is masked: whether the crashed statement's consumed
--echo # label was redo-synced before the kill is timing-dependent (same
--echo # masking rationale as vector_populate_crash — committed-label
--echo # uniqueness is the invariant, exact hole positions are not).
SET SESSION innodb_interpreter = 'spann_dump test/ti';
--replace_regex /label_max=[0-9]+/label_max=<M>/
SELECT @@session.innodb_interpreter_output;

--echo # Concurrency: two sessions appending to the SAME list do not
--echo # block each other — distinct labels are distinct (head_id, label)
--echo # PKs at the list's right edge; insert-intention locks are
--echo # compatible. Contrast HNSW, where concurrent inserts UPDATE each
--echo # other's neighbor rows and can wait or deadlock. The 1-second
--echo # lock_wait_timeout turns any accidental wait into a test failure.
connect (con1, localhost, root,,);
connect (con2, localhost, root,,);
--connection con1
BEGIN;
INSERT INTO ti VALUES (30, STRING_TO_VECTOR('[5.1, 0, 0, 0]'));
--connection con2
SET SESSION innodb_lock_wait_timeout = 1;
INSERT INTO ti VALUES (31, STRING_TO_VECTOR('[5.2, 0, 0, 0]'));
--connection con1
COMMIT;
--connection default
disconnect con1;
disconnect con2;
SET SESSION innodb_interpreter = 'spann_dump test/ti';
--replace_regex /label_max=[0-9]+/label_max=<M>/
SELECT @@session.innodb_interpreter_output;

--echo # TRUNCATE closes the runtime and re-mints an empty aux set: the
--echo # next insert reopens, finds no HEAD rows, and routes through a
--echo # fresh genesis head.
TRUNCATE TABLE ti;
INSERT INTO ti VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'));
SET SESSION innodb_interpreter = 'spann_dump test/ti';
SELECT @@session.innodb_interpreter_output;

DROP TABLE ti;

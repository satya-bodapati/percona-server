--echo #
--echo # PARALLEL_CHECK_TABLE (innodb_parallel_read_threads > 1) on a table
--echo # that has a vector (HNSW) index.
--echo #
--echo # row_scan_index_for_mysql() (row0mysql.cc) skips vector indexes
--echo # before the parallel-eligible branch is even reached:
--echo #   index->is_vector() -> return DB_SUCCESS immediately.
--echo # So parallel_check_table() must never be invoked for the vector
--echo # index, only for the clustered/secondary B-tree indexes. This test
--echo # proves CHECK TABLE with parallel threads enabled still succeeds
--echo # on such a table and reports every index as OK.
--echo #

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  k INT,
  v VECTOR(8) NOT NULL,
  KEY k_idx (k),
  KEY (v) TYPE hnsw WITH (M = 6)
) ENGINE=InnoDB;

--disable_query_log
let $i = 1;
while ($i <= 200)
{
  eval INSERT INTO t1 VALUES ($i, $i % 17,
       STRING_TO_VECTOR(CONCAT('[', $i, ',', $i, ',', $i, ',', $i, ',',
                                     $i, ',', $i, ',', $i, ',', $i, ']')));
  inc $i;
}
--enable_query_log

--echo # Force the parallel-read-eligible branch in row_scan_index_for_mysql.
SET SESSION innodb_parallel_read_threads = 8;

--echo # CHECK TABLE must report every index OK; the vector index is
--echo # skipped by is_vector() and never handed to parallel_check_table().
CHECK TABLE t1;

--echo # Same check, single-threaded (parallel path not taken at all), for
--echo # comparison -- result must be identical.
SET SESSION innodb_parallel_read_threads = 1;
CHECK TABLE t1;

SET SESSION innodb_parallel_read_threads = DEFAULT;
DROP TABLE t1;

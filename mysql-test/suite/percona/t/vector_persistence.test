--echo #
--echo # PS-11299: Vector index persistence — phase 1.
--echo # CREATE TABLE creates one aux .ibd per vector index and auto-adds the
--echo # hidden vec_idx_id column. SHOW CREATE must not expose vec_idx_id.
--echo #

CREATE TABLE t1 (
  id BIGINT UNSIGNED PRIMARY KEY,
  v1 VECTOR(8),
  VECTOR KEY (v1) SECONDARY_ENGINE_ATTRIBUTE '{ "type" : "hnsw" }'
);

--echo # SHOW CREATE TABLE must NOT mention vec_idx_id (HT_HIDDEN_SE).
SHOW CREATE TABLE t1;

--echo # Exactly one aux .ibd per vector index must exist on disk.
--echo # Names are vec_<hex_table_id>_<hex_index_id>.ibd — mask the ids so the
--echo # result file is stable across runs.
--let $MYSQLD_DATADIR = `SELECT @@datadir`
--replace_regex /vec_[0-9a-f]+_[0-9a-f]+\.ibd/vec_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/test vec_*.ibd

--echo # User cannot declare a column named vec_idx_id when the table has a
--echo # vector index — the name is reserved.
--error ER_WRONG_COLUMN_NAME
CREATE TABLE t2 (
  id BIGINT UNSIGNED PRIMARY KEY,
  vec_idx_id BIGINT UNSIGNED,
  v1 VECTOR(8),
  VECTOR KEY (v1) SECONDARY_ENGINE_ATTRIBUTE '{ "type" : "hnsw" }'
);

--echo # ... but it is fine to declare vec_idx_id on a table that has no
--echo # vector index — the name is only reserved when InnoDB needs it.
CREATE TABLE t3 (
  id BIGINT UNSIGNED PRIMARY KEY,
  vec_idx_id BIGINT UNSIGNED
);
DROP TABLE t3;

--echo #
--echo # RENAME TABLE — aux name is "<db>/vec_<table_id>_<index_id>" so a
--echo # same-schema rename is a no-op on disk (aux name unchanged).
--echo # Cross-schema rename is currently rejected — phase 2 will lift
--echo # this once the aux DD plumbing exists.
--echo #

--echo # Same-schema rename: aux file unchanged.
RENAME TABLE t1 TO t1_renamed;
--replace_regex /vec_[0-9a-f]+_[0-9a-f]+\.ibd/vec_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/test vec_*.ibd

--echo # Cross-schema rename: blocked.
CREATE DATABASE vec_other;
--replace_regex /errno: [0-9]+ - /errno: NN - /
--error ER_ERROR_ON_RENAME
RENAME TABLE t1_renamed TO vec_other.t1;
DROP DATABASE vec_other;

--echo # Aux file still in test/ after the failed cross-db rename.
--replace_regex /vec_[0-9a-f]+_[0-9a-f]+\.ibd/vec_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/test vec_*.ibd

DROP TABLE t1_renamed;

--echo # After DROP TABLE the aux .ibd files must be gone too — no orphans.
--list_files $MYSQLD_DATADIR/test vec_*.ibd

--source include/have_innodb_default_undo_tablespaces.inc

# PS-11175: Page tracking block_num truncation
# This test verifies that a truncated block_num in the reset point
# causes an invalid read and server exit.

# Set initial block number high enough to cause 2-byte truncation
SET GLOBAL innodb_arch_page_initial_block_num = 65536;

call mtr.add_suppression("PS-11175 underflow candidate:");
call mtr.add_suppression("16777216 bytes should have been read. Only .* bytes read. Retrying for the remaining bytes.");
call mtr.add_suppression("Retry attempts for reading partial data failed.");
call mtr.add_suppression("Tried to read 16777216 bytes at offset .*#ib_archive/.*/ib_page_[0-9]+");
call mtr.add_suppression("Operating system error number 22 in a file operation.");
call mtr.add_suppression("Error number 22 means 'Invalid argument'");
call mtr.add_suppression("read' returned OS error 122. Cannot continue operation");
call mtr.add_suppression("\\[ERROR\\] .*MY-012981.* Cannot continue operation.");
call mtr.add_suppression("Operating system error number 39 in a file operation.");
call mtr.add_suppression("Error number 39 means 'Directory not empty'");
call mtr.add_suppression("File #ib_archive/page_group_.+: 'rmdir' returned OS error 139.");
call mtr.add_suppression("Page archiver system's recovery failed.");

CREATE TABLE t_1000 (a INT AUTO_INCREMENT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t_big (a INT AUTO_INCREMENT PRIMARY KEY, pad LONGBLOB) ENGINE=InnoDB;

INSTALL COMPONENT 'file://component_mysqlbackup';

# Populate t_1000
--disable_query_log
let $i = 0;
while ($i < 1000) {
  INSERT INTO t_1000 VALUES ();
  inc $i;
}
--enable_query_log

# Start page tracking
let $start_lsn = `SELECT mysqlbackup_page_track_set(1)`;

# Write data to fill ib_page_0 and cross into ib_page_1
let $i = 0;
while ($i < 4) {
  INSERT INTO t_big (pad) SELECT REPEAT('x', 14000) FROM t_1000;
  inc $i;
}

# Write a bit more to cross 65536 but stay within the empty offset range
INSERT INTO t_big (pad) SELECT REPEAT('x', 14000) FROM t_1000 LIMIT 100;
INSERT INTO t_big (pad) SELECT REPEAT('x', 14000) FROM t_1000 LIMIT 100;
INSERT INTO t_big (pad) SELECT REPEAT('x', 14000) FROM t_1000 LIMIT 100;

# Create the reset point that will overflow and map to an empty offset
let $tmp = `SELECT mysqlbackup_page_track_set(0)`;
let $crash_lsn = `SELECT mysqlbackup_page_track_set(1)`;
--echo crash_lsn: $crash_lsn

# Restart the server
--source include/restart_mysqld.inc

SET GLOBAL mysqlbackup.backupid = "1";

--exec rm -f $MYSQLD_DATADIR/backup_scratch_dir/1.idx
let $final_lsn = `SELECT mysqlbackup_page_track_set(1)`;

# This should crash the server
--exec echo "wait" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--error 2013,2006,1053,0,CR_SERVER_LOST,CR_SERVER_GONE_ERROR
eval SELECT mysqlbackup_page_track_get_changed_pages($crash_lsn, $final_lsn);

# Wait for the server to fully exit
--source include/wait_until_disconnected.inc

# In release builds, it might not crash during init because ut_ad is disabled.
# We just verify that we can clean up and restart.

# We need to clean up the archive files so the server can start again for the next tests
--exec rm -rf $MYSQLD_DATADIR/#ib_archive
--exec rm -rf $MYSQLD_DATADIR/#innodb_redo
--exec rm -f $MYSQLD_DATADIR/#ib_16384_0.dblwr
--exec rm -f $MYSQLD_DATADIR/#ib_16384_1.dblwr
--exec rm -f $MYSQLD_DATADIR/ibdata1
--exec rm -f $MYSQLD_DATADIR/undo_001
--exec rm -f $MYSQLD_DATADIR/undo_002
--exec rm -f $MYSQLD_DATADIR/mysql.ibd

--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc

DROP TABLE t_big;
DROP TABLE t_1000;
UNINSTALL COMPONENT 'file://component_mysqlbackup';

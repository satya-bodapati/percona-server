--echo #
--echo # PS-11299 (amended by PS-11300): this test originally verified the
--echo # INPLACE prepare error path — aux created, prepare fails, cleanup
--echo # drops the aux (knob vec_prepare_fail_after_aux_create).
--echo #
--echo # Since PS-11300, ADD VECTOR INDEX never runs INPLACE: it is refused
--echo # at check_if_supported_inplace_alter because the native rebuild
--echo # cannot build the HNSW graph, and the COPY fallback populates it
--echo # row by row. The prepare-path aux creation (and its error cleanup)
--echo # is retained in the engine for a future INPLACE re-enablement but
--echo # is unreachable from SQL — which is exactly what this now guards:
--echo # with the failure knob ARMED, ADD VECTOR INDEX must still succeed,
--echo # proving the INPLACE prepare path was never entered.
--echo #

--source include/have_debug.inc

--let $MYSQLD_DATADIR = `SELECT @@datadir`

CREATE TABLE tva (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(8));

--echo # Explicit INPLACE: refused up front, before any aux work.
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE tva ADD VECTOR KEY (v) TYPE hnsw WITH (M = 6), ALGORITHM=INPLACE;
--list_files $MYSQLD_DATADIR/test vec_*.ibd

--echo # Knob armed + server-picked algorithm: COPY runs, the INPLACE
--echo # prepare path (where the knob lives) is never entered, the ALTER
--echo # succeeds and exactly one aux .ibd exists.
SET @@SESSION.debug = '+d,vec_prepare_fail_after_aux_create';
ALTER TABLE tva ADD VECTOR KEY (v) TYPE hnsw WITH (M = 6);
SET @@SESSION.debug = '-d,vec_prepare_fail_after_aux_create';

SHOW CREATE TABLE tva;
--replace_regex /vec_[0-9a-f]+_[0-9a-f]+\.ibd/vec_<TID>_<IID>.ibd/
--list_files $MYSQLD_DATADIR/test vec_*.ibd

DROP TABLE tva;
--list_files $MYSQLD_DATADIR/test vec_*.ibd

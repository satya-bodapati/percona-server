--echo #
--echo # SPANN S1: TYPE spann aux lifecycle — three tables
--echo # (vec_spann_<t>_<i>, _meta, _dead), full DDL matrix. The index is
--echo # NOT populated in S1: write hooks skip (no runtime) and the
--echo # optimizer serves vector queries from the exact path.
--echo #

--let $MYSQLD_DATADIR = `SELECT @@datadir`

CREATE TABLE ts (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4),
                 VECTOR KEY vk (v) TYPE spann);
SHOW CREATE TABLE ts;
--replace_regex /vec_spann_[0-9a-f]+_[0-9a-f]+/vec_spann_<TID>_<IID>/
--list_files $MYSQLD_DATADIR/test vec_*.ibd

--echo # WITH() params are rejected for spann in S1.
--error ER_ILLEGAL_INDEX_CONSTRUCTION_PARAMETER
CREATE TABLE ts2 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4),
                  VECTOR KEY (v) TYPE spann WITH (M = 4));

--echo # DML works; the index is simply not populated (S1 posture).
INSERT INTO ts VALUES (1, STRING_TO_VECTOR('[1,1,1,1]')),
                      (2, STRING_TO_VECTOR('[2,2,2,2]'));
UPDATE ts SET v = STRING_TO_VECTOR('[3,3,3,3]') WHERE id = 2;
DELETE FROM ts WHERE id = 1;
SELECT id FROM ts;

--echo # Vector query runs the EXACT path (no vector_knn): correct
--echo # results until the spann read path lands (S5).
INSERT INTO ts VALUES (1, STRING_TO_VECTOR('[1,1,1,1]'));
EXPLAIN SELECT id FROM ts
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,1,1,1]'), 'EUCLIDEAN') LIMIT 2;
SELECT id FROM ts
  ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,1,1,1]'), 'EUCLIDEAN') LIMIT 2;

--echo # TRUNCATE recycles all three aux tables.
TRUNCATE TABLE ts;
--replace_regex /vec_spann_[0-9a-f]+_[0-9a-f]+/vec_spann_<TID>_<IID>/
--list_files $MYSQLD_DATADIR/test vec_*.ibd

--echo # Cross-schema RENAME moves the set.
CREATE DATABASE spanndb;
RENAME TABLE ts TO spanndb.ts;
--list_files $MYSQLD_DATADIR/test vec_*.ibd
--replace_regex /vec_spann_[0-9a-f]+_[0-9a-f]+/vec_spann_<TID>_<IID>/
--list_files $MYSQLD_DATADIR/spanndb vec_*.ibd

--echo # DROP DATABASE sweeps the set.
DROP DATABASE spanndb;

--echo # DROP TABLE drops all three.
CREATE TABLE ts3 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4),
                  VECTOR KEY (v) TYPE spann);
DROP TABLE ts3;
--list_files $MYSQLD_DATADIR/test vec_*.ibd

--echo # hnsw unaffected; unknown TYPE still rejected.
--error ER_INDEX_TYPE_NOT_SUPPORTED_FOR_VECTOR_INDEX
CREATE TABLE tbad (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4),
                   VECTOR KEY (v) TYPE nosuch);
CREATE TABLE th (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4),
                 VECTOR KEY (v) TYPE hnsw WITH (M = 4));
--replace_regex /vec_hnsw_[0-9a-f]+_[0-9a-f]+/vec_hnsw_<TID>_<IID>/
--list_files $MYSQLD_DATADIR/test vec_*.ibd
DROP TABLE th;

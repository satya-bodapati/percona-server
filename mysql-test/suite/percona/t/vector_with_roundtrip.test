--echo #
--echo # PS-11203 (formerly bug 7 in PS-11203-syntax-bugs.md):
--echo # VECTOR KEY (...) TYPE hnsw WITH (...) options must survive an
--echo # ALTER TABLE that rebuilds the table.
--echo #
--echo # Root cause: mysql_prepare_alter_table built a Key_spec for the
--echo # carried-forward vector index without populating its
--echo # construction_params. fill_dd_indexes_from_keyinfo then skipped
--echo # writing vector_construction_params into the new dd::Index, and
--echo # SHOW CREATE TABLE had nothing to print.
--echo #
--echo # Fix: re-parse key_info->vector_construction_params (the
--echo # serialized "k=v,k=v" form persisted on the OLD dd::Index) back
--echo # into IndexConstructionParam entries in the new Key_spec.
--echo #

--echo # === Single WITH option (M) ===
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 id2 BIGINT UNSIGNED NOT NULL,
                 v VECTOR(8),
                 VECTOR KEY (v) TYPE hnsw WITH (M = 6));
SHOW CREATE TABLE t1;
ALTER TABLE t1 DROP PRIMARY KEY, ADD PRIMARY KEY (id2);
SHOW CREATE TABLE t1;
DROP TABLE t1;

--echo # === Multiple WITH options (M + metric) ===
CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY,
                 id2 BIGINT UNSIGNED NOT NULL,
                 v VECTOR(8),
                 VECTOR KEY (v) TYPE hnsw WITH (M = 4, metric = euclidean));
SHOW CREATE TABLE t2;
ALTER TABLE t2 DROP PRIMARY KEY, ADD PRIMARY KEY (id2);
SHOW CREATE TABLE t2;
DROP TABLE t2;

--echo # === Carry through an ADD COLUMN that triggers rebuild ===
CREATE TABLE t3 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(8),
                 VECTOR KEY (v) TYPE hnsw WITH (M = 8));
ALTER TABLE t3 ADD COLUMN c INT, ALGORITHM=COPY;
SHOW CREATE TABLE t3;
DROP TABLE t3;


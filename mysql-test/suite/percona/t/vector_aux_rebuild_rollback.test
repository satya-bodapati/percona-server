--echo #
--echo # PS-11299 (amended by PS-11300): this test originally verified the
--echo # INPLACE rebuild-rollback cleanup — ADD VECTOR INDEX on an
--echo # INSTANT-altered base forced the rebuild path, the knob failed
--echo # prepare, and error_handling/error_handled had to drop the aux on
--echo # the thrown-away ctx->new_table.
--echo #
--echo # Since PS-11300, the FIRST ever ADD VECTOR INDEX never runs INPLACE
--echo # (the retained-column re-ADD does — see vector_aux_prepare_error /
--echo # vector_index_rebuild; refusal below is
--echo # check_if_supported_inplace_alter; COPY builds the graph row by
--echo # row), so that rollback path is unreachable from SQL. The engine
--echo # cleanup code is retained for a future INPLACE re-enablement; what
--echo # this now guards is the refusal itself: with the failure knob
--echo # ARMED, the ALTER on an INSTANT-altered base must succeed via
--echo # COPY — the knob's path is never entered.
--echo #

--source include/have_debug.inc

--let $MYSQLD_DATADIR = `SELECT @@datadir`

CREATE TABLE tvr (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(8));

--echo # INSTANT-alter the base first — the historical rebuild-forcing
--echo # precondition, kept to preserve the scenario shape.
ALTER TABLE tvr ADD COLUMN c1 INT, ALGORITHM=INSTANT;

--echo # Explicit INPLACE: refused up front.
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE tvr ADD VECTOR KEY (v) TYPE hnsw WITH (M = 6), ALGORITHM=INPLACE;

SET @@SESSION.debug = '+d,vec_prepare_fail_after_aux_create';
ALTER TABLE tvr ADD VECTOR KEY (v) TYPE hnsw WITH (M = 6);
SET @@SESSION.debug = '-d,vec_prepare_fail_after_aux_create';

SHOW CREATE TABLE tvr;
--replace_regex /vec_hnsw_[0-9a-f]+_[0-9a-f]+/vec_hnsw_<TID>_<IID>/
--list_files $MYSQLD_DATADIR/test vec_*.ibd

DROP TABLE tvr;
--list_files $MYSQLD_DATADIR/test vec_*.ibd

--source include/have_debug.inc

--echo #
--echo # A crash-created missing neighbor -- the main NODE_LOST scenario
--echo # documented in vector-common/hnsw.h: an insert that crashed before
--echo # insert_cb, after a concurrent insert had already referenced it as
--echo # a neighbor -- fails the whole statement on the FIRST query that
--echo # touches the now-missing node, even though HNSW's own traversal
--echo # already treats a failed lazy load as "skip this neighbor" (see
--echo # hnsw.h:389, 392, 1457, 1611). Once the node is cached NODE_LOST in
--echo # memory, every LATER query skips it silently and succeeds -- same
--echo # underlying condition, inconsistent outcome.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(2) NOT NULL,
                 KEY vk (v) TYPE hnsw WITH (M = 4));

INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[0,0]')),
                      (2, STRING_TO_VECTOR('[1,0]')),
                      (3, STRING_TO_VECTOR('[2,0]')),
                      (4, STRING_TO_VECTOR('[3,0]')),
                      (5, STRING_TO_VECTOR('[4,0]')),
                      (6, STRING_TO_VECTOR('[5,0]'));

--echo # Simulate the crash artifact: overwrite slot 0 of the entry
--echo # point's own neighbor list to name an id with no aux row. Every
--echo # OTHER real neighbor of the entry point is left untouched, so the
--echo # rest of the graph stays reachable -- this is the same on-disk
--echo # shape an actual crash would leave; it just skips needing one.
SET SESSION innodb_interpreter = 'vec_poison_entry_neighbor test/t1 999999999';
SELECT @@session.innodb_interpreter_output;

--echo # Force a cold reload: without a restart the entry point node is
--echo # already NODE_COMPLETE in memory and the on-disk edit above is
--echo # never looked at again.
--source include/restart_mysqld.inc

--echo # The insert path lazily loads neighbor stubs the same way search
--echo # does (hnsw.h:392, 1457), through the same ctx that now defaults
--echo # loading_entry_point to false -- so it must not fail here either.
INSERT INTO t1 VALUES (7, STRING_TO_VECTOR('[0.5,0]'));

--echo # Both queries must behave the same way: the missing neighbor is
--echo # skipped, not fatal, whether this is the first touch (which faults
--echo # it in and marks it NODE_LOST) or a later one (which finds it
--echo # already NODE_LOST). Before the fix, the first of these two
--echo # identical queries fails with ER_KEY_NOT_FOUND and only the second
--echo # succeeds. The row count is checked, not specific ids -- HNSW's
--echo # random layer draw picks a different entry point each run, so
--echo # which node is skipped (and where it sat in the search order)
--echo # varies, but the real, undamaged rest of the graph always yields
--echo # the full LIMIT once the missing neighbor is correctly skipped
--echo # instead of aborting the statement.
SELECT COUNT(*) AS rows_found FROM (
  SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3
) first_query;
SELECT COUNT(*) AS rows_found FROM (
  SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3
) second_query;

DROP TABLE t1;

--echo #
--echo # PS-11300: fence-posts. Vector indexes cannot coexist with (a)
--echo # partitioned tables — ha_innopart has no vector maintenance wiring —
--echo # or (b) CASCADE referential actions on the indexed table — cascaded
--echo # DML runs inside the engine, bypassing the handler hooks that keep
--echo # the graph and aux in sync. Non-mutating FK actions stay allowed.
--echo #

--echo # (a) CREATE of a partitioned table with a vector index.
--error ER_VECTOR_INDEX_WITH_PARTITIONED_TABLE
CREATE TABLE tp (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4),
                 VECTOR KEY (v) TYPE hnsw)
  PARTITION BY HASH(id) PARTITIONS 2;

--echo # ADD VECTOR INDEX on an existing partitioned table.
CREATE TABLE tp (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4))
  PARTITION BY HASH(id) PARTITIONS 2;
--error ER_VECTOR_INDEX_WITH_PARTITIONED_TABLE
ALTER TABLE tp ADD VECTOR KEY (v) TYPE hnsw;
DROP TABLE tp;

--echo # PARTITION BY on an existing vector-indexed table.
CREATE TABLE tv (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4),
                 VECTOR KEY (v) TYPE hnsw);
--error ER_VECTOR_INDEX_WITH_PARTITIONED_TABLE
ALTER TABLE tv PARTITION BY HASH(id) PARTITIONS 2;
DROP TABLE tv;

--echo #
--echo # (b) CASCADE actions on a vector-indexed child table.
--echo #
CREATE TABLE parent (id BIGINT UNSIGNED PRIMARY KEY);

--echo # CREATE with ON DELETE CASCADE.
--error ER_VECTOR_INDEX_WITH_CASCADING_FK
CREATE TABLE child (id BIGINT UNSIGNED PRIMARY KEY,
                    pid BIGINT UNSIGNED, v VECTOR(4),
                    VECTOR KEY (v) TYPE hnsw,
                    FOREIGN KEY (pid) REFERENCES parent(id)
                      ON DELETE CASCADE);

--echo # CREATE with ON UPDATE CASCADE.
--error ER_VECTOR_INDEX_WITH_CASCADING_FK
CREATE TABLE child (id BIGINT UNSIGNED PRIMARY KEY,
                    pid BIGINT UNSIGNED, v VECTOR(4),
                    VECTOR KEY (v) TYPE hnsw,
                    FOREIGN KEY (pid) REFERENCES parent(id)
                      ON UPDATE CASCADE);

--echo # ADD a cascading FK to a vector-indexed table.
CREATE TABLE child (id BIGINT UNSIGNED PRIMARY KEY,
                    pid BIGINT UNSIGNED, v VECTOR(4),
                    VECTOR KEY (v) TYPE hnsw);
--error ER_VECTOR_INDEX_WITH_CASCADING_FK
ALTER TABLE child ADD FOREIGN KEY (pid) REFERENCES parent(id)
  ON DELETE CASCADE;

--echo # ADD VECTOR INDEX to a table that already has a cascading FK.
DROP TABLE child;
CREATE TABLE child (id BIGINT UNSIGNED PRIMARY KEY,
                    pid BIGINT UNSIGNED, v VECTOR(4),
                    FOREIGN KEY (pid) REFERENCES parent(id)
                      ON DELETE CASCADE);
--error ER_VECTOR_INDEX_WITH_CASCADING_FK
ALTER TABLE child ADD VECTOR KEY (v) TYPE hnsw;
DROP TABLE child;

--echo # Non-mutating actions remain allowed: RESTRICT refuses the parent
--echo # DELETE (no cascaded child DML), SET NULL only nulls the FK column
--echo # (a non-PK, non-vector update — no index maintenance needed).
CREATE TABLE child (id BIGINT UNSIGNED PRIMARY KEY,
                    pid BIGINT UNSIGNED, v VECTOR(4),
                    VECTOR KEY (v) TYPE hnsw,
                    FOREIGN KEY (pid) REFERENCES parent(id)
                      ON DELETE SET NULL ON UPDATE RESTRICT);
INSERT INTO parent VALUES (1);
INSERT INTO child VALUES (10, 1, STRING_TO_VECTOR('[1,0,0,0]'));
--error ER_ROW_IS_REFERENCED_2
UPDATE parent SET id = 2 WHERE id = 1;
DELETE FROM parent WHERE id = 1;
SELECT id, pid FROM child;
SELECT id FROM child ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;

DROP TABLE child, parent;

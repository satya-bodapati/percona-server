--source include/have_debug.inc
--source include/have_debug_sync.inc

--echo #
--echo # (vec_runtime_open() (vec0hnsw.cc), vec_runtime_get_or_wait() (vec0hnsw.h)
--echo # / its slow path vec_runtime_wait_slow() (vec0hnsw.cc))
--echo #
--echo # dict_index_t::vec == nullptr and dict_index_t::vec_open_err ==
--echo # DB_ERROR_UNSET together are ambiguous: they describe BOTH "nobody has
--echo # ever attempted to open this index's runtime" AND "somebody is opening
--echo # it right now, hasn't finished". Before this fix, a session whose own
--echo # handler skipped vec_runtime_open() entirely (the "key == nullptr"
--echo # branch in ha_innobase::open) could land on a read path while a
--echo # DIFFERENT session was mid-way through the very first open of that
--echo # index anywhere, see that ambiguous zero-init state, and wrongly
--echo # report "never attempted" - here, a false empty result - while the
--echo # real answer was seconds away.
--echo #
--echo # This test drives exactly that interleaving with two connections and
--echo # DEBUG_SYNC: con1 is parked inside vec_runtime_open()'s slow path
--echo # (vec_opening already true, index->vec still null) via the
--echo # vec_runtime_opening sync point; con2's own handler is forced, via the
--echo # vec_open_skip_key debug knob, to skip vec_runtime_open() the way a
--echo # non-vector-key open legitimately would, then runs a vector search
--echo # that can only reach vec_runtime_get_or_wait()'s waiter path. The
--echo # second sync point, vec_runtime_open_wait, marks the instant con2 has
--echo # genuinely entered that wait - without it, releasing con1 right after
--echo # con2's --send would race con2 actually reaching the wait, and could
--echo # make the test pass by lucky timing even on the old, buggy code.
--echo #
--echo # Before this fix con2 would answer immediately with zero rows - wrong,
--echo # since the table has a matching row - instead of waiting for con1 to
--echo # finish and then answering correctly.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
                 KEY (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'));

--source include/restart_mysqld.inc

--echo # Nothing is dict-cached after the restart, so con1's INSERT below is
--echo # what opens t1 and reaches vec_runtime_open() for the very first time
--echo # since the restart - exactly the window this test needs to hold open.
--connect (con1, localhost, root,,)
SET DEBUG_SYNC = 'vec_runtime_opening SIGNAL opener_parked WAIT_FOR resume_open';
--send INSERT INTO t1 VALUES (2, STRING_TO_VECTOR('[0,1,0,0]'))

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR opener_parked';

--echo # con1 is now parked with vec_opening = true and index->vec still
--echo # null. con2's own open must not attempt vec_runtime_open() itself -
--echo # vec_open_skip_key forces the same skip a genuinely non-vector KEY
--echo # lookup takes in ha_innobase::open - so its search below can only
--echo # reach a real answer through vec_runtime_get_or_wait() waiting on
--echo # con1, never through its own open.
--connect (con2, localhost, root,,)
SET SESSION debug = '+d,vec_open_skip_key';
SET DEBUG_SYNC = 'vec_runtime_open_wait SIGNAL waiter_parked';
--send SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 5

--connection default
--echo # Do not release con1 until con2 has genuinely reached the wait -
--echo # otherwise this test could pass on old, buggy code purely because
--echo # con1 happened to finish before con2's read ever checked vec_opening.
SET DEBUG_SYNC = 'now WAIT_FOR waiter_parked';
SET DEBUG_SYNC = 'now SIGNAL resume_open';

--connection con1
--reap

--echo # con2's search only completes once con1's open has finished - it
--echo # must see the real, non-empty result rather than the false EOF a
--echo # racing read would have reported.
--connection con2
--reap
SET SESSION debug = '-d,vec_open_skip_key';

--connection default
--disconnect con1
--disconnect con2
SET DEBUG_SYNC = 'RESET';

--echo # Ordinary behaviour is unaffected: a fresh session opens the index
--echo # normally and both rows are visible.
SELECT id FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 5;

DROP TABLE t1;

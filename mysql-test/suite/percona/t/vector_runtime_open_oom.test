--source include/have_debug.inc

--echo #
--echo # vec_runtime_open() (vec0hnsw.cc) lazily builds the in-memory HNSW
--echo # runtime for a vector index on every ha_innobase::open(). Before
--echo # this fix, an allocation failure while constructing that runtime
--echo # object was logged and left index->vec null, but nothing else
--echo # noticed: vec_insert_row()/vec_update_row() treated a null runtime
--echo # exactly like "nothing to do" (a plain `continue`) and let the base
--echo # row commit anyway, with no corresponding entry in the graph or its
--echo # aux table. The index silently drifted out of sync with the table -
--echo # no diagnostic beyond the one log line from the open, and no failed
--echo # statement pointing at the row that got lost.
--echo #
--echo # vec_runtime_open_oom forces the allocation-failure branch inside
--echo # vec_runtime_open() deterministically, standing in for a genuinely
--echo # exhausted heap. A server restart guarantees the table is not
--echo # dict-cached, so the very first touch after the restart is the one
--echo # that reopens the handler and reaches vec_runtime_open().
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
                 KEY (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'));

--source include/restart_mysqld.inc

--echo # Nothing is dict-cached after the restart: the INSERT below is what
--echo # opens t1 and, with the knob armed, is also what discovers the
--echo # runtime failed to build.
SET SESSION debug = '+d,vec_runtime_open_oom';
--error ER_GET_ERRNO,ER_INTERNAL_ERROR,1
INSERT INTO t1 VALUES (2, STRING_TO_VECTOR('[0,1,0,0]'));
SET SESSION debug = '-d,vec_runtime_open_oom';

--echo # No runtime is attached to the index - confirming the injection
--echo # actually forced the branch this test exists to cover, rather than
--echo # the INSERT failing for some unrelated reason.
SET SESSION innodb_interpreter = 'vec_runtime_info test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # The failed statement left no trace: row 2 never reached the base
--echo # table either, so the table and its vector index cannot disagree
--echo # about it. Before this fix the row would have been visible here
--echo # while the graph silently never learned about it.
SELECT id FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;

--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $assert_select = Failed to open vector runtime for index v on table test/t1: out of memory
--let $assert_count = 1
--let $assert_text = vec_runtime_open logs the out-of-memory reason
--source include/assert_grep.inc

--let $assert_select = Cannot insert into the vector index v on table test/t1: no runtime is open for it
--let $assert_count = 1
--let $assert_text = vec_insert_row refuses rather than silently dropping the row
--source include/assert_grep.inc

--echo # Once the injection is gone, reopening the table (FLUSH TABLES
--echo # forces it - see the ha_innobase::open comment) lets
--echo # vec_runtime_open() retry and succeed, and normal DML resumes.
FLUSH TABLES t1;
INSERT INTO t1 VALUES (2, STRING_TO_VECTOR('[0,1,0,0]'));
SET SESSION innodb_interpreter = 'vec_runtime_info test/t1';
SELECT @@session.innodb_interpreter_output;
SELECT id FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 2;

DROP TABLE t1;

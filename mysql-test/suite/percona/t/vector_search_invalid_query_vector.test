--source include/have_debug.inc

--echo #
--echo # PS-11300: a NULL, malformed, or dimension-mismatched query vector
--echo # must not activate JT_VECTOR.
--echo #
--echo # optimize_vector_query() used to pick the kNN index for any
--echo # constant that was merely const_for_execution(), without looking
--echo # at its value. The handler's vec_read_first() then mapped every
--echo # one of these bad constants to HA_ERR_END_OF_FILE:
--echo #   - a NULL query vector silently returned 0 rows, although the
--echo #     exact path returns LIMIT rows (NULL propagates through
--echo #     val_real() and does not filter anything out);
--echo #   - a malformed or dimension-mismatched constant silently
--echo #     returned 0 rows instead of the ER_TO_VECTOR_CONVERSION /
--echo #     ER_WRONG_ARGUMENTS error the exact path raises.
--echo #
--echo # The optimizer now validates the constant before activating the
--echo # index, so these three shapes fall back to the exact path and get
--echo # identical results/errors whether or not a vector index exists.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(2) NOT NULL,
                 KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (100, STRING_TO_VECTOR('[0,0]')),
                      (101, STRING_TO_VECTOR('[1,0]')),
                      (102, STRING_TO_VECTOR('[0,2]')),
                      (103, STRING_TO_VECTOR('[3,0]')),
                      (104, STRING_TO_VECTOR('[0,4]')),
                      (105, STRING_TO_VECTOR('[5,0]'));

--echo # Baseline: a well-formed, correctly-sized constant is still served
--echo # by the index.
--replace_column 10 # 11 #
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;

--echo #
--echo # NULL query vector: stays on the exact path. LIMIT is still
--echo # satisfied from the 6 rows in the table, matching the exact path
--echo # run with the index disabled - not the 0 rows JT_VECTOR used to
--echo # produce for it.
--echo #
SELECT COUNT(*) FROM (SELECT id FROM t1 ORDER BY DISTANCE(v, NULL, 'EUCLIDEAN') LIMIT 3) derived;
SELECT COUNT(*) FROM (SELECT id FROM t1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, NULL, 'EUCLIDEAN') LIMIT 3) derived;

--echo #
--echo # Malformed query vector: a binary string whose length is not a
--echo # multiple of the float width cannot be a vector at all. Same
--echo # ER_TO_VECTOR_CONVERSION error with or without the index - not the
--echo # silent empty result JT_VECTOR used to produce for it.
--echo #
--error ER_TO_VECTOR_CONVERSION
SELECT id FROM t1 ORDER BY DISTANCE(v, _binary'abc', 'EUCLIDEAN') LIMIT 3;
--error ER_TO_VECTOR_CONVERSION
SELECT id FROM t1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, _binary'abc', 'EUCLIDEAN') LIMIT 3;

--echo #
--echo # Dimension-mismatched query vector: v is VECTOR(2), the constant
--echo # has 3 dimensions. Same ER_WRONG_ARGUMENTS error with or without
--echo # the index - not the silent empty result JT_VECTOR used to
--echo # produce for it.
--echo #
--error ER_WRONG_ARGUMENTS
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,2,3]'), 'EUCLIDEAN') LIMIT 3;
--error ER_WRONG_ARGUMENTS
SELECT id FROM t1 IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,2,3]'), 'EUCLIDEAN') LIMIT 3;

--echo # A well-formed constant is still served after the bad ones: the
--echo # index is left usable, not disabled by the earlier failures.
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 3;

DROP TABLE t1;

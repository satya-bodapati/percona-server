--source include/have_debug.inc
--source include/have_debug_sync.inc

--echo #
--echo # SPANN L2+: the GC ORPHAN rule. A maintenance job snapshots with
--echo # latest-read, so it can copy a posting whose inserting transaction
--echo # later ROLLS BACK: the original posting vanishes with the undo, the
--echo # job's committed copy survives as an orphan — invisible to every
--echo # reader (base fetch misses) but propagating through future
--echo # snapshots. GC now probes each surviving label's base row under the
--echo # oldest view and sweeps (a) labels whose base PK record is
--echo # physically gone, and (b) labels whose PK was REUSED by a later
--echo # insert (visible vec_idx_id differs). Both variants below.
--echo #

SET GLOBAL innodb_monitor_enable = 'module_vec';

CREATE TABLE torf (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(2),
                   VECTOR KEY vk (v) TYPE spann);
INSERT INTO torf VALUES (1, STRING_TO_VECTOR('[1,0]'));
INSERT INTO torf VALUES (2, STRING_TO_VECTOR('[2,0]'));
INSERT INTO torf VALUES (3, STRING_TO_VECTOR('[3,0]'));
INSERT INTO torf VALUES (4, STRING_TO_VECTOR('[4,0]'));

--echo #
--echo # Variant (a): rollback, PK never reused — base record physically
--echo # absent. The uncommitted insert (label 5) is snapshotted by a
--echo # paused re-sample, then rolled back before the job resumes.
--echo #
connect (con2, localhost, root,,);
--connection con2
BEGIN;
INSERT INTO torf VALUES (5, STRING_TO_VECTOR('[5,0]'));
--connection default
SET GLOBAL debug = '+d,spann_build_seed_42,spann_resample_pause';
SET SESSION innodb_interpreter = 'spann_maint test/torf resample nowait';
SELECT @@session.innodb_interpreter_output;
SET DEBUG_SYNC = 'now WAIT_FOR spann_resample_paused';
--connection con2
ROLLBACK;
--connection default
SET DEBUG_SYNC = 'now SIGNAL spann_resample_go';
SET GLOBAL debug = '-d,spann_resample_pause';
--let $wait_condition = SELECT COUNT = 1 FROM INFORMATION_SCHEMA.INNODB_METRICS WHERE NAME = 'vec_spann_resamples'
--source include/wait_condition.inc
SET GLOBAL debug = '-d,spann_build_seed_42';

--echo # The orphan (label 5) sits in the new generation; readers skip it
--echo # (base fetch misses), so results stay correct.
SET SESSION innodb_interpreter = 'spann_dump test/torf';
SELECT @@session.innodb_interpreter_output;
SELECT id FROM torf ORDER BY DISTANCE(v, STRING_TO_VECTOR('[5,0]'), 'EUCLIDEAN') LIMIT 1;

--echo # GC probes the base rows and sweeps it.
SET SESSION innodb_interpreter = 'spann_maint test/torf gc';
SELECT @@session.innodb_interpreter_output;
SET SESSION innodb_interpreter = 'spann_dump test/torf';
SELECT @@session.innodb_interpreter_output;

--echo #
--echo # Variant (b): rollback, then the SAME PK is reused by a committed
--echo # insert. The orphan's row_ref resolves to a base row again — but to
--echo # a different row identity (its vec_idx_id is the new label), which
--echo # is exactly what the probe compares.
--echo #
--connection con2
BEGIN;
INSERT INTO torf VALUES (7, STRING_TO_VECTOR('[20,0]'));
--connection default
SET GLOBAL debug = '+d,spann_build_seed_42,spann_resample_pause';
SET SESSION innodb_interpreter = 'spann_maint test/torf resample nowait';
SELECT @@session.innodb_interpreter_output;
SET DEBUG_SYNC = 'now WAIT_FOR spann_resample_paused';
--connection con2
ROLLBACK;
--connection default
SET DEBUG_SYNC = 'now SIGNAL spann_resample_go';
SET GLOBAL debug = '-d,spann_resample_pause';
--let $wait_condition = SELECT COUNT = 2 FROM INFORMATION_SCHEMA.INNODB_METRICS WHERE NAME = 'vec_spann_resamples'
--source include/wait_condition.inc
SET GLOBAL debug = '-d,spann_build_seed_42';
--echo # PK 7 reused with a different vector (fresh label).
INSERT INTO torf VALUES (7, STRING_TO_VECTOR('[30,0]'));

SET SESSION innodb_interpreter = 'spann_dump test/torf';
SELECT @@session.innodb_interpreter_output;
SET SESSION innodb_interpreter = 'spann_maint test/torf gc';
SELECT @@session.innodb_interpreter_output;
SET SESSION innodb_interpreter = 'spann_dump test/torf';
SELECT @@session.innodb_interpreter_output;

--echo # The legitimate reused-PK row serves; the stale-vector orphan is
--echo # gone.
SELECT id FROM torf ORDER BY DISTANCE(v, STRING_TO_VECTOR('[30,0]'), 'EUCLIDEAN') LIMIT 1;
SELECT id FROM torf IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[30,0]'), 'EUCLIDEAN') LIMIT 1;

disconnect con2;
DROP TABLE torf;
SET GLOBAL innodb_monitor_disable = 'module_vec';
SET GLOBAL innodb_monitor_reset_all = 'module_vec';
--disable_warnings
SET GLOBAL innodb_monitor_enable = default;
SET GLOBAL innodb_monitor_disable = default;
SET GLOBAL innodb_monitor_reset_all = default;
--enable_warnings

--source include/have_debug.inc

--echo #
--echo # PS-11299: DROP INDEX on a vector index must not silently swallow a
--echo # failure to physically drop the index's auxiliary table.
--echo #
--echo # vec_aux_drop_one_table's return value used to be discarded in
--echo # commit_cache_norebuild, so a failed aux drop left the DROP INDEX
--echo # reporting success while the auxiliary table was orphaned, with no
--echo # trace visible to the client (only a server error log entry). This
--echo # forces that failure via a DBUG point and checks a warning surfaces.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(2) NOT NULL,
                 KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[0,0]')),
                      (2, STRING_TO_VECTOR('[1,1]'));

SET DEBUG = '+d,vec_aux_drop_force_error';
ALTER TABLE t1 DROP INDEX vk;

--echo # The DROP still succeeds (the ALTER is already past its
--echo # point-of-no-return), but the aux-drop failure must be visible.
SHOW WARNINGS;
SET DEBUG = '-d,vec_aux_drop_force_error';

--echo # And the index itself is gone from the table.
SHOW CREATE TABLE t1;

DROP TABLE t1;

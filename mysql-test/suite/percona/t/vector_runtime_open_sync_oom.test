--source include/have_debug.inc
--source include/have_debug_sync.inc

--echo #
--echo # vec_open_sync_alloc() (vec0hnsw.cc) lazily allocates
--echo # dict_index_t::vec_open_mutex/vec_open_event for one index, through
--echo # os_once::do_or_wait_for_done() (os0once.h) - a one-way state machine
--echo # (NEVER_DONE -> IN_PROGRESS -> DONE) with no try/catch of its own
--echo # around the call. Before this fix, an allocation failure inside
--echo # vec_open_sync_alloc() (ut::new_withkey()/os_event_create() both
--echo # throw std::bad_alloc rather than returning null) would escape as an
--echo # exception, so os_once's state->compare_exchange_strong(IN_PROGRESS,
--echo # DONE) right after the call would never run. The state would be
--echo # stuck at IN_PROGRESS forever, and every OTHER thread calling
--echo # do_or_wait_for_done() for this same index - i.e. every concurrent
--echo # vec_runtime_open()/vec_runtime_wait_slow() - would then spin in its
--echo # UT_RELAX_CPU() loop for the rest of the server's life.
--echo #
--echo # This test forces that allocation failure deterministically via
--echo # vec_open_sync_alloc_oom, parks the failing thread (con1) with
--echo # os_once's state genuinely, structurally still IN_PROGRESS (not a
--echo # timing race: it cannot reach DONE until con1's call returns), and
--echo # only then starts a second thread (con2) that must wait on that same
--echo # state. Releasing con1 is what lets con2 proceed - if it did not,
--echo # con2 would hang here rather than complete this test.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
                 KEY (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'));

--source include/restart_mysqld.inc

--echo # Nothing is dict-cached after the restart, so con1 below is the
--echo # first thread anywhere to call vec_open_sync_ensure() for this
--echo # index - i.e. the one that actually runs vec_open_sync_alloc() as
--echo # os_once's do_func, with the injected fault armed.
--connect (con1, localhost, root,,)
SET SESSION debug = '+d,vec_open_sync_alloc_oom';
SET DEBUG_SYNC = 'vec_open_sync_alloc_parked SIGNAL alloc_parked WAIT_FOR resume_alloc';
--send SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 5

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR alloc_parked';

--echo # con2 now reaches vec_open_sync_ensure() for the same index while
--echo # os_once's state is genuinely IN_PROGRESS. Before this fix, con1's
--echo # exception would already have escaped vec_open_sync_alloc the
--echo # moment it was thrown - well before this connection even starts -
--echo # so the state would never reach DONE and this SELECT would never
--echo # return.
--connect (con2, localhost, root,,)
--send SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 5

--connection default
--echo # do_or_wait_for_done()'s IN_PROGRESS wait is a raw UT_RELAX_CPU()
--echo # spin loop with no DEBUG_SYNC point of its own to park at (it takes
--echo # no THD), so confirm con2 is still executing - i.e. genuinely inside
--echo # that loop, since nothing else in this query can block it - before
--echo # releasing con1. Without this, releasing con1 immediately after
--echo # con2's --send could let the test pass by lucky timing even if
--echo # con2's wait were broken.
--echo # Two connections match this text - con1 itself (still "executing",
--echo # parked mid-statement at its own DEBUG_SYNC point) and con2 (the
--echo # one actually being waited for here) - so the condition is 2, not 1.
--let $wait_condition= SELECT COUNT(*) = 2 FROM information_schema.processlist WHERE info LIKE 'SELECT id FROM t1 ORDER BY DISTANCE%'
--source include/wait_condition.inc

--echo # Let con1 finish: its injected exception is caught inside
--echo # vec_open_sync_alloc(), which then returns normally, so os_once's
--echo # own compare_exchange_strong(IN_PROGRESS, DONE) runs right
--echo # afterwards. That state transition - not this test's timing - is
--echo # what unblocks con2 below.
SET DEBUG_SYNC = 'now SIGNAL resume_alloc';

--connection con1
--echo # con1 itself gets a clean, permanent DB_OUT_OF_MEMORY for this
--echo # index - not a hang, not a crash.
--error ER_OUT_OF_RESOURCES
--reap
SET SESSION debug = '-d,vec_open_sync_alloc_oom';

--connection con2
--echo # con2 must also get DB_OUT_OF_MEMORY promptly, rather than spinning
--echo # forever - the actual bug this fix closes.
--error ER_OUT_OF_RESOURCES
--reap

--connection default
--disconnect con1
--disconnect con2
SET DEBUG_SYNC = 'RESET';

--echo # No runtime is attached to the index: the failure is permanent for
--echo # the life of this dict_index_t.
SET SESSION innodb_interpreter = 'vec_runtime_info test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # Unlike a graph-build OOM (vector_runtime_open_oom.test, where
--echo # index->vec/vec_open_err are simply re-attempted by the next fresh
--echo # vec_runtime_open() call, even on the SAME dict_index_t), this
--echo # failure lives in vec_open_sync_created - an os_once state that
--echo # never leaves DONE once reached. FLUSH TABLES alone is not enough:
--echo # confirm that here (documenting the difference), then actually
--echo # restart to get a fresh dict_index_t and confirm recovery.
FLUSH TABLES t1;
--error ER_OUT_OF_RESOURCES
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 5;

--source include/restart_mysqld.inc
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 5;

DROP TABLE t1;

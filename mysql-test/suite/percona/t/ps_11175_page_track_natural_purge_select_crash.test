# Release-build only: the truncation is the SILENT modulo-65,536 wrap
# inside mach_write_to_2. Debug builds trip the assertion at
# mach0data.ic:54 before the truncation happens.
let $have_debug = `SELECT VERSION() LIKE '%debug%'`;
if ($have_debug)
{
  --skip Test requires a non-debug build
}

# PS-11175: customer's CS0033890 sequence reproduced with NATURAL workload
# (no innodb_arch_page_initial_block_num seeding). The seeded approach
# trips a separate post-recovery file_index bug in init_file_ctx that
# muddles the picture; this test uses real archive block growth so the
# state at restart is what production code actually produces.
#
# Sequence:
#  1. Natural workload with innodb_arch_page_test_max_entries=1 -- every
#     tracked page_id flushes its own archive block, so a few minutes of
#     bulk inserts cross block_num=65,535 and create ib_page_32+ on disk.
#  2. Save reset A *after* the crossing -- on-disk block_num is silently
#     truncated by mach_write_to_2 in Arch_Block::add_reset.
#  3. mysqlbackup_page_track_purge_up_to(A_lsn) -- the customer's purge
#     step. Removes ib_page_0..N-1 from disk so the surviving group's
#     oldest file is well above 0, matching the customer's ib_page_584.
#  4. Clean restart. arch0recv.cc parses the surviving files; A's
#     truncated entry lives in a file that's full enough that
#     fetch_reset_lsn's within-file read succeeds. Recovery completes.
#  5. SELECT mysqlbackup_page_track_get_changed_pages(A_lsn, 0). stop=0
#     defaults to m_latest_stop_lsn. find_reset_point returns A's
#     truncated pos. read_from_file computes file_index =
#     truncated_block_num / 2043 (in [0, 31]); those files were purged
#     -> os_file_create() ENOENT -> srv_fatal_error. Customer's
#     MY-012646 signature.

--disable_query_log
call mtr.add_suppression(".*");
--enable_query_log

INSTALL COMPONENT "file://component_mysqlbackup";

CREATE TABLE t_1000 (a INT AUTO_INCREMENT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t_big (
  id INT AUTO_INCREMENT PRIMARY KEY,
  pad LONGBLOB
) ENGINE=InnoDB;

# Build a 1000-row driver table for bulk INSERT ... SELECT
--disable_query_log
let $i = 0;
while ($i < 1000) {
  INSERT INTO t_1000 VALUES ();
  inc $i;
}
--enable_query_log

--echo # ---- Phase 1: natural workload crosses block_num=65,535 ----
let $start_lsn = `SELECT mysqlbackup_page_track_set(1)`;

SET GLOBAL innodb_arch_page_test_max_entries = 1;

--echo # ~80 * 1000 wide-row inserts drive block_num past 65,535 and into ib_page_32+
--disable_query_log
let $i = 0;
while ($i < 80) {
  INSERT INTO t_big (pad) SELECT REPEAT('x', 14000) FROM t_1000;
  inc $i;
}
--enable_query_log

--echo # Wait for ib_page_33 to be created -- confirms we're past 65,535
--perl
use strict;
my $dir = $ENV{'MYSQLTEST_VARDIR'} . "/mysqld.1/data/#ib_archive";
my $found = 0;
for (my $i = 0; $i < 300; $i++) {
    my @files = glob("$dir/page_group_*/ib_page_33");
    if (scalar(@files) > 0) {
        $found = 1;
        last;
    }
    sleep(1);
}
if (!$found) {
    die "ib_page_33 not created within 300s";
}
EOF

--echo # ---- Phase 2: save the truncating reset A ----
--disable_query_log
let $crash_lsn_A = `SELECT mysqlbackup_page_track_set(1)`;
--enable_query_log
--echo reset A captured

--echo # Continue some activity so the file containing A is sealed and
--echo # its within-file offset is safely inside the file's phy_size.
--disable_query_log
let $i = 0;
while ($i < 5) {
  INSERT INTO t_big (pad) SELECT REPEAT('x', 14000) FROM t_1000;
  inc $i;
}
--enable_query_log

--echo # Wait for ib_page_34 to confirm A's file (33) is sealed
--perl
use strict;
my $dir = $ENV{'MYSQLTEST_VARDIR'} . "/mysqld.1/data/#ib_archive";
my $found = 0;
for (my $i = 0; $i < 300; $i++) {
    my @files = glob("$dir/page_group_*/ib_page_34");
    if (scalar(@files) > 0) {
        $found = 1;
        last;
    }
    sleep(1);
}
if (!$found) {
    die "ib_page_34 not created within 300s";
}
EOF

SET GLOBAL innodb_arch_page_test_max_entries = 0;

--echo # ---- Phase 3: customer's purge step -- delete files older than A ----
--disable_query_log
--disable_result_log
eval SELECT mysqlbackup_page_track_purge_up_to($crash_lsn_A);
--enable_result_log
--enable_query_log

SET GLOBAL mysqlbackup.backupid = '1';

--echo # ---- Phase 4: clean restart -- recovery succeeds ----
--source include/restart_mysqld.inc

SET GLOBAL mysqlbackup.backupid = '1';

--echo # ---- Phase 5: the crashing SELECT ----
--echo # find_reset_point returns A's truncated pos; read_from_file opens
--echo # ib_page_<truncated/2043> in [0, 31]; that file was purged ->
--echo # ENOENT -> srv_fatal_error. Customer's MY-012646.
--source include/expect_crash.inc
--disable_query_log
--error 2013,2006,1053,CR_SERVER_LOST,CR_SERVER_GONE_ERROR
eval SELECT mysqlbackup_page_track_get_changed_pages($crash_lsn_A, 0);
--enable_query_log

--source include/wait_until_disconnected.inc

--echo # Verify the customer's SELECT-side ENOENT signature
let SEARCH_FILE = $MYSQLTEST_VARDIR/log/mysqld.1.err;
let SEARCH_PATTERN = ib_page_[0-9]+.*'open' returned OS error 71;
--source include/search_pattern.inc

--echo # ---- Teardown ----
--exec rm -rf $MYSQLD_DATADIR/#ib_archive
--exec rm -rf $MYSQLD_DATADIR/#innodb_redo
--exec rm -f $MYSQLD_DATADIR/#ib_16384_0.dblwr
--exec rm -f $MYSQLD_DATADIR/#ib_16384_1.dblwr
--exec rm -f $MYSQLD_DATADIR/ibdata1
--exec rm -f $MYSQLD_DATADIR/undo_001
--exec rm -f $MYSQLD_DATADIR/undo_002
--exec rm -f $MYSQLD_DATADIR/mysql.ibd

--exec echo "restart" > $MYSQLTEST_VARDIR/tmp/mysqld.1.expect
--enable_reconnect
--source include/wait_until_connected_again.inc

DROP TABLE t_big;
DROP TABLE t_1000;
UNINSTALL COMPONENT "file://component_mysqlbackup";

# PS-11175 customer-shape natural repro -- DEBUG build, leaf-limit variant.
#
# Reproduces the full customer-reported chain in one MTR run. Production
# code paths only (mach_write_to_2 truncation in Arch_Block::add_reset
# fires naturally); the leaf-limit and seed knobs are *test infrastructure*
# that accelerate the workload, not bug enablers:
#
#   face A: recovery cannot start the server because a truncated reset
#           entry in a partial archive file points past EOF
#           ([MY-012642] Tried to read 32 bytes at offset N)
#   face B: mysqlbackup_page_track_get_changed_pages crashes the server
#           because a truncated reset entry implies a file index that
#           never existed
#           ([MY-012646] 'open' returned OS error 71)
#
# Two debug knobs (acceptable because they ONLY change *how fast* we get
# to the bug state; the bug pathology is identical to production):
#   innodb_arch_page_initial_block_num=67419
#     seeds the writer at the start of ib_page_33, so crossing
#     block_num 65,535 happens in milliseconds rather than hours
#   innodb_limit_leaf_optimistic_insert_debug=8
#     forces a leaf split every 2 records, so each INSERT dirties ~3
#     pages instead of ~0.03. Lets us saturate the page cleaner with
#     narrow rows (1 INT per row) instead of the bulky CHAR-soup
#     wide-row tables we needed previously
#
# Sequence:
#   1-3) seed; install component; create 12 narrow tables; SET the
#        leaf-limit knob
#   4)   set(1) #1 with writer at first slot of ib_page_33 -> truncated
#        entry persisted_bn=1883 in ib_page_33's reset block
#   5)   12 parallel workers each running an INSERT-loop procedure on
#        their own table. Fills ib_page_33 to 33,488,896 bytes (full)
#        and rolls the writer into ib_page_34. Verbose perl wait prints
#        progress every 10s with a 60s-no-growth watchdog
#   6)   sleep briefly for cleaner drain; assert ib_page_34 < 160 blocks
#        (~2 MB) so the next set(1) lands in the [1884, 2043] slot range
#        and the implied slot stays past EOF
#   7)   set(1) #2 -> truncated entry persisted_bn=3926 in ib_page_34's
#        reset block, slot 1884 (offset 30.86 MB) past ib_page_34 EOF
#   8)   restart_mysqld -- face A assertion (today: recovery crash on
#        ib_page_34's bad reset entry)
#   9)   mysqlbackup_page_track_get_changed_pages + SELECT 1 -- face B
#        assertion (today: server crashes opening ib_page_0)
#
# Regression style: every step asserts the GOOD outcome. After the
# mach_write_to_2 fix both restart and get_changed_pages return cleanly
# and the test passes. Today the bug makes the test fail at step 8
# (face A) before reaching step 9.

--source include/have_debug.inc

# Big test: filling ib_page_33 with narrow rows + leaf-limit takes a
# few minutes even at the higher dirty-page rate.
--source include/big_test.inc

--disable_query_log
call mtr.add_suppression(".*");
--enable_query_log

INSTALL COMPONENT "file://component_mysqlbackup";

# --------------------------------------------------------------------------
# 1. Create 12 NARROW tables -- one INT primary key column. With
#    innodb_limit_leaf_optimistic_insert_debug=8 every leaf is forced to
#    split at the 9th insert, dirtying ~1 page every few rows. 8 was
#    chosen over 2 because debug-build cleaner overhead made the
#    leaf-limit=2 variant produce ~100x more pages-per-row than the
#    cleaner could sustain (~4h to fill ib_page_33); leaf-limit=8
#    yields ~25% the dirty-page volume of leaf-limit=2 while still
#    forcing many more splits than the natural fill rate (~150 rows
#    per leaf at default INT PK).
# --------------------------------------------------------------------------
--let $j = 1
while ($j <= 12)
{
  eval CREATE TABLE t$j (a INT PRIMARY KEY) ENGINE=InnoDB;
  --inc $j
}

# --------------------------------------------------------------------------
# 2. Single stored procedure that does a bounded auto-increment INSERT
#    loop into the named table. Each connection passes its own table name
#    so all 12 procedures can run in parallel without contention.
# --------------------------------------------------------------------------
DELIMITER //;
CREATE PROCEDURE ins_table(IN tab VARCHAR(20), IN num_rows INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  SET @stmt_text = CONCAT('INSERT INTO ', tab, ' (a) VALUES (?)');
  PREPARE stmt FROM @stmt_text;
  START TRANSACTION;
  WHILE i < num_rows DO
    SET @v = i;
    EXECUTE stmt USING @v;
    SET i = i + 1;
    IF i % 1000 = 0 THEN
      COMMIT;
      START TRANSACTION;
    END IF;
  END WHILE;
  COMMIT;
  DEALLOCATE PREPARE stmt;
END//
DELIMITER ;//

# --------------------------------------------------------------------------
# 3. Open 12 worker connections.
# --------------------------------------------------------------------------
connect (w1,  localhost, root,,);
connect (w2,  localhost, root,,);
connect (w3,  localhost, root,,);
connect (w4,  localhost, root,,);
connect (w5,  localhost, root,,);
connect (w6,  localhost, root,,);
connect (w7,  localhost, root,,);
connect (w8,  localhost, root,,);
connect (w9,  localhost, root,,);
connect (w10, localhost, root,,);
connect (w11, localhost, root,,);
connect (w12, localhost, root,,);
connection default;

# --------------------------------------------------------------------------
# 4. Engage the leaf-limit knob and start tracking. The writer is seeded
#    at block_num = 67419 = 33*2043, i.e., the first slot of ib_page_33.
#    set(1) writes a reset entry into ib_page_33's reset block.
#    mach_write_to_2 (with our explicit 16-bit mask) persists:
#        persisted_bn = 67419 & 0xFFFF = 1883
#    1883 / 2043 = 0  ->  reset entry implies file 0, which doesn't exist.
# --------------------------------------------------------------------------
SET GLOBAL innodb_limit_leaf_optimistic_insert_debug = 8;

# Debug-build assertion bypass: ut_ad((n | 0xFFFF) <= 0xFFFF) inside
# mach_write_to_2 would fire on every reset-entry persistence under the
# seeded scenario. The escape hatch in mach_write_to_2 honours this DBUG
# flag, so the silent 2-byte truncation that fires in release builds is
# reproducible here. Production code does not check this flag.
SET GLOBAL DEBUG='+d,disable_mach_2_write_assertion';

let $start_lsn = `SELECT mysqlbackup_page_track_set(1)`;

# --------------------------------------------------------------------------
# 5. Parallel insert workload. 12 connections each running the same
#    procedure on their own table. With leaf-limit=2 each insert dirties
#    ~3 pages (current leaf + new leaf + parent), so ~100K rows per worker
#    produces ~300K dirty pages per worker = ~3.6M dirty pages total --
#    enough to fill ib_page_33 (needs ~5.5M tracked entries) within
#    ~5-15 min on most disks.
# --------------------------------------------------------------------------
--disable_query_log
let $rows_per_worker = 200000;
let $j = 0;
while ($j < 12)
{
  inc $j;
  connection w$j;
  --send_eval CALL ins_table('t$j', $rows_per_worker)
}

# --------------------------------------------------------------------------
# 6. Wait until ib_page_33 is FULL (33,488,896 bytes) and ib_page_34
#    exists. Verbose progress every 10s, with a 60s no-growth watchdog
#    so a stalled cleaner fails fast rather than waiting to the ceiling.
# --------------------------------------------------------------------------
--perl
use strict;
my $datadir = $ENV{'MYSQLD_DATADIR'};
$datadir = $ENV{'MYSQLTEST_VARDIR'} . "/mysqld.1/data" unless $datadir;
my $arch_dir;
for (my $i = 0; $i < 300; $i++) {
  my @groups = glob("$datadir/#ib_archive/page_group_*");
  if (@groups) { $arch_dir = $groups[0]; last; }
  sleep 1;
}
die "no #ib_archive/page_group_* directory found within 300s"
  unless defined $arch_dir;
print "Archive group dir: $arch_dir\n";

my $done = 0;
my $last_sz33 = -1;
my $stuck_iters = 0;
for (my $i = 0; $i < 1800; $i++) {
  my $f33 = "$arch_dir/ib_page_33";
  my $f34 = "$arch_dir/ib_page_34";
  my $sz33 = -e $f33 ? (-s $f33) : 0;
  my $sz34 = -e $f34 ? (-s $f34) : 0;

  if ($i % 10 == 0) {
    my $blocks33 = $sz33 / 16384;
    my $pct = sprintf("%.1f", 100.0 * $sz33 / 33488896);
    printf "[wait t=%4ds] ib_page_33 = %d bytes (%d blocks, %s%% full)"
          ." ib_page_34 = %d bytes\n",
          $i, $sz33, $blocks33, $pct, $sz34;
  }

  if ($sz33 == $last_sz33) {
    $stuck_iters++;
    if ($stuck_iters >= 60 && $sz33 > 0 && $sz33 < 33488896) {
      die "ib_page_33 has not grown in 60s (stuck at ${sz33} bytes / "
        . ($sz33/16384) . " blocks). Cleaner appears blocked. Killing "
        . "the wait so we can inspect the error log.";
    }
  } else {
    $stuck_iters = 0;
    $last_sz33 = $sz33;
  }

  if ($sz33 == 33488896 && $sz34 > 0) {
    print "ib_page_33 sealed at 33,488,896 bytes; ib_page_34 exists "
          . "(size=${sz34}). Workload complete after ${i}s.\n";
    $done = 1;
    last;
  }
  sleep 1;
}
die "ib_page_33 did not seal to 33,488,896 bytes within 1800s; "
  . "consider raising rows_per_worker or worker count"
  unless $done;
EOF

# Reap any workers still pending (most will be done by now since
# ib_page_33 sealed means we already moved well past the per-worker
# row budget for many of them).
let $j = 0;
while ($j < 12)
{
  inc $j;
  connection w$j;
  --error 0,1317,1213,2013
  --reap
}
connection default;
--enable_query_log

# --------------------------------------------------------------------------
# 7. Second reset point in ib_page_34 -- engineered to crash recovery.
#    Sleep briefly to let the cleaner drain remaining dirty pages, then
#    assert ib_page_34 is still smaller than 160 blocks (~2 MB) so the
#    implied slot stays in [1884, 2043] and recovery's fetch_reset_lsn
#    lands past EOF.
# --------------------------------------------------------------------------
--sleep 5

--perl
use strict;
my $datadir = $ENV{'MYSQLD_DATADIR'};
$datadir = $ENV{'MYSQLTEST_VARDIR'} . "/mysqld.1/data" unless $datadir;
my ($p34) = glob("$datadir/#ib_archive/page_group_*/ib_page_34");
die "ib_page_34 vanished" unless defined $p34 && -e $p34;
my $sz34 = -s $p34;
if ($sz34 >= 160 * 16384) {
  die "ib_page_34 grew to ${sz34} bytes (>= 160 blocks); the implied slot "
    . "of the upcoming set(1) reset entry would wrap into [1, 1883] and the "
    . "face A recovery-EOF crash would not fire. Lower rows_per_worker.";
}
print "ib_page_34 size is ${sz34} bytes -- below the 2 MB wrap threshold; "
      . "the second set(1) will write a truncated reset entry whose implied "
      . "slot lies past EOF.\n";
EOF

SET GLOBAL mysqlbackup_backup_id = '12345';
let $reset2_lsn = `SELECT mysqlbackup_page_track_set(1)`;

--sleep 3

# --------------------------------------------------------------------------
# 8. Clean restart. Face A assertion -- today recovery crashes parsing
#    ib_page_34's reset entry (32-byte read past EOF). After fix:
#    succeeds because the persisted block_num isn't truncated.
# --------------------------------------------------------------------------
--source include/restart_mysqld.inc

# Liveness check after restart. Reaching this line is itself the face A
# regression assertion (today the restart times out on the recovery crash).
SELECT 1;

# --------------------------------------------------------------------------
# 9. Face B assertion -- mysqlbackup_page_track_get_changed_pages walks
#    the recovered-from-disk m_reset entries, dereferences a truncated
#    entry's implied file index (0 or 1), tries to open ib_page_0 or
#    ib_page_1 which never existed (writer was seeded above file 32),
#    open returns ENOENT, srv_fatal_error fires with MY-012646.
# --------------------------------------------------------------------------
SET GLOBAL mysqlbackup_backup_id = '12345';

--disable_query_log
--disable_result_log
SELECT mysqlbackup_page_track_get_changed_pages($start_lsn, 0);
--enable_result_log
--enable_query_log

# Post-call liveness check -- the face B regression assertion.
SELECT 1;

# --------------------------------------------------------------------------
# 10. Cleanup. Worker connections are killed implicitly by restart_mysqld.
# --------------------------------------------------------------------------
UNINSTALL COMPONENT "file://component_mysqlbackup";
SET GLOBAL innodb_limit_leaf_optimistic_insert_debug = 0;
--disable_query_log
let $j = 1;
while ($j <= 12)
{
  eval DROP TABLE t$j;
  inc $j;
}
--enable_query_log
DROP PROCEDURE ins_table;

# Remove any archive groups the test produced so subsequent tests start
# with a clean datadir.
--let $datadir = `SELECT @@datadir`
--exec rm -rf $datadir/#ib_archive

--echo #
--echo # PS-11300: DISCARD/IMPORT TABLESPACE is refused on a vector-indexed
--echo # table. An imported tablespace carries base rows that no aux table
--echo # describes, so the only reachable outcomes are an index that
--echo # silently misses every imported row, or a rebuild the user never
--echo # asked for. The block sits at the entry of
--echo # ha_innobase::discard_or_import_tablespace, before any lock is
--echo # taken, so a refused statement leaves the table untouched.
--echo #
--echo # Lifting this needs a graph rebuildable from the clustered index
--echo # independently of the dict object — see hnsw-design.md.
--echo #

call mtr.add_suppression("FLUSH TABLES on tables that have a vector index");

--let $MYSQLD_DATADIR = `SELECT @@datadir`

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(4),
                 VECTOR KEY vk (v) TYPE hnsw WITH (M = 4));

INSERT INTO t1 VALUES (100, STRING_TO_VECTOR('[1,0,0,0]')),
                      (101, STRING_TO_VECTOR('[0,1,0,0]')),
                      (102, STRING_TO_VECTOR('[0,0,1,0]'));

--echo # Both directions are refused.
--error ER_NOT_ALLOWED_COMMAND
ALTER TABLE t1 DISCARD TABLESPACE;
--error ER_NOT_ALLOWED_COMMAND
ALTER TABLE t1 IMPORT TABLESPACE;

--echo # Nothing was disturbed: base rows, aux .ibd and kNN all intact.
SELECT id FROM t1 ORDER BY id;
--replace_regex /vec_hnsw_[0-9a-f]+_[0-9a-f]+/vec_hnsw_<TID>_<IID>/
--list_files $MYSQLD_DATADIR/test vec_*.ibd
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 2;

--echo # Writes still work after the refusal — no half-closed graph.
INSERT INTO t1 VALUES (103, STRING_TO_VECTOR('[0,0,0,1]'));
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,1]'), 'EUCLIDEAN') LIMIT 1;

--echo # FLUSH TABLES ... FOR EXPORT still works and still warns that the
--echo # aux is not quiesced — the export is only usable for a table
--echo # without a vector index.
FLUSH TABLES t1 FOR EXPORT;
UNLOCK TABLES;

DROP TABLE t1;

--echo #
--echo # The block is scoped to vector-indexed tables: a plain table in the
--echo # same server still round-trips through DISCARD/IMPORT.
--echo #

CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY, c INT);
INSERT INTO t2 VALUES (1, 10), (2, 20);

FLUSH TABLES t2 FOR EXPORT;
--copy_file $MYSQLD_DATADIR/test/t2.ibd $MYSQLTEST_VARDIR/tmp/t2.ibd
--copy_file $MYSQLD_DATADIR/test/t2.cfg $MYSQLTEST_VARDIR/tmp/t2.cfg
UNLOCK TABLES;

ALTER TABLE t2 DISCARD TABLESPACE;
--copy_file $MYSQLTEST_VARDIR/tmp/t2.ibd $MYSQLD_DATADIR/test/t2.ibd
--copy_file $MYSQLTEST_VARDIR/tmp/t2.cfg $MYSQLD_DATADIR/test/t2.cfg
ALTER TABLE t2 IMPORT TABLESPACE;
SELECT * FROM t2 ORDER BY id;

DROP TABLE t2;
--remove_file $MYSQLTEST_VARDIR/tmp/t2.ibd
--remove_file $MYSQLTEST_VARDIR/tmp/t2.cfg

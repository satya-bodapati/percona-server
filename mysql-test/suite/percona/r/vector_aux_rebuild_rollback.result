#
# PS-11299 (amended by PS-11300): this test originally verified the
# INPLACE rebuild-rollback cleanup — ADD VECTOR INDEX on an
# INSTANT-altered base forced the rebuild path, the knob failed
# prepare, and error_handling/error_handled had to drop the aux on
# the thrown-away ctx->new_table.
#
# Since PS-11300, the FIRST ever ADD VECTOR INDEX never runs INPLACE
# (the retained-column re-ADD does — see vector_aux_prepare_error /
# vector_index_rebuild; refusal below is
# check_if_supported_inplace_alter; COPY builds the graph row by
# row), so that rollback path is unreachable from SQL. The engine
# cleanup code is retained for a future INPLACE re-enablement; what
# this now guards is the refusal itself: with the failure knob
# ARMED, the ALTER on an INSTANT-altered base must succeed via
# COPY — the knob's path is never entered.
#
CREATE TABLE tvr (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(8));
# INSTANT-alter the base first — the historical rebuild-forcing
# precondition, kept to preserve the scenario shape.
ALTER TABLE tvr ADD COLUMN c1 INT, ALGORITHM=INSTANT;
# Explicit INPLACE: refused up front.
ALTER TABLE tvr ADD VECTOR KEY (v) TYPE hnsw WITH (M = 6), ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported. Reason: InnoDB does not support rebuilding a table with a vector index in-place; the vector index contents cannot be carried across a native rebuild. Try ALGORITHM=COPY.
SET @@SESSION.debug = '+d,vec_prepare_fail_after_aux_create';
ALTER TABLE tvr ADD VECTOR KEY (v) TYPE hnsw WITH (M = 6);
SET @@SESSION.debug = '-d,vec_prepare_fail_after_aux_create';
SHOW CREATE TABLE tvr;
Table	Create Table
tvr	CREATE TABLE `tvr` (
  `id` bigint unsigned NOT NULL,
  `v` vector(8) DEFAULT NULL,
  `c1` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `v` (`v`) TYPE `hnsw` WITH (`M`=6)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
vec_hnsw_<TID>_<IID>.ibd
vec_hnsw_<TID>_<IID>_dead.ibd
DROP TABLE tvr;

#
# Crash recovery of a vector table with AUTO_INCREMENT through INSTANT
# ALTERs. Each INSTANT ALTER bumps the dynamic-metadata version (the
# table has AUTO_INCREMENT) and writes both counters into the new
# definition; the records after it carry the new version. After every
# kill -9 neither counter may go back, and the rows, the graph and the
# aux must agree.
#
CREATE TABLE t1 (id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, k INT,
v VECTOR(4) NOT NULL,
VECTOR KEY vk (v) TYPE hnsw (M = 4));
INSERT INTO t1 (k, v) VALUES
(1, STRING_TO_VECTOR('[1,0,0,0]')), (2, STRING_TO_VECTOR('[0,1,0,0]')),
(3, STRING_TO_VECTOR('[0,0,1,0]')), (4, STRING_TO_VECTOR('[0,0,0,1]'));
#
# 1. INSTANT ADD COLUMN, then labels with no AUTO_INCREMENT advance,
#    and a crash with no checkpoint since the ALTER.
#
SET GLOBAL innodb_log_checkpoint_now = ON;
ALTER TABLE t1 ADD COLUMN e1 INT DEFAULT 11, ALGORITHM = INSTANT;
DELETE FROM t1 WHERE id <= 2;
INSERT INTO t1 (id, k, v, e1) VALUES
(1, 11, STRING_TO_VECTOR('[2,0,0,0]'), 1), (2, 12, STRING_TO_VECTOR('[0,2,0,0]'), 2);
# Kill and restart
# Labels 1..6 used: the next is 7. AUTO_INCREMENT is 5.
SET SESSION innodb_interpreter = 'vec_next_id test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
id=7
INSERT INTO t1 (k, v) VALUES (13, STRING_TO_VECTOR('[3,0,0,0]'));
SELECT LAST_INSERT_ID();
LAST_INSERT_ID()
5
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=7 distinct_ids=7 distinct_base_pks=5 dup_ids=0 dup_base_pks=2 labels_contiguous_from_1=0
#
# 2. AUTO_INCREMENT moves after an INSTANT DROP COLUMN and is
#    checkpointed; then label-only records, and a crash.
#
ALTER TABLE t1 DROP COLUMN e1, ALGORITHM = INSTANT;
INSERT INTO t1 (k, v) VALUES
(14, STRING_TO_VECTOR('[0,3,0,0]')), (15, STRING_TO_VECTOR('[0,0,3,0]'));
SET GLOBAL innodb_log_checkpoint_now = ON;
UPDATE t1 SET v = STRING_TO_VECTOR('[4,4,0,0]') WHERE id = 3;
UPDATE t1 SET v = STRING_TO_VECTOR('[0,4,4,0]') WHERE id = 4;
# Kill and restart
# AUTO_INCREMENT continues after 7; labels after 11.
INSERT INTO t1 (k, v) VALUES (16, STRING_TO_VECTOR('[5,0,0,0]'));
SELECT LAST_INSERT_ID();
LAST_INSERT_ID()
8
SET SESSION innodb_interpreter = 'vec_next_id test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
id=14
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=12 distinct_ids=12 distinct_base_pks=8 dup_ids=0 dup_base_pks=4 labels_contiguous_from_1=0
#
# 3. Several INSTANT ALTERs in a row, rows between them, and a crash.
#
ALTER TABLE t1 ADD COLUMN m1 INT DEFAULT 5 AFTER k, ALGORITHM = INSTANT;
INSERT INTO t1 (k, m1, v) VALUES (17, 1, STRING_TO_VECTOR('[0,5,0,0]'));
ALTER TABLE t1 RENAME COLUMN k TO k2, ALGORITHM = INSTANT;
INSERT INTO t1 (k2, m1, v) VALUES (18, 2, STRING_TO_VECTOR('[0,0,5,0]'));
ALTER TABLE t1 ALTER COLUMN m1 SET DEFAULT 9, ALGORITHM = INSTANT;
DELETE FROM t1 WHERE id = 1;
INSERT INTO t1 (id, k2, v) VALUES (1, 19, STRING_TO_VECTOR('[0,0,0,5]'));
# Kill and restart
SELECT id, k2, m1, VECTOR_TO_STRING(v) FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
id	k2	m1	VECTOR_TO_STRING(v)
1	19	9	[0.00000e+00,0.00000e+00,0.00000e+00,5.00000e+00]
2	12	5	[0.00000e+00,2.00000e+00,0.00000e+00,0.00000e+00]
3	3	5	[4.00000e+00,4.00000e+00,0.00000e+00,0.00000e+00]
4	4	5	[0.00000e+00,4.00000e+00,4.00000e+00,0.00000e+00]
5	13	5	[3.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]
6	14	5	[0.00000e+00,3.00000e+00,0.00000e+00,0.00000e+00]
7	15	5	[0.00000e+00,0.00000e+00,3.00000e+00,0.00000e+00]
8	16	5	[5.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]
9	17	1	[0.00000e+00,5.00000e+00,0.00000e+00,0.00000e+00]
10	18	2	[0.00000e+00,0.00000e+00,5.00000e+00,0.00000e+00]
INSERT INTO t1 (k2, v) VALUES (20, STRING_TO_VECTOR('[6,0,0,0]'));
SELECT LAST_INSERT_ID();
LAST_INSERT_ID()
11
SET SESSION innodb_interpreter = 'vec_next_id test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
id=19
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=16 distinct_ids=16 distinct_base_pks=11 dup_ids=0 dup_base_pks=5 labels_contiguous_from_1=0
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[6,0,0,0]'), 'euclidean') LIMIT 1;
id
11
DROP TABLE t1;

#
# PS-11300 C6: transaction rollback inverts the in-memory HNSW graph.
# The undo log restores the aux rows; the per-trx tracking list
# (trx->vec_ops) marks the rolled-back nodes deleted in the graph —
# full rollback, statement rollback, and ROLLBACK TO SAVEPOINT all
# invert exactly the mutations they undo. Committed rows referencing
# rolled-back labels (dangling edges) are dropped at reload.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(4),
VECTOR KEY (v) TYPE hnsw WITH (M = 4, ef_construction = 32));
# Full-transaction rollback: aux rows undone (ids 1,2 removed).
BEGIN;
INSERT INTO t1 VALUES (100, STRING_TO_VECTOR('[1,0,0,0]'));
INSERT INTO t1 VALUES (101, STRING_TO_VECTOR('[0,1,0,0]'));
ROLLBACK;
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=0 raw=0 max_id=0 invisible=0

SELECT id FROM t1 ORDER BY id;
id
# Inserts AFTER the rollback keep working in the same graph: the
# rolled-back nodes are marked deleted, and neighbor updates that
# target their absent aux rows are skipped, not errors.
INSERT INTO t1 VALUES (102, STRING_TO_VECTOR('[1,0.1,0,0]')),
(103, STRING_TO_VECTOR('[0,1,0.1,0]')),
(104, STRING_TO_VECTOR('[0,0,1,0]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=3 raw=9 max_id=5 invisible=0
id=3 level=0 ver=2 nb=1:4:5
id=4 level=0 ver=1 nb=1:3:5
id=5 level=0 ver=0 nb=3:1:4

# ROLLBACK TO SAVEPOINT inverts only past the savepoint: the row
# before it survives, the row after it is undone, and the insert
# after the partial rollback proceeds on the same transaction.
BEGIN;
INSERT INTO t1 VALUES (105, STRING_TO_VECTOR('[0,0,0,1]'));
SAVEPOINT s1;
INSERT INTO t1 VALUES (106, STRING_TO_VECTOR('[0.5,0.5,0,0]'));
ROLLBACK TO SAVEPOINT s1;
INSERT INTO t1 VALUES (107, STRING_TO_VECTOR('[0,0.5,0.5,0]'));
COMMIT;
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=5 raw=17 max_id=8 invisible=0
id=3 level=0 ver=4 nb=1:4:5:7:8
id=4 level=0 ver=3 nb=1:3:5:7:8
id=5 level=0 ver=3 nb=3:1:4:6:7:8
id=6 level=0 ver=2 nb=5:1:7:8
id=8 level=0 ver=0 nb=6:3:5:4

SELECT id FROM t1 ORDER BY id;
id
102
103
104
105
107
# Mid-statement failure: statement rollback undoes only that
# statement's aux rows and marks its graph nodes deleted.
INSERT INTO t1 VALUES (200, STRING_TO_VECTOR('[9,9,9,9]')), (102, STRING_TO_VECTOR('[8,8,8,8]'));
ERROR 23000: Duplicate entry '102' for key 't1.PRIMARY'
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=5 raw=17 max_id=8 invisible=0
id=3 level=0 ver=4 nb=1:4:5:7:8
id=4 level=0 ver=3 nb=1:3:5:7:8
id=5 level=0 ver=3 nb=3:1:4:6:7:8
id=6 level=0 ver=2 nb=5:1:7:8
id=8 level=0 ver=0 nb=6:3:5:4

# And inserts continue to work after it, pre-restart.
INSERT INTO t1 VALUES (108, STRING_TO_VECTOR('[0.2,0.2,0.2,0.2]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=6 raw=21 max_id=11 invisible=0
id=3 level=0 ver=5 nb=1:4:5:7:8:11
id=4 level=0 ver=3 nb=1:3:5:7:8
id=5 level=0 ver=3 nb=3:1:4:6:7:8
id=6 level=0 ver=3 nb=5:1:7:8:11
id=8 level=0 ver=1 nb=6:3:5:4:11
id=11 level=0 ver=0 nb=6:3:8

#
# Reload tolerance: committed aux rows may reference rolled-back
# labels (a neighbor list persisted before the neighbor's insert
# rolled back). The graph must load from such an aux, drop the
# dangling edges, and keep accepting inserts.
#
# restart
SET GLOBAL debug = '+d,vec_load_log';
SELECT id FROM t1 ORDER BY id;
id
102
103
104
105
107
108
include/assert_grep.inc [graph reloaded from aux containing dangling references]
SET GLOBAL debug = '-d,vec_load_log';
INSERT INTO t1 VALUES (109, STRING_TO_VECTOR('[0.9,0,0,0.9]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=7 raw=15 max_id=12 invisible=0
id=3 level=0 ver=6 nb=4:5:8:11:12
id=4 level=0 ver=3 nb=1:3:5:7:8
id=5 level=0 ver=3 nb=3:1:4:6:7:8
id=6 level=0 ver=4 nb=5:8:11:12
id=8 level=0 ver=1 nb=6:3:5:4:11
id=11 level=0 ver=0 nb=6:3:8
id=12 level=1 ver=0 nb=3:6|

SELECT id FROM t1 ORDER BY id;
id
102
103
104
105
107
108
109
DROP TABLE t1;

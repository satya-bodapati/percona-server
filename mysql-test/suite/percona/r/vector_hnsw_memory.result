#
# PS-11300 C5: innodb_hnsw_max_memory bounds the total memory of all
# in-memory HNSW graphs. A graph whose initial capacity does not fit
# is refused at load (open only warns; the INSERT retries the load
# and surfaces the failure), and raising the limit unblocks it.
#
call mtr.add_suppression("Vector index graph for .* needs .* bytes but innodb_hnsw_max_memory");
call mtr.add_suppression("Failed to load vector index graph for table");
SELECT @@global.innodb_hnsw_max_memory;
@@global.innodb_hnsw_max_memory
4294967296
# VECTOR(2048) rows are ~8.2KB per graph node; the initial capacity
# of 1024 nodes needs ~8.4MB — over a 1MB budget.
SET GLOBAL innodb_hnsw_max_memory = 1048576;
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(2048),
VECTOR KEY (v) TYPE hnsw WITH (M = 4));

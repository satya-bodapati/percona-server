#
# SPANN S5: the read path. ORDER BY DISTANCE(...) LIMIT k on a TYPE
# spann index is served by JT_VECTOR: head kNN on the RAM graph,
# posting-list scans UNDER THE CALLER'S READ VIEW, dead-label skip
# under the same view, closure dedup by label, exact-distance top-k,
# then base-row fetch through the shared vec_read path. MVCC comes
# from row versioning alone — no index-private visibility machinery.
#
CREATE TABLE ts (id BIGINT UNSIGNED PRIMARY KEY, flt INT, v VECTOR(2),
VECTOR KEY vk (v) TYPE spann);
# Genesis-routed index (never built): already servable.
EXPLAIN SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3.1,0]'), 'EUCLIDEAN') LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	ts	NULL	vector_knn	NULL	vk	2	NULL	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`ts`.`id` AS `id` from `test`.`ts` order by distance(`test`.`ts`.`v`,to_vector('[3.1,0]'),'EUCLIDEAN') limit 3
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3.1,0]'), 'EUCLIDEAN') LIMIT 3;
id
3
4
2
# Exact oracle agrees (scan + filesort path).
SELECT id FROM ts IGNORE INDEX (vk) ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3.1,0]'), 'EUCLIDEAN') LIMIT 3;
id
3
4
2
# Multi-list index: seeded rebuild, then a query at a LIST BOUNDARY —
# the probe loop must cross lists to match the exact oracle.
ALTER TABLE ts DROP KEY vk;
SET SESSION debug = '+d,spann_build_seed_42';
ALTER TABLE ts ADD VECTOR KEY vk (v) TYPE spann, ALGORITHM=INPLACE;
SET SESSION debug = '-d,spann_build_seed_42';
SET SESSION innodb_interpreter = 'spann_dump test/ts';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
heads=3 lists=3 postings=20 labels=20 label_min=1 label_max=20 dead=0
head=2 size=6
head=11 size=5
head=12 size=9
mem heads=3


# Same-session write-then-read (RYOW inside one trx): own insert is
# visible, own delete hides the row, both before commit.
BEGIN;
INSERT INTO ts VALUES (30, 0, STRING_TO_VECTOR('[3.05,0]'));
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3.1,0]'), 'EUCLIDEAN') LIMIT 3;
id
30
3
4
DELETE FROM ts WHERE id = 30;
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3.1,0]'), 'EUCLIDEAN') LIMIT 3;
id
3
4
2
ROLLBACK;
#
# The six MVCC scenarios (design doc §5), reader on the default
# connection under REPEATABLE READ, writer on con2.
#
# 1. Concurrent insert: invisible to the pinned view, visible after.
BEGIN;
SELECT COUNT(*) FROM ts;
COUNT(*)
20
INSERT INTO ts VALUES (31, 1, STRING_TO_VECTOR('[3.02,0]'));
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3.1,0]'), 'EUCLIDEAN') LIMIT 3;
id
3
4
2
COMMIT;
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3.1,0]'), 'EUCLIDEAN') LIMIT 3;
id
31
3
4
# 2. Update vs old reader: the old posting stays visible to the old
# view (its dead row is younger than the view) — the reader keeps
# seeing the OLD vector position; the new position appears only
# after the reader's trx ends.
BEGIN;
SELECT COUNT(*) FROM ts;
COUNT(*)
21
UPDATE ts SET v = STRING_TO_VECTOR('[100,0]') WHERE id = 31;
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3.1,0]'), 'EUCLIDEAN') LIMIT 3;
id
31
3
4
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[100,0]'), 'EUCLIDEAN') LIMIT 1;
id
20
COMMIT;
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[100,0]'), 'EUCLIDEAN') LIMIT 1;
id
31
# 3. Delete vs old reader: the row keeps appearing until the view ends.
BEGIN;
SELECT COUNT(*) FROM ts;
COUNT(*)
21
DELETE FROM ts WHERE id = 31;
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[100,0]'), 'EUCLIDEAN') LIMIT 1;
id
31
COMMIT;
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[100,0]'), 'EUCLIDEAN') LIMIT 1;
id
20
# 4. Uncommitted writer: invisible to other readers while open.
BEGIN;
INSERT INTO ts VALUES (32, 0, STRING_TO_VECTOR('[3.03,0]'));
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3.1,0]'), 'EUCLIDEAN') LIMIT 3;
id
3
4
2
# 5. Rollback: still invisible after the writer rolls back.
ROLLBACK;
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3.1,0]'), 'EUCLIDEAN') LIMIT 3;
id
3
4
2
# 6. Restart: committed state serves identically from a cold start.
# restart
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[11.4,0]'), 'EUCLIDEAN') LIMIT 4;
id
11
12
10
13
# WHERE + LIMIT: filters consume candidates above the iterator, the
# handler widens with the exclude set — probing more lists — until
# the LIMIT is filled. Oracle comparison on the filtered shape.
SELECT id FROM ts WHERE flt = 0 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[11.4,0]'), 'EUCLIDEAN') LIMIT 5;
id
12
10
14
8
16
SELECT id FROM ts IGNORE INDEX (vk) WHERE flt = 0 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[11.4,0]'), 'EUCLIDEAN') LIMIT 5;
id
12
10
14
8
16
# LIMIT past the matching rows: the widening loop must terminate at
# the size_hint bound (the label counter) and return every match.
SELECT COUNT(*) AS matches FROM (SELECT id FROM ts WHERE flt = 0
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[11.4,0]'), 'EUCLIDEAN') LIMIT 100) sub;
matches
10
# Deleted rows never resurface after their reader views are gone;
# a fresh query at the deleted position finds the true neighbors.
DELETE FROM ts WHERE id IN (19, 20);
SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[20,0]'), 'EUCLIDEAN') LIMIT 2;
id
18
17
# Non-servable shapes keep the exact path (same rules as hnsw).
EXPLAIN SELECT id FROM ts ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3.1,0]'), 'EUCLIDEAN') DESC LIMIT 3;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	ts	NULL	ALL	NULL	NULL	NULL	NULL	#	#	Using filesort

#
# PS-11299 (amended by PS-11300): this test originally verified the
# INPLACE prepare error path — aux created, prepare fails, cleanup
# drops the aux (knob vec_prepare_fail_after_aux_create).
#
# Since PS-11300, ADD VECTOR INDEX never runs INPLACE: it is refused
# at check_if_supported_inplace_alter because the native rebuild
# cannot build the HNSW graph, and the COPY fallback populates it
# row by row. The prepare-path aux creation (and its error cleanup)
# is retained in the engine for a future INPLACE re-enablement but
# is unreachable from SQL — which is exactly what this now guards:
# with the failure knob ARMED, ADD VECTOR INDEX must still succeed,
# proving the INPLACE prepare path was never entered.
#
CREATE TABLE tva (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(8));
# Explicit INPLACE: refused up front, before any aux work.
ALTER TABLE tva ADD VECTOR KEY (v) TYPE hnsw WITH (M = 6), ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported. Reason: InnoDB does not support rebuilding a table with a vector index in-place; the vector index contents cannot be carried across a native rebuild. Try ALGORITHM=COPY.
# Knob armed + server-picked algorithm: COPY runs, the INPLACE
# prepare path (where the knob lives) is never entered, the ALTER
# succeeds and exactly one aux .ibd exists.
SET @@SESSION.debug = '+d,vec_prepare_fail_after_aux_create';
ALTER TABLE tva ADD VECTOR KEY (v) TYPE hnsw WITH (M = 6);
SET @@SESSION.debug = '-d,vec_prepare_fail_after_aux_create';
SHOW CREATE TABLE tva;
Table	Create Table
tva	CREATE TABLE `tva` (
  `id` bigint unsigned NOT NULL,
  `v` vector(8) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `v` (`v`) TYPE `hnsw` WITH (`M`=6)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
vec_hnsw_<TID>_<IID>.ibd
DROP TABLE tva;

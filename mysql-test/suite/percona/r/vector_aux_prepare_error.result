#
# PS-11299/PS-11300: the INPLACE prepare error path — aux created at
# prepare, prepare then fails, error_handling must drop the aux
# (knob vec_prepare_fail_after_aux_create). Reachable through the
# INPLACE re-ADD (retained vec_idx_id, PS-11300 R1); the FIRST ever
# ADD still refuses INPLACE (column must materialize via COPY), so
# with the knob armed a first ADD must succeed untouched.
#
CREATE TABLE tva (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(8));
INSERT INTO tva VALUES (1, STRING_TO_VECTOR('[1,1,1,1,1,1,1,1]'));
# First-ever ADD, explicit INPLACE: refused up front, no aux work.
ALTER TABLE tva ADD VECTOR KEY (v) TYPE hnsw WITH (M = 6), ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported. Reason: InnoDB does not support rebuilding a table with a vector index in-place; the vector index contents cannot be carried across a native rebuild. Try ALGORITHM=COPY.
# First-ever ADD with the knob ARMED: server picks COPY, the INPLACE
# prepare path (where the knob lives) is never entered, the ALTER
# succeeds.
SET @@SESSION.debug = '+d,vec_prepare_fail_after_aux_create';
ALTER TABLE tva ADD VECTOR KEY (v) TYPE hnsw WITH (M = 6);
SET @@SESSION.debug = '-d,vec_prepare_fail_after_aux_create';
vec_<TID>_<IID>.ibd
# Re-ADD path (column retained after DROP): INPLACE is real now —
# the armed knob makes prepare fail AFTER the aux was created, and
# the cleanup must drop it: no vec_*.ibd leftover, and a clean
# retry succeeds with the index fully rebuilt from the base rows.
ALTER TABLE tva DROP KEY v;
SET @@SESSION.debug = '+d,vec_prepare_fail_after_aux_create';
ALTER TABLE tva ADD VECTOR KEY v (v) TYPE hnsw WITH (M = 6), ALGORITHM=INPLACE;
Got one of the listed errors
SET @@SESSION.debug = '-d,vec_prepare_fail_after_aux_create';
ALTER TABLE tva ADD VECTOR KEY v (v) TYPE hnsw WITH (M = 6), ALGORITHM=INPLACE;
SHOW CREATE TABLE tva;
Table	Create Table
tva	CREATE TABLE `tva` (
  `id` bigint unsigned NOT NULL,
  `v` vector(8) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `v` (`v`) TYPE `hnsw` WITH (`M`=6)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
vec_<TID>_<IID>.ibd
SET SESSION innodb_interpreter = 'vec_aux_dump test/tva';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=1 max_id=1 invisible=0
id=1 level=1 nb=|

DROP TABLE tva;

#
# PS-11300: DISCARD/IMPORT TABLESPACE on a vector-indexed table.
# The aux table's content belongs to the discarded rows, so DISCARD
# drops the aux (and the in-memory graph) alongside the tablespace;
# IMPORT re-mints a fresh EMPTY aux and warns that pre-import rows
# are not indexed until DROP INDEX + ADD INDEX rebuilds.
#
call mtr.add_suppression("Index vk not found or corrupt");
call mtr.add_suppression("Skip adjustment of root pages for index");
call mtr.add_suppression("FLUSH TABLES on tables that have a vector index");
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(4),
VECTOR KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (100, STRING_TO_VECTOR('[1,0,0,0]')),
(101, STRING_TO_VECTOR('[0,1,0,0]')),
(102, STRING_TO_VECTOR('[0,0,1,0]'));
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 2;
id
100
101
# Export: base .ibd/.cfg only — the aux is warned unflushed.
FLUSH TABLES t1 FOR EXPORT;
Warnings:
Warning	1235	InnoDB: This version of MySQL doesn't yet support 'FLUSH TABLES on tables that have a vector index. Vector auxiliary tables will not be flushed.'
Warning	1235	InnoDB: This version of MySQL doesn't yet support 'FLUSH TABLES on tables that have a vector index. Vector auxiliary tables will not be flushed.'
UNLOCK TABLES;
Warnings:
Warning	1235	InnoDB: This version of MySQL doesn't yet support 'FLUSH TABLES on tables that have a vector index. Vector auxiliary tables will not be flushed.'
# DISCARD removes the base tablespace AND the aux .ibd.
ALTER TABLE t1 DISCARD TABLESPACE;
# IMPORT succeeds without any vector aux files, warns, and a fresh
# empty aux .ibd exists afterwards.
ALTER TABLE t1 IMPORT TABLESPACE;
Warnings:
Warning	1817	InnoDB: Index corrupt: Index vk not found or corrupt, you should recreate this index.
Warning	1088	Vector index on table test/t1 is empty after IMPORT TABLESPACE: imported rows are not indexed. Rebuild it with ALTER TABLE ... DROP INDEX / ADD INDEX to index them.
vec_<TID>_<IID>.ibd
# Base rows are back; the vector index is EMPTY (documented): kNN
# finds nothing pre-rebuild.
SELECT id FROM t1 ORDER BY id;
id
100
101
102
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=0 max_id=0 invisible=0

# New inserts index normally, labels start fresh at 1.
INSERT INTO t1 VALUES (103, STRING_TO_VECTOR('[0,0,0,1]'));
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,1]'), 'EUCLIDEAN') LIMIT 1;
id
103
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=1 max_id=1 invisible=0
id=1 level=1 nb=|

# Full rebuild via DROP/ADD (COPY) indexes everything.
ALTER TABLE t1 DROP KEY vk;
ALTER TABLE t1 ADD VECTOR KEY vk (v) TYPE hnsw WITH (M = 4);
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 2;
id
100
101
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=4 max_id=4 invisible=0
id=1 level=1 nb=2:3:4|
id=2 level=0 nb=1:3:4
id=3 level=0 nb=1:2:4
id=4 level=0 nb=1:2:3

DROP TABLE t1;

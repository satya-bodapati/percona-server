#
# PS-11300: DISCARD/IMPORT TABLESPACE is refused on a vector-indexed
# table. An imported tablespace carries base rows that no aux table
# describes, so the only reachable outcomes are an index that
# silently misses every imported row, or a rebuild the user never
# asked for. The block sits at the entry of
# ha_innobase::discard_or_import_tablespace, before any lock is
# taken, so a refused statement leaves the table untouched.
#
# Lifting this needs a graph rebuildable from the clustered index
# independently of the dict object — see hnsw-design.md.
#
call mtr.add_suppression("FLUSH TABLES on tables that have a vector index");
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(4),
VECTOR KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (100, STRING_TO_VECTOR('[1,0,0,0]')),
(101, STRING_TO_VECTOR('[0,1,0,0]')),
(102, STRING_TO_VECTOR('[0,0,1,0]'));
# Both directions are refused.
ALTER TABLE t1 DISCARD TABLESPACE;
ERROR 42000: InnoDB: Cannot discard table `test/t1` because it has a vector index. DISCARD/IMPORT TABLESPACE is not yet supported for tables with vector indexes.
ALTER TABLE t1 IMPORT TABLESPACE;
ERROR 42000: InnoDB: Cannot import table `test/t1` because it has a vector index. DISCARD/IMPORT TABLESPACE is not yet supported for tables with vector indexes.
# Nothing was disturbed: base rows, aux .ibd and kNN all intact.
SELECT id FROM t1 ORDER BY id;
id
100
101
102
vec_hnsw_<TID>_<IID>.ibd
vec_hnsw_<TID>_<IID>_dead.ibd
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 2;
id
100
101
# Writes still work after the refusal — no half-closed graph.
INSERT INTO t1 VALUES (103, STRING_TO_VECTOR('[0,0,0,1]'));
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,1]'), 'EUCLIDEAN') LIMIT 1;
id
103
# FLUSH TABLES ... FOR EXPORT still works and still warns that the
# aux is not quiesced — the export is only usable for a table
# without a vector index.
FLUSH TABLES t1 FOR EXPORT;
Warnings:
Warning	1235	InnoDB: This version of MySQL doesn't yet support 'FLUSH TABLES on tables that have a vector index. Vector auxiliary tables will not be flushed.'
Warning	1235	InnoDB: This version of MySQL doesn't yet support 'FLUSH TABLES on tables that have a vector index. Vector auxiliary tables will not be flushed.'
UNLOCK TABLES;
Warnings:
Warning	1235	InnoDB: This version of MySQL doesn't yet support 'FLUSH TABLES on tables that have a vector index. Vector auxiliary tables will not be flushed.'
DROP TABLE t1;
#
# The block is scoped to vector-indexed tables: a plain table in the
# same server still round-trips through DISCARD/IMPORT.
#
CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY, c INT);
INSERT INTO t2 VALUES (1, 10), (2, 20);
FLUSH TABLES t2 FOR EXPORT;
UNLOCK TABLES;
ALTER TABLE t2 DISCARD TABLESPACE;
ALTER TABLE t2 IMPORT TABLESPACE;
SELECT * FROM t2 ORDER BY id;
id	c
1	10
2	20
DROP TABLE t2;

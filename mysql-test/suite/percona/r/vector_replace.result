#
# REPLACE on a vector-indexed table, on both of its paths.
#
# On a primary-key conflict the server turns REPLACE into an update of
# the row. On a conflict with another unique key it deletes the
# conflicting row and inserts the new one. The index must follow both.
#
CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL, u INT,
UNIQUE KEY ku (u), VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'), 10),
(2, STRING_TO_VECTOR('[2,0,0,0]'), 20);
# Primary-key conflict: an update of row 1.
REPLACE INTO t VALUES (1, STRING_TO_VECTOR('[5,0,0,0]'), 10);
# Unique-key conflict: row 2 is deleted, row 3 inserted.
REPLACE INTO t VALUES (3, STRING_TO_VECTOR('[7,0,0,0]'), 20);
SELECT id, u FROM t ORDER BY id;
id	u
1	10
3	20
SELECT id FROM t
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[7,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id
3
1
SELECT id FROM t IGNORE INDEX (vk)
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[7,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id
3
1
SELECT id FROM t
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
1
# A short vector is refused on the delete-and-insert path too, and the
# row it would have replaced survives.
REPLACE INTO t VALUES (4, STRING_TO_VECTOR('[9,9]'), 20);
ERROR HY000: Column 'v' of the row with primary key 4 has 2 dimensions, but its vector index needs 4.
SELECT id, u FROM t ORDER BY id;
id	u
1	10
3	20
DROP TABLE t;

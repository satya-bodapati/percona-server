#
# PS-11300 C4: INSERT populates the vector aux table through the
# in-memory HNSW graph (addPoint persistence callbacks), the graph
# loads from the aux table on FIRST ACCESS after restart, and the
# vec_idx_id counter continues past the pre-restart maximum.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(4),
VECTOR KEY (v) TYPE hnsw WITH (M = 4, ef_construction = 32));
# Single insert: exactly one aux row, id=1, level recorded, row_ref set.
INSERT INTO t1 VALUES (100, STRING_TO_VECTOR('[1,0,0,0]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=1 max_id=1 invisible=0
id=1 level=1 ver=0 nb=|

# NULL vector: base row inserted, NO graph point / aux row (same
# posture as NULL in any secondary index). It still consumes a
# vec_idx_id (the hidden column is NOT NULL and stamped per row),
# so id=2 becomes a hole in the aux.
INSERT INTO t1 VALUES (101, NULL);
SELECT id FROM t1 ORDER BY id;
id
100
101
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=1 max_id=1 invisible=0
id=1 level=1 ver=0 nb=|

# Multi-row insert: neighbor lists must interlink (the update
# callback persists existing nodes whose lists changed).
INSERT INTO t1 VALUES (102, STRING_TO_VECTOR('[0,1,0,0]')),
(103, STRING_TO_VECTOR('[0,0,1,0]')),
(104, STRING_TO_VECTOR('[0,0,0,1]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=4 max_id=5 invisible=0
id=1 level=1 ver=3 nb=3:4:5|
id=3 level=0 ver=2 nb=1:4:5
id=4 level=0 ver=1 nb=1:3:5
id=5 level=0 ver=0 nb=1:3:4

# Statement atomicity: duplicate base PK mid-statement rolls the
# whole statement back — aux rows from that statement are undone
# with it (they ride the same transaction).
INSERT INTO t1 VALUES (200, STRING_TO_VECTOR('[9,9,9,9]')), (100, STRING_TO_VECTOR('[8,8,8,8]'));
ERROR 23000: Duplicate entry '100' for key 't1.PRIMARY'
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=4 max_id=5 invisible=0
id=1 level=1 ver=3 nb=3:4:5|
id=3 level=0 ver=2 nb=1:4:5
id=4 level=0 ver=1 nb=1:3:5
id=5 level=0 ver=0 nb=1:3:4

#
# Load-on-first-access + counter persistence across restart.
#
# restart
# Not loaded yet: the vec_load log line must NOT be in the error
# log from startup alone (the graph loads on table open, not boot).
SET GLOBAL debug = '+d,vec_load_log';
include/assert_grep.inc [graph not loaded before first table access]
# First access opens the table and loads the graph from the aux.
# (PK-ordered scan; COUNT(*) is unusable here — the phase-1 open
# issue where the optimizer wrongly scans the vector index.)
SELECT id FROM t1 ORDER BY id;
id
100
101
102
103
104
include/assert_grep.inc [graph loaded from aux on first table access]
SET GLOBAL debug = '-d,vec_load_log';
# Counter proof: the counter is persisted at ASSIGNMENT (dynamic
# metadata, PS-11300), so even ids consumed only by the rolled-back
# statement above (6 and 7) are never reissued — the new point gets
# id 8 and links into the reloaded graph.
INSERT INTO t1 VALUES (105, STRING_TO_VECTOR('[1,1,0,0]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=5 max_id=8 invisible=0
id=1 level=1 ver=5 nb=3:4:5:8|8
id=3 level=0 ver=3 nb=1:4:5:8
id=4 level=0 ver=1 nb=1:3:5
id=5 level=0 ver=0 nb=1:3:4
id=8 level=1 ver=0 nb=3:1|1

DROP TABLE t1;
#
# Off-page BLOB: VECTOR(2048) = 8KB values force external storage
# on both the base row and the aux row; insert and reload must
# round-trip them whole.
#
CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(2048),
VECTOR KEY (v) TYPE hnsw WITH (M = 4));
SELECT id FROM t2 ORDER BY id;
id
1
2
3
SET SESSION innodb_interpreter = 'vec_aux_dump test/t2';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=3 max_id=3 invisible=0
id=1 level=1 ver=2 nb=2:3|
id=2 level=0 ver=1 nb=1:3
id=3 level=0 ver=0 nb=1:2

# restart
SELECT id FROM t2 ORDER BY id;
id
1
2
3
SET SESSION innodb_interpreter = 'vec_aux_dump test/t2';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=3 max_id=3 invisible=0
id=1 level=1 ver=2 nb=2:3|
id=2 level=0 ver=1 nb=1:3
id=3 level=0 ver=0 nb=1:2

DROP TABLE t2;

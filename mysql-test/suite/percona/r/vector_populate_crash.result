#
# PS-11300 C7: crash atomicity. The aux rows ride the user
# transaction, so a server crash between the row operations and
# the commit must recover to NEITHER the base row NOR its aux
# rows — and a crash after commit must recover to BOTH.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(4),
VECTOR KEY (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (100, STRING_TO_VECTOR('[1,0,0,0]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=1 raw=1 max_id=1 invisible=0
id=1 level=1 ver=0 nb=|

# Crash BEFORE the commit of an insert: recovery rolls the
# transaction back — base row and aux rows both absent.
SET SESSION debug = '+d,crash_commit_before';
INSERT INTO t1 VALUES (101, STRING_TO_VECTOR('[0,1,0,0]'));
ERROR HY000: Lost connection to MySQL server during query
SELECT id FROM t1 ORDER BY id;
id
100
# The label a crashed-before-commit INSERT consumed may or may not
# have reached the redo log, so the surviving ids legitimately vary
# between runs (both outcomes are correct). Mask the volatile parts
# and assert the shape: one live node, counter above every id ever
# consumed.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=1 raw=1 max_id=<M> invisible=0
id=<I> level=1 ver=0 nb=<NB>

# And the graph reloaded from that recovered aux keeps working:
# the counter must not reuse the committed id 1.
INSERT INTO t1 VALUES (102, STRING_TO_VECTOR('[0,0,1,0]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=2 raw=4 max_id=<M> invisible=0
id=<I> level=1 ver=2 nb=<NB>
id=<I> level=1 ver=0 nb=<NB>

# Crash AFTER commit: both sides recover to present.
SET SESSION debug = '+d,crash_commit_after';
INSERT INTO t1 VALUES (103, STRING_TO_VECTOR('[0,0,0,1]'));
ERROR HY000: Lost connection to MySQL server during query
SELECT id FROM t1 ORDER BY id;
id
100
102
103
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=3 raw=5 max_id=3 invisible=0
id=1 level=1 ver=3 nb=2:3|2
id=2 level=1 ver=1 nb=1:3|1
id=3 level=0 ver=0 nb=1:2

DROP TABLE t1;

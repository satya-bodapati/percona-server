#
# PS-11300 C7: DDL on tables whose vector aux holds real graph data.
# Every DDL must leave base rows, aux rows and the reloadable graph
# consistent: COPY rebuild compacts, TRUNCATE resets, RENAME carries,
# DROP/re-ADD INDEX re-mints, DROP TABLE removes everything.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(4),
VECTOR KEY (v) TYPE hnsw WITH (M = 4, ef_construction = 32));
INSERT INTO t1 VALUES (100, STRING_TO_VECTOR('[1,0,0,0]')),
(101, STRING_TO_VECTOR('[0,1,0,0]')),
(102, STRING_TO_VECTOR('[0,0,1,0]'));
# Punch a hole in the id sequence so compaction is observable.
INSERT INTO t1 VALUES (103, STRING_TO_VECTOR('[9,9,9,9]')), (100, STRING_TO_VECTOR('[8,8,8,8]'));
ERROR 23000: Duplicate entry '100' for key 't1.PRIMARY'
INSERT INTO t1 VALUES (104, STRING_TO_VECTOR('[0,0,0,1]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=4 max_id=6 invisible=0
id=1 level=1 ver=4 nb=2:3:4:6|
id=2 level=0 ver=3 nb=1:3:4:6
id=3 level=0 ver=2 nb=1:2:4:6
id=6 level=0 ver=0 nb=1:2:3

#
# COPY rebuild: every row re-runs write_row on the new table —
# the aux is re-minted with compact ids 1..4 and no holes.
#
ALTER TABLE t1 FORCE, ALGORITHM=COPY;
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=4 max_id=4 invisible=0
id=1 level=1 ver=3 nb=2:3:4|
id=2 level=0 ver=2 nb=1:3:4
id=3 level=0 ver=1 nb=1:2:4
id=4 level=0 ver=0 nb=1:2:3

SELECT id FROM t1 ORDER BY id;
id
100
101
102
104
# INPLACE rebuild with a surviving vector index stays refused.
ALTER TABLE t1 FORCE, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported. Reason: InnoDB does not support rebuilding a table with a vector index in-place; the vector index contents cannot be carried across a native rebuild. Try ALGORITHM=COPY.
#
# RENAME (both kinds): data and graph ride along; the aux is
# addressed by the new table name afterwards.
#
RENAME TABLE t1 TO t1r;
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1r';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=4 max_id=4 invisible=0
id=1 level=1 ver=3 nb=2:3:4|
id=2 level=0 ver=2 nb=1:3:4
id=3 level=0 ver=1 nb=1:2:4
id=4 level=0 ver=0 nb=1:2:3

ALTER TABLE t1r RENAME TO t1;
INSERT INTO t1 VALUES (105, STRING_TO_VECTOR('[1,1,0,0]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=5 max_id=5 invisible=0
id=1 level=1 ver=4 nb=2:3:4:5|
id=2 level=0 ver=3 nb=1:3:4:5
id=3 level=0 ver=1 nb=1:2:4
id=4 level=0 ver=0 nb=1:2:3
id=5 level=0 ver=0 nb=2:1

#
# TRUNCATE: aux emptied, counter reset — the first insert after
# it gets id 1 again.
#
TRUNCATE TABLE t1;
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=0 max_id=0 invisible=0

INSERT INTO t1 VALUES (200, STRING_TO_VECTOR('[0.5,0.5,0.5,0.5]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=1 max_id=1 invisible=0
id=1 level=1 ver=0 nb=|

#
# DROP VECTOR INDEX with data: aux table and graph go away, base
# rows stay. Re-ADD re-mints a fresh aux populated via COPY.
#
INSERT INTO t1 VALUES (201, STRING_TO_VECTOR('[0.1,0.2,0.3,0.4]'));
ALTER TABLE t1 DROP KEY v;
SELECT id FROM t1 ORDER BY id;
id
200
201
ALTER TABLE t1 ADD VECTOR KEY v (v) TYPE hnsw WITH (M = 4);
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=2 max_id=2 invisible=0
id=1 level=1 ver=1 nb=2|
id=2 level=0 ver=0 nb=1

#
# Everything above survives a restart via load-on-first-access.
#
# restart
INSERT INTO t1 VALUES (202, STRING_TO_VECTOR('[0.9,0.9,0,0]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=3 max_id=3 invisible=0
id=1 level=1 ver=3 nb=2:3|3
id=2 level=0 ver=1 nb=1:3
id=3 level=1 ver=0 nb=2:1|1

# DROP TABLE removes the aux .ibd with the data in it.
DROP TABLE t1;

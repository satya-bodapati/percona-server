#
# SPANN L1: incremental SPLIT on the maintenance thread. When a
# list's append counter crosses the split threshold, the insert path
# enqueues a split of that list: snapshot under the job's read view
# (dead labels pruned), deterministic k-means(2), two fresh-counter-
# id centroid heads, old head retired through the same fence/publish
# protocol as L0. The threshold is dropped to 8 by the
# spann_split_threshold_low knob.
#
SET GLOBAL innodb_monitor_enable = 'module_vec';
CREATE TABLE tp (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(2),
VECTOR KEY vk (v) TYPE spann);
# Two clusters, 8 rows: the 8th insert crosses the threshold and the
# genesis list splits into the two natural halves.
SET SESSION debug = '+d,spann_split_threshold_low';
INSERT INTO tp VALUES (1, STRING_TO_VECTOR('[1,0]'));
INSERT INTO tp VALUES (2, STRING_TO_VECTOR('[2,0]'));
INSERT INTO tp VALUES (3, STRING_TO_VECTOR('[3,0]'));
INSERT INTO tp VALUES (4, STRING_TO_VECTOR('[4,0]'));
INSERT INTO tp VALUES (5, STRING_TO_VECTOR('[101,0]'));
INSERT INTO tp VALUES (6, STRING_TO_VECTOR('[102,0]'));
INSERT INTO tp VALUES (7, STRING_TO_VECTOR('[103,0]'));
INSERT INTO tp VALUES (8, STRING_TO_VECTOR('[104,0]'));
SET SESSION debug = '-d,spann_split_threshold_low';
# Genesis (head 0) is retired and GC'd (no old readers); the two
# halves carry 4 rows each under fresh head ids 9 and 10.
SET SESSION innodb_interpreter = 'spann_dump test/tp';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
heads=2 lists=3 postings=16 labels=8 label_min=1 label_max=8 dead=0
head=0 size=8
head=9 size=4
head=10 size=4
mem heads=2

SELECT id FROM tp ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2.1,0]'), 'EUCLIDEAN') LIMIT 3;
id
2
3
1
SELECT id FROM tp ORDER BY DISTANCE(v, STRING_TO_VECTOR('[102.9,0]'), 'EUCLIDEAN') LIMIT 3;
id
7
6
8
#
# Reader pinned across a split + inserts during the split. The job
# pauses staged-but-uncommitted; a pinned view and fresh inserts run
# against the old world; after resume the catch-up carries the
# inserts and the pinned reader keeps old-world results until COMMIT.
#
BEGIN;
SELECT COUNT(*) FROM tp;
COUNT(*)
8
SET GLOBAL debug = '+d,spann_split_pause';
SET SESSION debug = '+d,spann_split_threshold_low';
# 8 appends into the right-cluster list (labels 11..18) cross the
# threshold and enqueue a split of that list.
SET SESSION debug = '-d,spann_split_threshold_low';
SET DEBUG_SYNC = 'now WAIT_FOR spann_split_paused';
# Not blocked by the paused split: completes immediately, and the
# fence catch-up will carry it into the new halves.
INSERT INTO tp VALUES (30, STRING_TO_VECTOR('[105.5,0]'));
SET DEBUG_SYNC = 'now SIGNAL spann_split_go';
SET GLOBAL debug = '-d,spann_split_pause';
# The pinned reader: none of con2's rows exist in its world.
SELECT id FROM tp ORDER BY DISTANCE(v, STRING_TO_VECTOR('[104.9,0]'), 'EUCLIDEAN') LIMIT 3;
id
8
7
6
COMMIT;
# After the view ends: the split world, catch-up row 30 included.
SELECT id FROM tp ORDER BY DISTANCE(v, STRING_TO_VECTOR('[104.9,0]'), 'EUCLIDEAN') LIMIT 3;
id
30
8
7
# The pinned view held GC back: the retired head is still probed.
SET SESSION innodb_interpreter = 'spann_stats test/tp';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
heads=3 lists=5 postings=38 labels=17 dead=0 dead_ratio_pct=0 list_min=4 list_max=13 list_avg=7 retired=1

#
# Crash mid-split (before the job trx commits): recovery has the old
# world — the half-built generation rolled back with the job trx.
#
# Deterministic choreography: the job pauses first (all trigger
# inserts commit), then the resume signal drives it into the crash
# point just before its commit.
SET GLOBAL debug = '+d,spann_split_pause,spann_split_crash_before_commit';
SET SESSION debug = '+d,spann_split_threshold_low';
SET SESSION debug = '-d,spann_split_threshold_low';
SET DEBUG_SYNC = 'now WAIT_FOR spann_split_paused';
SET DEBUG_SYNC = 'now SIGNAL spann_split_go';
# All committed rows present; the head set is the pre-crash one
# (the crashed split left no trace); queries are correct.
SELECT COUNT(*) FROM tp;
COUNT(*)
25
SET SESSION innodb_interpreter = 'spann_dump test/tp';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
heads=3 lists=5 postings=46 labels=25 label_min=1 label_max=29 dead=0
head=0 size=8
head=9 size=12
head=10 size=13
head=19 size=5
head=20 size=8
mem heads=3

SELECT id FROM tp ORDER BY DISTANCE(v, STRING_TO_VECTOR('[44.1,3]'), 'EUCLIDEAN') LIMIT 3;
id
44
45
43
# The interrupted split re-arms: the next threshold crossing on the
# same list splits it cleanly.
SET GLOBAL innodb_monitor_enable = 'module_vec';
SET SESSION debug = '+d,spann_split_threshold_low';
SET SESSION debug = '-d,spann_split_threshold_low';
SET SESSION innodb_interpreter = 'spann_stats test/tp';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
heads=4 lists=7 postings=73 labels=33 dead=0 dead_ratio_pct=0 list_min=5 list_max=18 list_avg=10 retired=0

SELECT id FROM tp ORDER BY DISTANCE(v, STRING_TO_VECTOR('[44.1,3]'), 'EUCLIDEAN') LIMIT 3;
id
44
45
43
DROP TABLE tp;
SET GLOBAL innodb_monitor_disable = 'module_vec';
SET GLOBAL innodb_monitor_reset_all = 'module_vec';
SET GLOBAL innodb_monitor_enable = default;
SET GLOBAL innodb_monitor_disable = default;
SET GLOBAL innodb_monitor_reset_all = default;

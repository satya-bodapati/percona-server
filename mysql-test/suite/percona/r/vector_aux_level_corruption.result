#
# vec_aux_read_node must report DB_CORRUPTION when an aux row's
# level field has an unexpected length, not silently treat it as
# level 0. The other fixed-width column read the same way
# (base_pk) already does this; level did not.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(2) NOT NULL,
KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[0,0]')),
(2, STRING_TO_VECTOR('[10,0]')),
(3, STRING_TO_VECTOR('[20,0]'));
# Drop the in-memory graph so the next access rebuilds it from the
# aux table, through vec_aux_read_node, rather than reusing nodes
# already resident from the inserts above.
# restart
SET SESSION debug = '+d,vec_aux_corrupt_level_len';
# The entry-point node (record 0) is read here; with the hook
# active its level field reads back as length 0 instead of 1.
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;
ERROR HY000: Incorrect key file for table 't1'; try to repair it
SET SESSION debug = '-d,vec_aux_corrupt_level_len';
# Without the injected corruption the graph loads normally.
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0]'), 'EUCLIDEAN') LIMIT 1;
id
1
DROP TABLE t1;

#
# PS-11581: an equality predicate on a vector column must find the row.
#
# A vector index is a graph for nearest-neighbour search, not a B-tree
# over the values, so it cannot answer "which row holds exactly this
# vector". The optimizer used to offer it for ref and eq_ref lookups
# anyway - it excluded FULLTEXT and SPATIAL keys from those, but not
# vector ones - and the lookup found nothing, so WHERE v = <value>
# returned no rows with no error. The range optimizer had the same gap,
# reached through FORCE INDEX. The predicate has to be answered by a
# scan instead.
#
CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t VALUES (1, STRING_TO_VECTOR('[1,0,0,0]')),
(2, STRING_TO_VECTOR('[2,0,0,0]')),
(3, STRING_TO_VECTOR('[3,0,0,0]'));
# = is not planned as a lookup on the vector index...
EXPLAIN SELECT id FROM t WHERE v = STRING_TO_VECTOR('[2,0,0,0]');
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	ALL	vk	NULL	NULL	NULL	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`t` where (`test`.`t`.`v` = <cache>(to_vector('[2,0,0,0]')))
# ...and finds the row.
SELECT id FROM t WHERE v = STRING_TO_VECTOR('[2,0,0,0]');
id
2
# The null-safe form, the same.
EXPLAIN SELECT id FROM t WHERE v <=> STRING_TO_VECTOR('[2,0,0,0]');
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	ALL	vk	NULL	NULL	NULL	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`t` where (`test`.`t`.`v` <=> <cache>(to_vector('[2,0,0,0]')))
SELECT id FROM t WHERE v <=> STRING_TO_VECTOR('[2,0,0,0]');
id
2
# A join on the vector column is the eq_ref shape of the same thing.
CREATE TABLE p (pid INT PRIMARY KEY, pv VECTOR(4) NOT NULL);
INSERT INTO p VALUES (1, STRING_TO_VECTOR('[3,0,0,0]'));
EXPLAIN SELECT t.id FROM p JOIN t ON t.v = p.pv;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	p	NULL	ALL	NULL	NULL	NULL	NULL	#	#	NULL
1	SIMPLE	t	NULL	ALL	vk	NULL	NULL	NULL	#	#	Using where; Using join buffer (hash join)
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`p` join `test`.`t` where (`test`.`t`.`v` = `test`.`p`.`pv`)
SELECT t.id FROM p JOIN t ON t.v = p.pv;
id
3
# An IN list is the range shape of the same predicate. (BETWEEN and
# < / > are refused on VECTOR operands before planning.)
EXPLAIN SELECT id FROM t WHERE v IN (STRING_TO_VECTOR('[1,0,0,0]'),
STRING_TO_VECTOR('[3,0,0,0]'));
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	ALL	vk	NULL	NULL	NULL	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`t` where (`test`.`t`.`v` in (<cache>(to_vector('[1,0,0,0]')),<cache>(to_vector('[3,0,0,0]'))))
SELECT id FROM t WHERE v IN (STRING_TO_VECTOR('[1,0,0,0]'),
STRING_TO_VECTOR('[3,0,0,0]')) ORDER BY id;
id
1
3
# FORCE INDEX used to push the same predicates onto a range scan of
# the vector index instead of a ref lookup.
EXPLAIN SELECT id FROM t FORCE INDEX (vk)
WHERE v = STRING_TO_VECTOR('[2,0,0,0]');
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	ALL	vk	NULL	NULL	NULL	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`t` FORCE INDEX (`vk`) where (`test`.`t`.`v` = <cache>(to_vector('[2,0,0,0]')))
SELECT id FROM t FORCE INDEX (vk) WHERE v = STRING_TO_VECTOR('[2,0,0,0]');
id
2
EXPLAIN SELECT id FROM t FORCE INDEX (vk)
WHERE v IN (STRING_TO_VECTOR('[1,0,0,0]'), STRING_TO_VECTOR('[3,0,0,0]'));
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	ALL	vk	NULL	NULL	NULL	#	#	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`t` FORCE INDEX (`vk`) where (`test`.`t`.`v` in (<cache>(to_vector('[1,0,0,0]')),<cache>(to_vector('[3,0,0,0]'))))
SELECT id FROM t FORCE INDEX (vk)
WHERE v IN (STRING_TO_VECTOR('[1,0,0,0]'), STRING_TO_VECTOR('[3,0,0,0]'))
ORDER BY id;
id
1
3
EXPLAIN SELECT t.id FROM p STRAIGHT_JOIN t FORCE INDEX (vk) ON t.v = p.pv;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	p	NULL	ALL	NULL	NULL	NULL	NULL	#	#	NULL
1	SIMPLE	t	NULL	ALL	vk	NULL	NULL	NULL	#	#	Using where; Using join buffer (hash join)
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`p` straight_join `test`.`t` FORCE INDEX (`vk`) where (`test`.`t`.`v` = `test`.`p`.`pv`)
SELECT t.id FROM p STRAIGHT_JOIN t FORCE INDEX (vk) ON t.v = p.pv;
id
3
# A value that is not there still finds nothing, so the fix is not
# simply matching everything.
SELECT id FROM t WHERE v = STRING_TO_VECTOR('[9,9,9,9]');
id
# And the approximate search the index exists for is untouched.
EXPLAIN SELECT id FROM t
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t	NULL	vector_ann	NULL	vk	1	NULL	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t`.`id` AS `id` from `test`.`t` order by distance(`test`.`t`.`v`,to_vector('[2,0,0,0]'),'EUCLIDEAN') limit 1
SELECT id FROM t
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
2
DROP TABLE p, t;

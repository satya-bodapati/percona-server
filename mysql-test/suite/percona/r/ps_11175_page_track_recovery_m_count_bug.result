INSTALL COMPONENT "file://component_mysqlbackup";
CREATE TABLE t_1000 (a INT AUTO_INCREMENT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t_big (
id INT AUTO_INCREMENT PRIMARY KEY,
pad LONGBLOB
) ENGINE=InnoDB;
# ---- Phase 1: seed + create files [32, 33] ----
SET GLOBAL innodb_arch_page_initial_block_num = 65376;
SET GLOBAL innodb_arch_page_test_max_entries = 1;
tracking started
# 5 * 1000 wide-row inserts -- comfortably past 2043 tracked
# blocks so file 32 is sealed and file 33 has data
# Wait for ib_page_33 to appear
# Pre-restart archive contents (file indices on disk)
pre-restart indices: 32,33,34
# Turn off the fast-flush knob before shutdown so the archiver's
# state is in a steady-ish place when init_file_ctx runs at boot.
SET GLOBAL innodb_arch_page_test_max_entries = 0;
# ---- Phase 2: clean restart ----
# restart
SET GLOBAL mysqlbackup.backupid = '1';
# ---- Phase 3: trigger one archive flush post-restart ----
# init_file_ctx has set m_count = num_files (small). The first
# write_to_file calls open_new at that low index.
SET GLOBAL innodb_arch_page_test_max_entries = 1;
# Let the page cleaner + archiver flush at least one block
# ---- Phase 4: post-restart archive contents -- bug indicator ----
post-restart indices: 2,32,33,34
BUG: stray low-index file(s) created post-recovery: 2
     init_file_ctx() set m_count to num_files instead of
     start_index + num_files; open_new opened at that low index.
# ---- Teardown ----
SET GLOBAL innodb_arch_page_initial_block_num = 0;
SET GLOBAL innodb_arch_page_test_max_entries = 0;
DROP TABLE t_big;
DROP TABLE t_1000;
UNINSTALL COMPONENT "file://component_mysqlbackup";

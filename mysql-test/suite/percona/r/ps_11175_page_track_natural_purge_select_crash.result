INSTALL COMPONENT "file://component_mysqlbackup";
CREATE TABLE t_1000 (a INT AUTO_INCREMENT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t_big (
id INT AUTO_INCREMENT PRIMARY KEY,
pad LONGBLOB
) ENGINE=InnoDB;
# ---- Phase 1: natural workload crosses block_num=65,535 ----
SET GLOBAL innodb_arch_page_test_max_entries = 1;
# ~80 * 1000 wide-row inserts drive block_num past 65,535 and into ib_page_32+
# Wait for ib_page_33 to be created -- confirms we're past 65,535
# ---- Phase 2: save the truncating reset A ----
reset A captured
# Continue some activity so the file containing A is sealed and
# its within-file offset is safely inside the file's phy_size.
# Wait for ib_page_34 to confirm A's file (33) is sealed
SET GLOBAL innodb_arch_page_test_max_entries = 0;
# ---- Phase 3: customer's purge step -- delete files older than A ----
SET GLOBAL mysqlbackup.backupid = '1';
# ---- Phase 4: clean restart -- recovery succeeds ----
# restart
SET GLOBAL mysqlbackup.backupid = '1';
# ---- Phase 5: the crashing SELECT ----
# find_reset_point returns A's truncated pos; read_from_file opens
# ib_page_<truncated/2043> in [0, 31]; that file was purged ->
# ENOENT -> srv_fatal_error. Customer's MY-012646.
Got one of the listed errors
# Verify the customer's SELECT-side ENOENT signature
Pattern "ib_page_[0-9]+.*'open' returned OS error 71" found
# ---- Teardown ----
DROP TABLE t_big;
DROP TABLE t_1000;
UNINSTALL COMPONENT "file://component_mysqlbackup";

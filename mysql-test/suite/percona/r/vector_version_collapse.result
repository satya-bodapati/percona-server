#
# PS-11300 H1-4: reload-time collapse of superseded version rows.
#
# The append-only log grows with MUTATIONS, not nodes: every insert
# appends one edge-list snapshot per rewired neighbour. Those
# snapshots are garbage as soon as a committed higher version of the
# same label exists, so the loader — which already resolves the
# winning version per label during its scan — delete-marks the losers
# on a system transaction. No background thread is involved.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4),
VECTOR KEY (v) TYPE hnsw WITH (M = 4));
# Enough inserts that early nodes are rewired several times each,
# so the log holds many superseded snapshots.
INSERT INTO t1 VALUES
(1, STRING_TO_VECTOR('[1,0,0,0]')), (2, STRING_TO_VECTOR('[0,1,0,0]')),
(3, STRING_TO_VECTOR('[0,0,1,0]')), (4, STRING_TO_VECTOR('[0,0,0,1]')),
(5, STRING_TO_VECTOR('[1,1,0,0]')), (6, STRING_TO_VECTOR('[0,1,1,0]')),
(7, STRING_TO_VECTOR('[0,0,1,1]')), (8, STRING_TO_VECTOR('[1,0,0,1]'));
# The dump reports both numbers that matter: count= is the
# resolved node count, raw= is how many rows the log actually
# holds. Before any reload raw= is much larger — births plus every
# snapshot ever appended.
# The resolved graph, as the loader reconstructs it.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=8 raw=22 max_id=8 invisible=0
id=1 level=1 ver=5 nb=2:3:4:5:8|
id=2 level=0 ver=4 nb=1:3:4:5:6
id=3 level=0 ver=3 nb=1:2:4:6:7
id=4 level=0 ver=2 nb=1:2:3:7:8
id=5 level=0 ver=0 nb=2:1
id=6 level=0 ver=0 nb=3:2
id=7 level=0 ver=0 nb=4:3
id=8 level=0 ver=0 nb=4:1

# A restart forces a reload, which resolves the log AND collapses
# what it proved superseded. The resolved graph must be identical
# afterwards — collapse removes only rows nobody can still need.
# restart
# NOTE: the collapse runs inside the graph load, so the table must
# actually be OPENED before the log is inspected — dumping the aux
# directly would report the pre-collapse log and prove nothing.
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
1
# raw= must now be smaller: births + one winning snapshot per
# rewired label, with every superseded snapshot delete-marked.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=8 raw=12 max_id=8 invisible=0
id=1 level=1 ver=5 nb=2:3:4:5:8|
id=2 level=0 ver=4 nb=1:3:4:5:6
id=3 level=0 ver=3 nb=1:2:4:6:7
id=4 level=0 ver=2 nb=1:2:3:7:8
id=5 level=0 ver=0 nb=2:1
id=6 level=0 ver=0 nb=3:2
id=7 level=0 ver=0 nb=4:3
id=8 level=0 ver=0 nb=4:1

# A second reload finds nothing left to collapse (idempotent), and
# kNN still answers from the collapsed log.
# restart
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id
1
5
8
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=8 raw=12 max_id=8 invisible=0
id=1 level=1 ver=5 nb=2:3:4:5:8|
id=2 level=0 ver=4 nb=1:3:4:5:6
id=3 level=0 ver=3 nb=1:2:4:6:7
id=4 level=0 ver=2 nb=1:2:3:7:8
id=5 level=0 ver=0 nb=2:1
id=6 level=0 ver=0 nb=3:2
id=7 level=0 ver=0 nb=4:3
id=8 level=0 ver=0 nb=4:1

# A PK-only UPDATE's override row must SURVIVE collapse: it carries
# the label's current base-row reference, and the loader takes the
# latest visible non-NULL row_ref. Collapsing it because a later
# neighbours-only version exists would revert the label to its
# pre-move reference and point the index at a vacated PK.
UPDATE t1 SET id = 100 WHERE id = 1;
# More inserts, so label 1 is rewired again AFTER the override row —
# this is exactly the case a naive purgability rule gets wrong.
INSERT INTO t1 VALUES (9, STRING_TO_VECTOR('[1,0,0,0]')),
(10, STRING_TO_VECTOR('[1,0,0,0]'));
# restart
# The moved row must still be reachable through the index at its
# NEW pk after the collapse pass (this query also triggers the
# load, hence the collapse, for the override-row case).
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 3;
id
100
9
10
DROP TABLE t1;

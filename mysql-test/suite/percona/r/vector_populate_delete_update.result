#
# PS-11300 C8: DELETE and UPDATE against the vector index.
# DELETE = tombstone the aux row (row_ref -> NULL, geometry kept)
# + markDelete in the graph. Vector-column UPDATE = delete + insert
# under a FRESH label (no in-place update, secondary-index
# discipline). PK-only UPDATE just repoints row_ref. Rollbacks
# invert both the aux (undo) and the graph (tracking).
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(4),
VECTOR KEY (v) TYPE hnsw WITH (M = 4, ef_construction = 32));
INSERT INTO t1 VALUES (100, STRING_TO_VECTOR('[1,0,0,0]')),
(101, STRING_TO_VECTOR('[0,1,0,0]')),
(102, STRING_TO_VECTOR('[0,0,1,0]')),
(103, NULL);
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=3 max_id=3 invisible=0
id=1 level=1 ver=2 nb=2:3|
id=2 level=0 ver=1 nb=1:3
id=3 level=0 ver=0 nb=1:2

# DELETE: id=2 becomes a tombstone (dead), base row gone. The
# survivors' neighbor lists still reference it — geometry is kept
# until reload drops the dangling edges.
DELETE FROM t1 WHERE id = 101;
SELECT id FROM t1 ORDER BY id;
id
100
102
103
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=2 max_id=3 invisible=0 dead=2
id=1 level=1 ver=2 nb=2:3|
id=3 level=0 ver=0 nb=1:2

# ROLLBACK of a DELETE: undo restores row_ref, tracking unmarks
# the node — the point is fully live again.
BEGIN;
DELETE FROM t1 WHERE id = 100;
ROLLBACK;
SELECT id FROM t1 ORDER BY id;
id
100
102
103
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=2 max_id=3 invisible=0 dead=2
id=1 level=1 ver=2 nb=2:3|
id=3 level=0 ver=0 nb=1:2

# UPDATE vector value -> value: old label 3 tombstones, the new
# point gets a FRESH label (5).
UPDATE t1 SET v = STRING_TO_VECTOR('[0,0,0.9,0.1]') WHERE id = 102;
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=2 max_id=5 invisible=0 dead=2:3
id=1 level=1 ver=3 nb=2:3:5|
id=5 level=0 ver=0 nb=1

# UPDATE NULL -> value: a FRESH label (6), never the row's
# INSERT-time id — that id never reached the aux, so the restart
# counter cannot reserve it and a post-restart insert may own it.
UPDATE t1 SET v = STRING_TO_VECTOR('[0.7,0.7,0,0]') WHERE id = 103;
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=3 max_id=6 invisible=0 dead=2:3
id=1 level=1 ver=4 nb=2:3:5:6|
id=5 level=0 ver=1 nb=1:6
id=6 level=0 ver=0 nb=5:1

# UPDATE value -> NULL: tombstone only.
UPDATE t1 SET v = NULL WHERE id = 103;
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=2 max_id=6 invisible=0 dead=2:3:6
id=1 level=1 ver=4 nb=2:3:5:6|
id=5 level=0 ver=1 nb=1:6

# Non-vector, non-PK UPDATE: the index is untouched.
ALTER TABLE t1 ADD COLUMN k INT DEFAULT 0, ALGORITHM=COPY;
UPDATE t1 SET k = 7 WHERE id = 100;
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=2 max_id=2 invisible=0
id=1 level=1 ver=1 nb=2|
id=2 level=0 ver=0 nb=1

# PK-only UPDATE: same label, row_ref repointed (not visible in
# the dump, but the statement must succeed and the graph must not
# churn — same ids before and after).
UPDATE t1 SET id = 90 WHERE id = 100;
SELECT id FROM t1 ORDER BY id;
id
90
102
103
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=2 max_id=2 invisible=0
id=1 level=1 ver=1 nb=2|
id=2 level=0 ver=0 nb=1

# ROLLBACK of a vector UPDATE: both halves invert — the fresh
# label vanishes, the old label comes back to life.
BEGIN;
UPDATE t1 SET v = STRING_TO_VECTOR('[0.2,0.8,0,0]') WHERE id = 90;
ROLLBACK;
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=2 max_id=2 invisible=0
id=1 level=1 ver=1 nb=2|
id=2 level=0 ver=0 nb=1

#
# Restart: tombstones stay out of the graph, live rows load, the
# counter continues past everything ever CONSUMED (persisted at
# assignment — rolled-back labels are never reissued).
#
# restart
SELECT id FROM t1 ORDER BY id;
id
90
102
103
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=2 max_id=2 invisible=0
id=1 level=1 ver=1 nb=2|
id=2 level=0 ver=0 nb=1

INSERT INTO t1 VALUES (104, STRING_TO_VECTOR('[0.3,0.3,0.3,0.3]'), 0);
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=3 max_id=5 invisible=0
id=1 level=1 ver=3 nb=2:5|5
id=2 level=0 ver=1 nb=1:5
id=5 level=1 ver=0 nb=1:2|1

#
# NULL-vector row before a restart, insert after it, then
# NULL -> value on the old row. Counter persistence keeps the
# NULL row's id reserved across the restart (base-row ids stay
# unique), and the fresh-label rule gives the NULL -> value
# update its own new label on top.
#
INSERT INTO t1 VALUES (105, NULL, 0);
# restart
INSERT INTO t1 VALUES (106, STRING_TO_VECTOR('[0.6,0,0.6,0]'), 0);
UPDATE t1 SET v = STRING_TO_VECTOR('[0,0.6,0,0.6]') WHERE id = 105;
SELECT id FROM t1 ORDER BY id;
id
90
102
103
104
105
106
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=5 max_id=8 invisible=0
id=1 level=1 ver=5 nb=2:5:7|5:7
id=2 level=0 ver=2 nb=1:5:7
id=5 level=1 ver=3 nb=1:2:7:8|1:7
id=7 level=1 ver=0 nb=1:2:5|1:5
id=8 level=0 ver=0 nb=5

DROP TABLE t1;

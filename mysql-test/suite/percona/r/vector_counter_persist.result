#
# PS-11300: the hidden vec_idx_id counter is persisted autoinc-style
# (PM_TABLE_VEC_IDX_ID dynamic metadata, redo-logged at assignment).
# Labels are NEVER reissued — not across restart, not across crash —
# even for ids the aux table never saw (NULL-vector rows, rolled-back
# inserts). Base-row vec_idx_id values are therefore unique for the
# lifetime of a table_id.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(2),
VECTOR KEY (v) TYPE hnsw WITH (M = 4));
# id 1 -> aux; id 2 consumed by the NULL row, invisible to the aux.
INSERT INTO t1 VALUES (100, STRING_TO_VECTOR('[1,0]'));
INSERT INTO t1 VALUES (101, NULL);
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=1 max_id=1 invisible=0
id=1 level=1 ver=0 nb=|

# Restart: the counter must remember id 2 although max(aux) is 1 —
# the next insert gets id 3, closing the NULL-row hole.
# restart
INSERT INTO t1 VALUES (102, STRING_TO_VECTOR('[0,1]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=2 max_id=3 invisible=0
id=1 level=1 ver=2 nb=3|3
id=3 level=1 ver=0 nb=1|1

# Rolled-back inserts consume ids 4 and 5; rollback removes their aux
# rows, but the ids stay consumed even across a restart.
INSERT INTO t1 VALUES (103, STRING_TO_VECTOR('[1,1]')), (100, STRING_TO_VECTOR('[2,2]'));
ERROR 23000: Duplicate entry '100' for key 't1.PRIMARY'
# restart
INSERT INTO t1 VALUES (104, STRING_TO_VECTOR('[2,0]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=3 max_id=6 invisible=0
id=1 level=1 ver=4 nb=3:6|3:6
id=3 level=1 ver=2 nb=1:6|1:6
id=6 level=1 ver=0 nb=3:1|3:1

# Crash durability: ids 7 and 8 go to NULL rows (nothing in the aux,
# nothing flushed), then the server is killed. The redo record
# written at assignment must carry the counter through recovery.
INSERT INTO t1 VALUES (105, NULL);
INSERT INTO t1 VALUES (106, NULL);
# Kill and restart
INSERT INTO t1 VALUES (107, STRING_TO_VECTOR('[0,2]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=4 max_id=9 invisible=0
id=1 level=1 ver=6 nb=3:6:9|3:6:9
id=3 level=1 ver=4 nb=1:6:9|1:6:9
id=6 level=1 ver=2 nb=3:1:9|3:1:9
id=9 level=1 ver=0 nb=6:1:3|6:1:3

# TRUNCATE reassigns the table_id: metadata is orphaned with it and
# the counter legitimately restarts at 1.
TRUNCATE TABLE t1;
INSERT INTO t1 VALUES (200, STRING_TO_VECTOR('[3,3]'));
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=1 max_id=1 invisible=0
id=1 level=1 ver=0 nb=|

DROP TABLE t1;

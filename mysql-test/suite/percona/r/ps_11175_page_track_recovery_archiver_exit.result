INSTALL COMPONENT "file://component_mysqlbackup";
CREATE TABLE t_1000 (a INT AUTO_INCREMENT PRIMARY KEY) ENGINE=InnoDB;
CREATE TABLE t_big (
id INT AUTO_INCREMENT PRIMARY KEY,
pad LONGBLOB
) ENGINE=InnoDB;
# ---- Phase 1: seed + workload -> files at indices [32, 33, ...] ----
SET GLOBAL innodb_arch_page_initial_block_num = 65376;
SET GLOBAL innodb_arch_page_test_max_entries = 1;
tracking started
# Wait for ib_page_33 (i.e., at least two files exist at indices >= 32)
SET GLOBAL innodb_arch_page_test_max_entries = 0;
# ---- Phase 2: Restart #1 -- recovery succeeds, m_count is primed ----
# restart
SET GLOBAL mysqlbackup.backupid = '1';
# ---- Phase 3: post-restart flush -> stray ib_page_<small> appears ----
SET GLOBAL innodb_arch_page_test_max_entries = 1;
# Let the page cleaner + archiver flush at least one block
# Confirm the stray low-index file exists before Restart #2
stray index(es) below 32 present before Restart #2
SET GLOBAL innodb_arch_page_test_max_entries = 0;
# ---- Phase 4: Restart #2 -- scan_for_groups sees the stray file ----
# restart
# ---- Phase 5: verify the graceful-exit signature in the log ----
# The page-archiver recovery returns non-success; Arch_Page_Sys::recover()
# logs MY-013581 and disables page archiving for this boot. The
# server itself comes up.
Pattern "\[MY-013581\].*Page archiver system" found
# ---- Teardown ----
SET GLOBAL innodb_arch_page_initial_block_num = 0;
SET GLOBAL innodb_arch_page_test_max_entries = 0;
DROP TABLE t_big;
DROP TABLE t_1000;
UNINSTALL COMPONENT "file://component_mysqlbackup";

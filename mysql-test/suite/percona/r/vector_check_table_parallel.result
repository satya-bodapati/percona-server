#
# PARALLEL_CHECK_TABLE (innodb_parallel_read_threads > 1) on a table
# that has a vector (HNSW) index.
#
# row_scan_index_for_mysql() (row0mysql.cc) skips vector indexes
# before the parallel-eligible branch is even reached:
#   index->is_vector() -> return DB_SUCCESS immediately.
# So parallel_check_table() must never be invoked for the vector
# index, only for the clustered/secondary B-tree indexes. This test
# proves CHECK TABLE with parallel threads enabled still succeeds
# on such a table and reports every index as OK.
#
CREATE TABLE t1 (
id BIGINT UNSIGNED PRIMARY KEY,
k INT,
v VECTOR(8) NOT NULL,
KEY k_idx (k),
KEY (v) TYPE hnsw WITH (M = 6)
) ENGINE=InnoDB;
# Force the parallel-read-eligible branch in row_scan_index_for_mysql.
SET SESSION innodb_parallel_read_threads = 8;
# CHECK TABLE must report every index OK; the vector index is
# skipped by is_vector() and never handed to parallel_check_table().
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# Same check, single-threaded (parallel path not taken at all), for
# comparison -- result must be identical.
SET SESSION innodb_parallel_read_threads = 1;
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
SET SESSION innodb_parallel_read_threads = DEFAULT;
DROP TABLE t1;

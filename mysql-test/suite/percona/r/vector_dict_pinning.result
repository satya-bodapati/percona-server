#
# PS-11300: a vector-indexed table is pinned in the dict cache.
#
# The HNSW graph hangs off dict_table_t::vec, so LRU eviction would
# silently discard it, and rebuilding it from the eviction path is
# not possible (it needs a transaction and a read view, under the
# dict_sys mutex, while writers mutate the graph). Phase 1 keeps the
# dict object alive instead. This is a restriction, not the design —
# see hnsw-design.md for what lifting it needs.
#
CREATE TABLE plain (id BIGINT UNSIGNED PRIMARY KEY, c INT);
INSERT INTO plain VALUES (1, 1);
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(4),
VECTOR KEY vk (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]')),
(2, STRING_TO_VECTOR('[0,1,0,0]'));
# The vector table is non-evictable and explicitly so; a plain table
# in the same server stays evictable. The pin is what the vector
# table has and the plain table does not.
SET SESSION innodb_interpreter = 'vec_table_state test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
evictable=0 explicitly_non_lru=1 graph=1

SET SESSION innodb_interpreter = 'vec_table_state test/plain';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
evictable=1 explicitly_non_lru=0 graph=0

#
# The pin is re-applied on every dict-cache entry, not just at
# CREATE: after a restart the table is loaded through the DD open
# path and must come back pinned.
#
# restart
# Nothing has touched t1 yet — no graph is attached, and the table is
# not even in the cache. Query it first so it is opened.
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
1
SET SESSION innodb_interpreter = 'vec_table_state test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
evictable=0 explicitly_non_lru=1 graph=1

#
# A table that loses its vector index is no longer pinned when it
# next enters the cache: the pin follows the index, not the retained
# vec_idx_id column (which survives the DROP).
#
ALTER TABLE t1 DROP KEY vk;
# restart
SELECT id FROM t1 ORDER BY id;
id
1
2
SET SESSION innodb_interpreter = 'vec_table_state test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
evictable=1 explicitly_non_lru=0 graph=0

# And re-adding the index pins it again.
ALTER TABLE t1 ADD VECTOR KEY vk (v) TYPE hnsw WITH (M = 4);
# restart
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
id
1
SET SESSION innodb_interpreter = 'vec_table_state test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
evictable=0 explicitly_non_lru=1 graph=1

DROP TABLE t1;
DROP TABLE plain;

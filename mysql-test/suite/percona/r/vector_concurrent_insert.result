#
# PS-11300: concurrent INSERTs into one vector index.
#
# Today these serialise on vec_t::graph_latch, because the HNSW
# class is not thread-safe and Vec_arena is unsynchronised. That
# latch is temporary — marked TODO REMOVE — and the intended end
# state is that concurrent INSERTs mutate the graph concurrently.
#
# This test is written to stay meaningful either way: it asserts
# the RESULT, not the serialisation. Every committed row must have
# exactly one node, every node must name a real row, and the label
# counter must have issued each label once.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
v VECTOR(4) NOT NULL,
KEY (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (1,STRING_TO_VECTOR('[1,0,0,0]')),(5,STRING_TO_VECTOR('[0.9,0.1,0,0]')),(9,STRING_TO_VECTOR('[0.8,0,0.2,0]'));
INSERT INTO t1 VALUES (2,STRING_TO_VECTOR('[0,1,0,0]')),(6,STRING_TO_VECTOR('[0.1,0.9,0,0]')),(10,STRING_TO_VECTOR('[0,0.8,0.2,0]'));
INSERT INTO t1 VALUES (3,STRING_TO_VECTOR('[0,0,1,0]')),(7,STRING_TO_VECTOR('[0,0.1,0.9,0]')),(11,STRING_TO_VECTOR('[0.2,0,0.8,0]'));
INSERT INTO t1 VALUES (4,STRING_TO_VECTOR('[0,0,0,1]')),(8,STRING_TO_VECTOR('[0,0,0.1,0.9]')),(12,STRING_TO_VECTOR('[0,0.2,0,0.8]'));
# 12 rows committed.
SELECT COUNT(*) AS rows_committed FROM t1 FORCE INDEX (PRIMARY);
rows_committed
12
# Invariants that must hold whatever order the four INSERTs
# interleaved in: one node per row, every label issued exactly
# once, and no two nodes naming the same row.
#
# This deliberately does NOT dump per-node detail — the id to
# base_pk mapping depends on the interleaving, so recording it
# would make the test flake.
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=12 distinct_ids=12 distinct_base_pks=12 dup_ids=0 dup_base_pks=0 labels_contiguous_from_1=1
DROP TABLE t1;

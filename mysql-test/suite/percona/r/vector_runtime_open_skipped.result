#
# ha_innobase::vec_read_first() (ha_innodb.cc) reads
# vec_runtime_get_or_wait() (vec0hnsw.h). That call resolves to one of
# three outcomes: a published runtime, a recorded failure cause, or -
# when nobody anywhere has ever opened this index, and nobody is
# opening it right now - the ambiguous "never attempted" terminal
# state (vec == nullptr, vec_opening == false,
# vec_open_err == DB_ERROR_UNSET).
#
# Before this fix, that terminal state was always reported as
# HA_ERR_END_OF_FILE - a silent, wrong "the index is empty" answer
# whenever THIS handler's own open() had taken the defensive
# "key == nullptr" branch (ha_innobase::open) and so never actually
# attempted vec_runtime_open() itself. The base table can still have
# real rows the search simply could not reach.
#
# vec_open_skip_key forces exactly that branch, with no concurrent
# opener anywhere (a restart guarantees the dict cache, and therefore
# every vec_open_* state, starts fresh) - so the SELECT below hits the
# genuinely ambiguous terminal state, not a race with some other
# session's real open (vector_runtime_open_wait.test already covers
# that different, already-correctly-handled case).
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
KEY (v) TYPE hnsw WITH (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'));
# restart
# Nothing is dict-cached after the restart, so this connection's own
# open of t1 below is the first and only touch of the index's runtime
# state anywhere - and vec_open_skip_key forces it to skip
# vec_runtime_open() entirely, the same way a genuinely non-vector KEY
# lookup would.
SET SESSION debug = '+d,vec_open_skip_key';
# Confirm the query really takes the vector-index access path
# (type=vector_knn) rather than falling back to a table scan that
# would pass by coincidence.
EXPLAIN SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 5;
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	t1	NULL	vector_knn	NULL	v	1	NULL	#	#	NULL
Warnings:
Note	1003	/* select#1 */ select `test`.`t1`.`id` AS `id` from `test`.`t1` order by distance(`test`.`t1`.`v`,to_vector('[1,0,0,0]'),'EUCLIDEAN') limit 5
# Before this fix: an ordinary, successful, empty result (0 rows) -
# silently wrong, since t1 has a matching row. After this fix: a
# clear, distinct error instead.
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 5;
ERROR 42000: Table 't1' uses an extension that doesn't exist in this MySQL version
SHOW WARNINGS;
Level	Code	Message
Warning	138	InnoDB: this handler never attached to the vector runtime for index v on table test/t1; reopen the table (e.g. start a new session) and retry the query.
Error	1112	Table 't1' uses an extension that doesn't exist in this MySQL version
SET SESSION debug = '-d,vec_open_skip_key';
# Ordinary behaviour is unaffected: without the debug knob, a fresh
# session's open legitimately calls vec_runtime_open(), and the same
# query returns the real result.
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 5;
id
1
DROP TABLE t1;

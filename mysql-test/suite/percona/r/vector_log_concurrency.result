#
# PS-11300: the append-only log makes P1 inexpressible.
#
# Under the old aux layout an INSERT took an X record lock on every
# neighbour whose edge list it rewired, held to COMMIT. Two sessions
# inserting similar vectors land in the same neighbourhood, so they
# contend on the same rows — and if they acquire them in opposite
# order, they deadlock (design doc P1). The log replaces those UPDATEs
# with appends of DISTINCT keys (label, ver), which take page latches
# for microseconds and compatible insert-intention locks, so no
# waits-for cycle can be constructed.
#
# Two multi-statement transactions are held open, each inserting into
# the SAME neighbourhood, interleaved. Neither may block or deadlock,
# and both must commit.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4),
VECTOR KEY (v) TYPE hnsw WITH (M = 4));
# Seed a neighbourhood every later insert will rewire.
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]')),
(2, STRING_TO_VECTOR('[0.9,0.1,0,0]')),
(3, STRING_TO_VECTOR('[0.8,0.2,0,0]'));
BEGIN;
INSERT INTO t1 VALUES (10, STRING_TO_VECTOR('[0.95,0.05,0,0]'));
# c2 inserts into the same neighbourhood while c1 still holds its
# transaction open. With in-place neighbour UPDATEs this is where c2
# would queue behind c1's uncommitted X locks, or deadlock.
BEGIN;
INSERT INTO t1 VALUES (11, STRING_TO_VECTOR('[0.85,0.15,0,0]'));
# Interleave again in the opposite order — the AB-BA shape. Distinct
# append keys mean there is nothing to wait on.
INSERT INTO t1 VALUES (12, STRING_TO_VECTOR('[0.92,0.08,0,0]'));
INSERT INTO t1 VALUES (13, STRING_TO_VECTOR('[0.88,0.12,0,0]'));
# Both commit; neither was rolled back as a deadlock victim.
COMMIT;
COMMIT;
SELECT id FROM t1 ORDER BY id;
id
1
2
3
10
11
12
13
# Every append landed and the log resolves cleanly — one birth row per
# label plus the snapshots, no lost edges.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=7 raw=19 max_id=7 invisible=0
id=1 level=1 ver=3 nb=2:3:4|
id=2 level=0 ver=5 nb=1:3:4:5:6:7
id=3 level=0 ver=2 nb=1:2:4:5
id=4 level=0 ver=1 nb=3:2:1:6
id=5 level=0 ver=1 nb=3:2:7
id=6 level=0 ver=0 nb=4:2
id=7 level=0 ver=0 nb=5:2

# The graph rebuilt from that log answers kNN across the whole
# contended neighbourhood: the edges BOTH sessions wrote are present,
# which is what P2 used to break.
# restart
SELECT id FROM t1
ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0.9,0.1,0,0]'), 'EUCLIDEAN')
LIMIT 7;
id
2
13
12
11
10
3
1
#
# Rollback of a multi-append statement: one INSERT appends the birth
# row plus a snapshot per rewired neighbour, all on the user
# transaction, so undo must remove every one of them. Asserted on raw=
# (the log's live row count) rather than the resolved node count,
# because the resolved count would look correct even if orphan version
# rows survived.
#
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=7 raw=12 max_id=7 invisible=0
id=1 level=1 ver=3 nb=2:3:4|
id=2 level=0 ver=5 nb=1:3:4:5:6:7
id=3 level=0 ver=2 nb=1:2:4:5
id=4 level=0 ver=1 nb=3:2:1:6
id=5 level=0 ver=1 nb=3:2:7
id=6 level=0 ver=0 nb=4:2
id=7 level=0 ver=0 nb=5:2

BEGIN;
INSERT INTO t1 VALUES (20, STRING_TO_VECTOR('[0.91,0.09,0,0]')),
(21, STRING_TO_VECTOR('[0.93,0.07,0,0]'));
ROLLBACK;
# raw= must be back to its pre-statement value: no orphan version
# rows, no half-applied snapshot.
SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=7 raw=12 max_id=7 invisible=0
id=1 level=1 ver=3 nb=2:3:4|
id=2 level=0 ver=5 nb=1:3:4:5:6:7
id=3 level=0 ver=2 nb=1:2:4:5
id=4 level=0 ver=1 nb=3:2:1:6
id=5 level=0 ver=1 nb=3:2:7
id=6 level=0 ver=0 nb=4:2
id=7 level=0 ver=0 nb=5:2

# A crash before commit is the same property enforced by recovery
# rather than by undo.
BEGIN;
INSERT INTO t1 VALUES (30, STRING_TO_VECTOR('[0.94,0.06,0,0]'));
SET SESSION debug = '+d,crash_commit_before';
COMMIT;
ERROR HY000: Lost connection to MySQL server during query
SELECT id FROM t1 ORDER BY id;
id
1
2

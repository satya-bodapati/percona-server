SET SESSION innodb_interpreter = 'vec_aux_dump test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
count=7 raw=12 max_id=7 invisible=0
id=1 level=1 ver=3 nb=2:3:4|
id=2 level=0 ver=5 nb=1:3:4:5:6:7
id=3 level=0 ver=2 nb=1:2:4:5
id=4 level=0 ver=1 nb=3:2:1:6
id=5 level=0 ver=1 nb=3:2:7
id=6 level=0 ver=0 nb=4:2
id=7 level=0 ver=0 nb=5:2

DROP TABLE t1;

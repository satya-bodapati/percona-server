#
# PS-11299: Vector index persistence — phase 1.
# CREATE TABLE creates one aux .ibd per vector index and auto-adds the
# hidden vec_idx_id column. SHOW CREATE must not expose vec_idx_id.
#
CREATE TABLE t1 (
id BIGINT UNSIGNED PRIMARY KEY,
v1 VECTOR(8),
VECTOR KEY (v1) SECONDARY_ENGINE_ATTRIBUTE '{ "type" : "hnsw" }'
);
# SHOW CREATE TABLE must NOT mention vec_idx_id (HT_HIDDEN_SE).
SHOW CREATE TABLE t1;
Table	Create Table
t1	CREATE TABLE `t1` (
  `id` bigint unsigned NOT NULL,
  `v1` vector(8) DEFAULT NULL,
  PRIMARY KEY (`id`),
  VECTOR KEY `v1` (`v1`) /*!80021 SECONDARY_ENGINE_ATTRIBUTE '{"type": "hnsw"}' */
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
# Exactly one aux .ibd per vector index must exist on disk.
# Names are vec_<hex_table_id>_<hex_index_id>.ibd — mask the ids so the
# result file is stable across runs.
vec_<TID>_<IID>.ibd
# User cannot declare a column named vec_idx_id when the table has a
# vector index — the name is reserved.
CREATE TABLE t2 (
id BIGINT UNSIGNED PRIMARY KEY,
vec_idx_id BIGINT UNSIGNED,
v1 VECTOR(8),
VECTOR KEY (v1) SECONDARY_ENGINE_ATTRIBUTE '{ "type" : "hnsw" }'
);
ERROR 42000: Incorrect column name 'vec_idx_id'
# ... but it is fine to declare vec_idx_id on a table that has no
# vector index — the name is only reserved when InnoDB needs it.
CREATE TABLE t3 (
id BIGINT UNSIGNED PRIMARY KEY,
vec_idx_id BIGINT UNSIGNED
);
DROP TABLE t3;
#
# RENAME TABLE — aux name is "<db>/vec_<table_id>_<index_id>" so a
# same-schema rename is a no-op on disk (aux name unchanged).
# Cross-schema rename is currently rejected — phase 2 will lift
# this once the aux DD plumbing exists.
#
# Same-schema rename: aux file unchanged.
RENAME TABLE t1 TO t1_renamed;
vec_<TID>_<IID>.ibd
# Cross-schema rename: blocked.
CREATE DATABASE vec_other;
RENAME TABLE t1_renamed TO vec_other.t1;
ERROR HY000: Error on rename of './test/t1_renamed' to './vec_other/t1' (errno: NN - Unsupported extension used for table)
DROP DATABASE vec_other;
# Aux file still in test/ after the failed cross-db rename.
vec_<TID>_<IID>.ibd
DROP TABLE t1_renamed;
# After DROP TABLE the aux .ibd files must be gone too — no orphans.

--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/count_sessions.inc

CALL mtr.add_suppression("A vector index's auxiliary table does not agree with its graph");

--echo #
--echo # A search that is already past the corruption check keeps walking the
--echo # graph after another statement has found a node missing.
--echo #
--echo # When a node the graph names is not in the aux, HNSW marks it
--echo # NODE_LOST and never retries it. The statement that found it fails
--echo # with ER_INNODB_INDEX_CORRUPT and sets corrupted_hnsw, and every
--echo # statement that STARTS later is refused with ER_INDEX_CORRUPT.
--echo #
--echo # corrupted_hnsw is read only once per statement, in
--echo # vec_runtime_load_once, though. A search that passed that check
--echo # before the flag was set walks on: it skips the NODE_LOST node as if
--echo # it had never existed and answers without it, with no error.
--echo #
--echo # The graph here has two nodes: the entry point and one neighbour. The
--echo # statement that loads the graph sees the neighbour as missing, so once
--echo # it has run only the entry point is left to answer. A search parked
--echo # before the walk asks for both rows (LIMIT 2), gets one, and no error.
--echo # Which node is the entry point depends on the unseeded layer draw, so
--echo # the test counts the rows rather than printing them.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(4) NOT NULL,
                 VECTOR KEY vk (v) TYPE hnsw (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]')),
                      (2, STRING_TO_VECTOR('[0,1,0,0]'));
ANALYZE TABLE t1;

--echo # Drop the in-memory graph so the next search has to read the aux.
--source include/restart_mysqld.inc

--echo # con_a loads the entry point, then finds its neighbour missing. It is
--echo # parked after the corruption check, with only the entry point read.
--connect (con_a, localhost, root,,)
SET DEBUG = '+d,vec_aux_node_missing_after_entry';
SET DEBUG_SYNC = 'vec_ann_open_after_load SIGNAL a_ready WAIT_FOR a_go';
--send SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'euclidean') LIMIT 1

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR a_ready';

--echo # A search gets past the corruption check while the index still looks
--echo # healthy, and parks before walking the graph.
--connect (con_b, localhost, root,,)
SET DEBUG_SYNC = 'vec_ann_open_after_load SIGNAL b_ready WAIT_FOR b_go';
--send SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'euclidean') LIMIT 2

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR b_ready';

--echo # con_a walks on, faults the neighbour in, and finds it missing: the
--echo # node is marked NODE_LOST and the index is marked as corrupted.
SET DEBUG_SYNC = 'now SIGNAL a_go';
--connection con_a
--replace_regex /names node [0-9]+/names node <N>/
--error ER_INNODB_INDEX_CORRUPT
--reap
SET DEBUG = '-d,vec_aux_node_missing_after_entry';

--echo # A search that starts now is refused, as it should be.
--connection default
--error ER_INDEX_CORRUPT
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'euclidean') LIMIT 1;

--echo # The parked search walks the graph now. It does not fail: it skips
--echo # the NODE_LOST node and answers from the entry point alone.
SET DEBUG_SYNC = 'now SIGNAL b_go';
--connection con_b
--disable_result_log
--reap
--enable_result_log
--disable_warnings
--let $rows = `SELECT FOUND_ROWS()`
--enable_warnings

--connection default
--echo # Both rows are reachable without the index. The graph returned one,
--echo # with no error. A correct server would refuse the search with
--echo # ER_INDEX_CORRUPT, as it refuses the one started after the index was
--echo # marked as corrupted.
--echo rows returned without error: $rows
SELECT COUNT(*) FROM t1;

--disconnect con_a
--disconnect con_b
SET DEBUG_SYNC = 'RESET';
DROP TABLE t1;
--source include/wait_until_count_sessions.inc

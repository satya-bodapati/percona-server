--source include/have_debug_sync.inc

--echo #
--echo # INNODB_VECTOR_INDEXES while an ALTER builds a vector index: the index
--echo # being built and the ALTER's intermediate table have no row. Their
--echo # memory is counted only in Innodb_hnsw_memory_used.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(4) NOT NULL,
                 VECTOR KEY vk (v) TYPE hnsw (M = 4));
INSERT INTO t1 VALUES (1, STRING_TO_VECTOR('[1,0,0,0]')),
                      (2, STRING_TO_VECTOR('[0,1,0,0]')),
                      (3, STRING_TO_VECTOR('[0,0,1,0]'));

CREATE TABLE t2 (id BIGINT UNSIGNED PRIMARY KEY,
                 v VECTOR(4) NOT NULL);
INSERT INTO t2 SELECT * FROM t1;

--connect (con1,localhost,root,,test)

--echo # Replacing a vector index in place: the new index is not committed.
--connection con1
SET DEBUG_SYNC = 'alter_table_inplace_after_lock_downgrade SIGNAL paused WAIT_FOR go';
--send ALTER TABLE t1 DROP KEY vk, ADD VECTOR KEY vk2 (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE, LOCK=SHARED
--connection default
SET DEBUG_SYNC = 'now WAIT_FOR paused';
SELECT table_name, index_name, m, nodes
  FROM information_schema.innodb_vector_indexes ORDER BY table_name, index_name;
SET DEBUG_SYNC = 'now SIGNAL go';
--connection con1
--reap
--connection default
SELECT table_name, index_name, m
  FROM information_schema.innodb_vector_indexes ORDER BY table_name, index_name;

--echo # The first vector index rebuilds the table in place.
--connection con1
SET DEBUG_SYNC = 'alter_table_inplace_before_commit SIGNAL paused WAIT_FOR go';
--send ALTER TABLE t2 ADD VECTOR KEY vk (v) TYPE hnsw (M = 4), ALGORITHM=INPLACE
--connection default
SET DEBUG_SYNC = 'now WAIT_FOR paused';
SELECT table_name, index_name
  FROM information_schema.innodb_vector_indexes ORDER BY table_name, index_name;
SET DEBUG_SYNC = 'now SIGNAL go';
--connection con1
--reap
--connection default
SELECT table_name, index_name
  FROM information_schema.innodb_vector_indexes ORDER BY table_name, index_name;

--echo # A COPY ALTER fills its intermediate table through the INSERT path, so
--echo # that table has a graph of its own. It is in the global number only.
--echo # Load t1's and t2's graphs first, so every other graph has a row.
SELECT id FROM t1
 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
SELECT id FROM t2
 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,0]'), 'EUCLIDEAN') LIMIT 1;
--connection con1
SET DEBUG_SYNC = 'alter_table_before_rename_result_table SIGNAL paused WAIT_FOR go';
--send ALTER TABLE t1 ADD COLUMN c INT, ALGORITHM=COPY
--connection default
SET DEBUG_SYNC = 'now WAIT_FOR paused';
SELECT table_name, index_name
  FROM information_schema.innodb_vector_indexes ORDER BY table_name, index_name;
SELECT (SELECT variable_value FROM performance_schema.global_status
         WHERE variable_name = 'Innodb_hnsw_memory_used') >
       (SELECT SUM(memory_bytes) FROM information_schema.innodb_vector_indexes)
       AS copy_counted_globally;
SET DEBUG_SYNC = 'now SIGNAL go';
--connection con1
--reap
--disconnect con1
--connection default
SET DEBUG_SYNC = 'RESET';
SELECT table_name, index_name
  FROM information_schema.innodb_vector_indexes ORDER BY table_name, index_name;

DROP TABLE t1, t2;

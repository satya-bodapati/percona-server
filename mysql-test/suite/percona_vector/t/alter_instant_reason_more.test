--echo #
--echo # ALGORITHM=INSTANT refusals for ALTERs that add the first vector
--echo # index together with something else, for tables that already have a
--echo # SPATIAL or FULLTEXT index, and for tables that have a vector index.
--echo #
CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
  g POINT NOT NULL SRID 0, txt VARCHAR(10), k INT);

--echo # Generic error: no reason applies to INSTANT.
--error ER_ALTER_OPERATION_NOT_SUPPORTED
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ADD KEY kk (k),
  ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), DROP COLUMN k,
  ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), FORCE,
  ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8),
  ADD FULLTEXT KEY ft (txt), ALGORITHM=INSTANT;

--echo # A reason set by another part of the ALTER is kept, the same one
--echo # the ALTER reports without the vector index.
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t ADD SPATIAL KEY sg (g), ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8),
  ADD SPATIAL KEY sg (g), ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t ADD COLUMN ai INT AUTO_INCREMENT, ADD UNIQUE KEY (ai),
  ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8),
  ADD COLUMN ai INT AUTO_INCREMENT, ADD UNIQUE KEY (ai), ALGORITHM=INSTANT;

--echo # LOCK=NONE gets the vector LOCK=NONE reason; LOCK=SHARED works.
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), LOCK=NONE;
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE,
  LOCK=SHARED;

--echo # Table has a vector index: the INSTANT reason where INPLACE works.
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t DROP KEY vk, ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t ADD SPATIAL KEY sg (g), ALGORITHM=INSTANT;

--echo # A check that refuses INPLACE as well gives its own reason, the one
--echo # INPLACE gets too.
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t ADD COLUMN vc INT AS (k + 1) VIRTUAL, ADD COLUMN c2 INT,
  ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t ADD COLUMN vc INT AS (k + 1) VIRTUAL, ADD COLUMN c2 INT,
  ALGORITHM=INPLACE;
SET sql_mode = '';
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t MODIFY k INT NOT NULL, ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t MODIFY k INT NOT NULL, ALGORITHM=INPLACE;
SET sql_mode = DEFAULT;
ALTER TABLE t ADD FULLTEXT KEY ft (txt), ALGORITHM=INPLACE, LOCK=SHARED;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t DROP KEY vk, ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t DROP KEY vk, ALGORITHM=INPLACE;
DROP TABLE t;

--echo # Adding the first vector index rebuilds the table, so on a table
--echo # with a SPATIAL or FULLTEXT index INSTANT gets the reason FORCE gets.
CREATE TABLE ts (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
  g POINT NOT NULL SRID 0, SPATIAL KEY sg (g));
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE ts FORCE, ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE ts ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INSTANT;
DROP TABLE ts;
CREATE TABLE tf (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
  txt VARCHAR(10), FULLTEXT KEY ft (txt));
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE tf FORCE, ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE tf ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INSTANT;
DROP TABLE tf;

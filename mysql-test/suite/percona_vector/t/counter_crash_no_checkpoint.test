--source include/have_debug.inc

--echo #
--echo # PS-11591: the same, with no checkpoint between the DDL and the crash.
--echo #
--echo # The table buffer still holds the entry from before the DDL, at the
--echo # old version, and every label record since carries the new one.
--echo # Recovery used to fold label records without their version, so the
--echo # entry stayed at the old version, was discarded at load, and the
--echo # counter fell back to the value the ALTER stored: the next INSERT
--echo # reused a label and the server stopped on the graph's duplicate-id
--echo # assertion.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, k INT,
                 v VECTOR(4) NOT NULL,
                 VECTOR KEY vk (v) TYPE hnsw (M = 4));
INSERT INTO t1 (k, v) VALUES
  (1, STRING_TO_VECTOR('[1,0,0,0]')), (2, STRING_TO_VECTOR('[0,1,0,0]')),
  (3, STRING_TO_VECTOR('[0,0,1,0]')), (4, STRING_TO_VECTOR('[0,0,0,1]'));
SET GLOBAL innodb_log_checkpoint_now = ON;
ALTER TABLE t1 ADD INDEX ik (k);

--echo # Labels 5 and 6, and no AUTO_INCREMENT advance.
DELETE FROM t1 WHERE id <= 2;
INSERT INTO t1 (id, k, v) VALUES
  (1, 11, STRING_TO_VECTOR('[2,0,0,0]')), (2, 12, STRING_TO_VECTOR('[0,2,0,0]'));

--source include/kill_and_restart_mysqld.inc

--echo # The next label is 7, and the next AUTO_INCREMENT id 5.
SET SESSION innodb_interpreter = 'vec_next_id test/t1';
SELECT @@session.innodb_interpreter_output;
INSERT INTO t1 (k, v) VALUES (13, STRING_TO_VECTOR('[3,1,0,0]'));
SELECT LAST_INSERT_ID();

DROP TABLE t1;

--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/count_sessions.inc

--echo #
--echo # DROP and ADD of a vector index in one statement runs with LOCK=NONE.
--echo # The table keeps its label column, and the ALTER rebuilds it, so the
--echo # new graph is built from the copied labels and the DML meanwhile
--echo # reaches it through the table's row log.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, k INT,
                 v VECTOR(4) NOT NULL,
                 VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t1 (k, v) VALUES
  (1, STRING_TO_VECTOR('[1,0,0,0]')), (2, STRING_TO_VECTOR('[0,1,0,0]')),
  (3, STRING_TO_VECTOR('[0,0,1,0]')), (4, STRING_TO_VECTOR('[0,0,0,1]')),
  (5, STRING_TO_VECTOR('[1,1,0,0]')), (6, STRING_TO_VECTOR('[0,1,1,0]')),
  (7, STRING_TO_VECTOR('[0,0,1,1]')), (8, STRING_TO_VECTOR('[1,0,0,1]'));

--connect (con1, localhost, root,,)

--echo # A new M, and then a new metric, each under logged DML.
--let $alter = ALTER TABLE t1 DROP KEY vk, ADD VECTOR KEY vk2 (v) TYPE hnsw (M = 4), ALGORITHM = INPLACE, LOCK = NONE
--let $vk_name = vk2
--source suite/percona_vector/include/online_dml.inc
--let $vk_name =
SHOW CREATE TABLE t1;

--let $alter = ALTER TABLE t1 DROP KEY vk2, ADD VECTOR KEY vk (v) TYPE hnsw (M = 8, metric = euclidean), ALGORITHM = INPLACE, LOCK = NONE
--source suite/percona_vector/include/online_dml.inc
SHOW CREATE TABLE t1;

--echo # The label counter goes on across both, and across a restart.
--disconnect con1
--source include/restart_mysqld.inc
INSERT INTO t1 (k, v) VALUES (100, STRING_TO_VECTOR('[5,5,5,5]'));
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
--source suite/percona_vector/include/every_row_found.inc

DROP TABLE t1;
--source include/wait_until_count_sessions.inc

--source include/have_debug.inc

--echo #
--echo # Every INSTANT operation on a table with a vector index, each followed
--echo # by DML, a search and a check that the graph and the aux agree.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, k INT, c VARCHAR(20),
                 v VECTOR(4) NOT NULL,
                 VECTOR KEY vk (v) TYPE hnsw (M = 4));
INSERT INTO t1 VALUES (1, 1, 'a', STRING_TO_VECTOR('[1,0,0,0]')),
                      (2, 2, 'b', STRING_TO_VECTOR('[0,1,0,0]')),
                      (3, 3, 'c', STRING_TO_VECTOR('[0,0,1,0]'));

--echo # ADD COLUMN at the end.
ALTER TABLE t1 ADD COLUMN e1 INT DEFAULT 11, ALGORITHM = INSTANT;
INSERT INTO t1 (id, k, c, v, e1) VALUES (4, 4, 'd', STRING_TO_VECTOR('[0,0,0,1]'), 44);
UPDATE t1 SET v = STRING_TO_VECTOR('[1,1,0,0]') WHERE id = 1;
SELECT id, k, c, VECTOR_TO_STRING(v), e1 FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,1]'), 'euclidean') LIMIT 1;
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # ADD COLUMN in the middle.
ALTER TABLE t1 ADD COLUMN m1 INT DEFAULT 5 AFTER k, ALGORITHM = INSTANT;
INSERT INTO t1 (id, k, m1, c, v, e1) VALUES (5, 5, 55, 'e', STRING_TO_VECTOR('[2,0,0,0]'), 55);
SELECT id, k, m1, c, VECTOR_TO_STRING(v), e1 FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'euclidean') LIMIT 1;
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # DROP COLUMN.
ALTER TABLE t1 DROP COLUMN c, ALGORITHM = INSTANT;
INSERT INTO t1 (id, k, m1, v, e1) VALUES (6, 6, 66, STRING_TO_VECTOR('[0,2,0,0]'), 66);
UPDATE t1 SET v = STRING_TO_VECTOR('[0,0,2,0]') WHERE id = 3;
SELECT id, k, m1, VECTOR_TO_STRING(v), e1 FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,2,0]'), 'euclidean') LIMIT 1;
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # RENAME COLUMN and SET DEFAULT.
ALTER TABLE t1 RENAME COLUMN k TO k2, ALGORITHM = INSTANT;
ALTER TABLE t1 ALTER COLUMN e1 SET DEFAULT 99, ALGORITHM = INSTANT;
INSERT INTO t1 (id, k2, m1, v) VALUES (7, 7, 77, STRING_TO_VECTOR('[3,0,0,0]'));
SELECT id, k2, m1, VECTOR_TO_STRING(v), e1 FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # A restart reloads the table and its graph from the DD and the aux.
--source include/restart_mysqld.inc
SELECT id, k2, m1, VECTOR_TO_STRING(v), e1 FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'euclidean') LIMIT 1;
INSERT INTO t1 (id, k2, m1, v) VALUES (8, 8, 88, STRING_TO_VECTOR('[0,3,0,0]'));
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # A later rebuild carries every instant column.
ALTER TABLE t1 FORCE;
SELECT id, k2, m1, VECTOR_TO_STRING(v), e1 FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,3,0,0]'), 'euclidean') LIMIT 1;
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;

DROP TABLE t1;

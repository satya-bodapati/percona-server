--source include/have_debug.inc
--source include/count_sessions.inc

--echo #
--echo # INSTANT ALTERs on a vector table while three sessions insert, update
--echo # the vector of, and delete rows. INSTANT commits under MDL_EXCLUSIVE, so
--echo # each DML statement runs wholly before or after a given ALTER; what is
--echo # checked is that the rows, the graph and the aux still agree.
--echo #

CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, k INT, pad INT DEFAULT 0,
                 v VECTOR(4) NOT NULL,
                 VECTOR KEY vk (v) TYPE hnsw (M = 8));

DELIMITER |;
CREATE PROCEDURE dml(p INT, n INT)
BEGIN
  DECLARE i INT DEFAULT 0;
  WHILE i < n DO
    INSERT INTO t1 (id, k, v) VALUES
      (p * 100000 + i, i,
       STRING_TO_VECTOR(CONCAT('[', p, ',', i % 11, ',', i % 7, ',', i % 5, ']')));
    UPDATE t1 SET v = STRING_TO_VECTOR(CONCAT('[', i % 13, ',', p, ',', i % 3, ',1]'))
     WHERE id = p * 100000 + FLOOR(i / 2);
    IF i % 5 = 4 THEN
      DELETE FROM t1 WHERE id = p * 100000 + i - 3;
    END IF;
    SET i = i + 1;
  END WHILE;
END|
DELIMITER ;|

--connect (c1, localhost, root,,)
--send CALL dml(1, 300)
--connect (c2, localhost, root,,)
--send CALL dml(2, 300)
--connect (c3, localhost, root,,)
--send CALL dml(3, 300)

--connection default
--disable_query_log
let $i = 8;
while ($i)
{
  eval ALTER TABLE t1 ADD COLUMN e$i INT DEFAULT $i, ALGORITHM = INSTANT;
  ALTER TABLE t1 ALTER COLUMN pad SET DEFAULT 7, ALGORITHM = INSTANT;
  ALTER TABLE t1 RENAME COLUMN pad TO pad2, ALGORITHM = INSTANT;
  ALTER TABLE t1 RENAME COLUMN pad2 TO pad, ALGORITHM = INSTANT;
  if ($i < 5)
  {
    eval ALTER TABLE t1 DROP COLUMN e$i, ALGORITHM = INSTANT;
  }
  dec $i;
}
--enable_query_log

--connection c1
--reap
--connection c2
--reap
--connection c3
--reap
--disconnect c1
--disconnect c2
--disconnect c3
--connection default

--echo # 3 x 300 inserted, 3 x 60 deleted.
SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY);
--echo # Columns e4..e1 were dropped again, e8..e5 stay.
SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS
 WHERE TABLE_SCHEMA = 'test' AND TABLE_NAME = 't1' ORDER BY ORDINAL_POSITION;

--echo # Every row has exactly one current node; old nodes of updated
--echo # vectors and deleted rows stay behind.
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;

--echo # The search uses the vector index ...
EXPLAIN FORMAT=TREE SELECT id FROM t1
 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,1,1,1]'), 'euclidean') LIMIT 1;
--echo # ... and its nearest row is as near as the exact scan's.
--source suite/percona_vector/include/nearest_is_exact.inc

--echo # And the same after a restart, from the DD and the aux.
--source include/restart_mysqld.inc
SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY);
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
--source suite/percona_vector/include/nearest_is_exact.inc
INSERT INTO t1 (id, k, v) VALUES (999999, 1, STRING_TO_VECTOR('[9,9,9,9]'));
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[9,9,9,9]'), 'euclidean') LIMIT 1;

DROP PROCEDURE dml;
DROP TABLE t1;
--source include/wait_until_count_sessions.inc

--echo #
--echo # ALGORITHM=INSTANT on a vector-indexed table: column changes are
--echo # instant, and an ALTER that also adds an index is refused for the
--echo # index, by the same rule as on any table. LOCK=NONE keeps its own
--echo # refusal.
--echo #

CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL, g INT,
                VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t VALUES (1, STRING_TO_VECTOR('[1,0,0,0]'), 1),
                     (2, STRING_TO_VECTOR('[0,1,0,0]'), 2);

ALTER TABLE t ADD COLUMN c INT, ALGORITHM=INSTANT;
ALTER TABLE t DROP COLUMN g, ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED
ALTER TABLE t ADD COLUMN c2 INT, ADD KEY kc (c), ALGORITHM=INSTANT;
--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
ALTER TABLE t ADD COLUMN c3 INT, ALGORITHM=INPLACE, LOCK=NONE;

INSERT INTO t (id, v, c) VALUES (3, STRING_TO_VECTOR('[0,0,1,0]'), 3);
SELECT id FROM t ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,1,0]'), 'euclidean') LIMIT 1;

DROP TABLE t;

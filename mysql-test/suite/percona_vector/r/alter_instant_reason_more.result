#
# ALGORITHM=INSTANT refusals for ALTERs that add the first vector
# index together with something else, for tables that already have a
# SPATIAL or FULLTEXT index, and for tables that have a vector index.
#
CREATE TABLE t (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
g POINT NOT NULL SRID 0, txt VARCHAR(10), k INT);
# Generic error: no reason applies to INSTANT.
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ADD KEY kk (k),
ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), DROP COLUMN k,
ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), FORCE,
ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8),
ADD FULLTEXT KEY ft (txt), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported for this operation. Try ALGORITHM=COPY/INPLACE.
# A reason set by another part of the ALTER is kept, the same one
# the ALTER reports without the vector index.
ALTER TABLE t ADD SPATIAL KEY sg (g), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: Do not support online operation on table with GIS index. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8),
ADD SPATIAL KEY sg (g), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: Do not support online operation on table with GIS index. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t ADD COLUMN ai INT AUTO_INCREMENT, ADD UNIQUE KEY (ai),
ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: Adding an auto-increment column requires a lock. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8),
ADD COLUMN ai INT AUTO_INCREMENT, ADD UNIQUE KEY (ai), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: Adding an auto-increment column requires a lock. Try ALGORITHM=COPY/INPLACE.
# LOCK=NONE gets the vector LOCK=NONE reason; LOCK=SHARED works.
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), LOCK=NONE;
ERROR 0A000: LOCK=NONE is not supported. Reason: InnoDB does not support LOCK=NONE on a table with a vector index. Try LOCK=SHARED.
ALTER TABLE t ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INPLACE,
LOCK=SHARED;
# Table has a vector index: the INSTANT reason where INPLACE works.
ALTER TABLE t DROP KEY vk, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: InnoDB does not support ALGORITHM=INSTANT on a table with a vector index. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t ADD SPATIAL KEY sg (g), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: InnoDB does not support ALGORITHM=INSTANT on a table with a vector index. Try ALGORITHM=COPY/INPLACE.
# A check that refuses INPLACE as well gives its own reason, the one
# INPLACE gets too.
ALTER TABLE t ADD COLUMN vc INT AS (k + 1) VIRTUAL, ADD COLUMN c2 INT,
ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: INPLACE ADD or DROP of virtual columns cannot be combined with other ALTER TABLE actions. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t ADD COLUMN vc INT AS (k + 1) VIRTUAL, ADD COLUMN c2 INT,
ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported. Reason: INPLACE ADD or DROP of virtual columns cannot be combined with other ALTER TABLE actions. Try ALGORITHM=COPY.
SET sql_mode = '';
ALTER TABLE t MODIFY k INT NOT NULL, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: cannot silently convert NULL values, as required in this SQL_MODE. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t MODIFY k INT NOT NULL, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported. Reason: cannot silently convert NULL values, as required in this SQL_MODE. Try ALGORITHM=COPY.
SET sql_mode = DEFAULT;
ALTER TABLE t ADD FULLTEXT KEY ft (txt), ALGORITHM=INPLACE, LOCK=SHARED;
Warnings:
Warning	124	InnoDB rebuilding table to add column FTS_DOC_ID
ALTER TABLE t DROP KEY vk, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: InnoDB presently supports one FULLTEXT index creation at a time. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE t DROP KEY vk, ALGORITHM=INPLACE;
ERROR 0A000: ALGORITHM=INPLACE is not supported. Reason: InnoDB presently supports one FULLTEXT index creation at a time. Try ALGORITHM=COPY.
DROP TABLE t;
# Adding the first vector index rebuilds the table, so on a table
# with a SPATIAL or FULLTEXT index INSTANT gets the reason FORCE gets.
CREATE TABLE ts (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
g POINT NOT NULL SRID 0, SPATIAL KEY sg (g));
ALTER TABLE ts FORCE, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: Do not support online operation on table with GIS index. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE ts ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: Do not support online operation on table with GIS index. Try ALGORITHM=COPY/INPLACE.
DROP TABLE ts;
CREATE TABLE tf (id BIGINT UNSIGNED PRIMARY KEY, v VECTOR(4) NOT NULL,
txt VARCHAR(10), FULLTEXT KEY ft (txt));
ALTER TABLE tf FORCE, ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: InnoDB presently supports one FULLTEXT index creation at a time. Try ALGORITHM=COPY/INPLACE.
ALTER TABLE tf ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM=INSTANT;
ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: InnoDB presently supports one FULLTEXT index creation at a time. Try ALGORITHM=COPY/INPLACE.
DROP TABLE tf;

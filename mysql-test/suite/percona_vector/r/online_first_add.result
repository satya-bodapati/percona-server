#
# The first ADD VECTOR INDEX runs with LOCK=NONE. It rebuilds the table
# to add the hidden label column: the scan labels the rows it copies,
# and the log apply labels the rows DML wrote meanwhile, from the same
# counter. Dropping the last vector index runs online too.
#
CREATE TABLE t1 (id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, k INT,
v VECTOR(4) NOT NULL);
INSERT INTO t1 (k, v) VALUES
(1, STRING_TO_VECTOR('[1,0,0,0]')), (2, STRING_TO_VECTOR('[0,1,0,0]')),
(3, STRING_TO_VECTOR('[0,0,1,0]')), (4, STRING_TO_VECTOR('[0,0,0,1]')),
(5, STRING_TO_VECTOR('[1,1,0,0]')), (6, STRING_TO_VECTOR('[0,1,1,0]')),
(7, STRING_TO_VECTOR('[0,0,1,1]')), (8, STRING_TO_VECTOR('[1,0,0,1]'));
SET DEBUG_SYNC = 'row_log_table_apply1_before SIGNAL built WAIT_FOR go';
ALTER TABLE t1 ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM = INPLACE, LOCK = NONE;
SET DEBUG_SYNC = 'now WAIT_FOR built';
INSERT INTO t1 (k, v) VALUES (9, STRING_TO_VECTOR('[9,1,0,0]'));
INSERT INTO t1 (k, v) VALUES (10, STRING_TO_VECTOR('[0,9,1,0]'));
UPDATE t1 SET v = STRING_TO_VECTOR('[0,0,9,1]') WHERE k = 3;
UPDATE t1 SET k = 44 WHERE k = 4;
UPDATE t1 SET v = STRING_TO_VECTOR('[1,0,0,9]') WHERE k = 10;
DELETE FROM t1 WHERE k = 5;
INSERT INTO t1 (id, k, v) VALUES (5, 55, STRING_TO_VECTOR('[9,9,1,1]'));
SET DEBUG_SYNC = 'now SIGNAL go';
SET DEBUG_SYNC = 'RESET';
# Each changed row is its own nearest neighbour.
SELECT k FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[9,1,0,0]'), 'euclidean') LIMIT 1;
k
9
SELECT k FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,9,1]'), 'euclidean') LIMIT 1;
k
3
SELECT k FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[1,0,0,9]'), 'euclidean') LIMIT 1;
k
10
SELECT k FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[9,9,1,1]'), 'euclidean') LIMIT 1;
k
55
SELECT k FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,1]'), 'euclidean') LIMIT 1;
k
44
SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY);
COUNT(*)
10
# One label per row, none shared.
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=13 distinct_ids=13 distinct_base_pks=10 dup_ids=0 dup_base_pks=3 labels_contiguous_from_1=1
query	same_nearest
1	1
query	same_nearest
2	1
query	same_nearest
3	1
query	same_nearest
4	1
query	same_nearest
5	1
all_rows_searched	rows_not_found
1	0
# The counter survives a restart: no label is reused.
# restart
INSERT INTO t1 (k, v) VALUES (11, STRING_TO_VECTOR('[3,3,3,0]'));
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=14 distinct_ids=14 distinct_base_pks=11 dup_ids=0 dup_base_pks=3 labels_contiguous_from_1=1
all_rows_searched	rows_not_found
1	0
#
# Dropping the last vector index, online, with DML during it: the
# column goes, and the rows come through without it.
#
SET DEBUG_SYNC = 'row_log_table_apply1_before SIGNAL built WAIT_FOR go';
ALTER TABLE t1 DROP KEY vk, ALGORITHM = INPLACE, LOCK = NONE;
SET DEBUG_SYNC = 'now WAIT_FOR built';
INSERT INTO t1 (k, v) VALUES (12, STRING_TO_VECTOR('[4,4,4,0]'));
UPDATE t1 SET v = STRING_TO_VECTOR('[5,5,5,0]') WHERE k = 11;
SET DEBUG_SYNC = 'now SIGNAL go';
SET DEBUG_SYNC = 'RESET';
SELECT COUNT(*) AS label_column FROM INFORMATION_SCHEMA.INNODB_COLUMNS c
JOIN INFORMATION_SCHEMA.INNODB_TABLES t USING (TABLE_ID)
WHERE t.NAME = 'test/t1' AND c.NAME = 'percona_vec_aux_id';
label_column
0
SELECT COUNT(*) FROM t1;
COUNT(*)
12
#
# A crash during an online first ADD rolls it back: no index, no
# column, and the rows DML wrote during it stay.
#
SET DEBUG_SYNC = 'row_log_table_apply1_before SIGNAL built WAIT_FOR never';
ALTER TABLE t1 ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM = INPLACE, LOCK = NONE;
SET DEBUG_SYNC = 'now WAIT_FOR built';
INSERT INTO t1 (k, v) VALUES (13, STRING_TO_VECTOR('[6,6,6,0]'));
# Kill and restart
SELECT COUNT(*) AS label_column FROM INFORMATION_SCHEMA.INNODB_COLUMNS c
JOIN INFORMATION_SCHEMA.INNODB_TABLES t USING (TABLE_ID)
WHERE t.NAME = 'test/t1' AND c.NAME = 'percona_vec_aux_id';
label_column
0
SELECT COUNT(*) FROM t1;
COUNT(*)
13
# And the ADD works afterwards, online.
ALTER TABLE t1 ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM = INPLACE, LOCK = NONE;
SELECT k FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[6,6,6,0]'), 'euclidean') LIMIT 1;
k
13
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=13 distinct_ids=13 distinct_base_pks=13 dup_ids=0 dup_base_pks=0 labels_contiguous_from_1=1
all_rows_searched	rows_not_found
1	0
#
# DML after the first log apply reaches the new table in the last one,
# at commit, which labels those rows too. The counter stored in the
# new definition has to include them: after a restart it is what the
# next label comes from.
#
ALTER TABLE t1 DROP KEY vk, ALGORITHM = INPLACE, LOCK = NONE;
SET DEBUG_SYNC = 'inplace_after_index_build SIGNAL applied WAIT_FOR go';
ALTER TABLE t1 ADD VECTOR KEY vk (v) TYPE hnsw (M = 8), ALGORITHM = INPLACE, LOCK = NONE;
SET DEBUG_SYNC = 'now WAIT_FOR applied';
INSERT INTO t1 (k, v) VALUES (14, STRING_TO_VECTOR('[7,0,7,0]')),
(15, STRING_TO_VECTOR('[0,7,0,7]'));
UPDATE t1 SET v = STRING_TO_VECTOR('[7,7,7,7]') WHERE k = 13;
SET DEBUG_SYNC = 'now SIGNAL go';
SET DEBUG_SYNC = 'RESET';
# restart
INSERT INTO t1 (k, v) VALUES (16, STRING_TO_VECTOR('[8,0,0,0]')),
(17, STRING_TO_VECTOR('[0,8,0,0]')),
(18, STRING_TO_VECTOR('[0,0,8,0]'));
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=19 distinct_ids=19 distinct_base_pks=18 dup_ids=0 dup_base_pks=1 labels_contiguous_from_1=1
all_rows_searched	rows_not_found
1	0
DROP TABLE t1;

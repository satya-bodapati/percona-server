#
# Every INSTANT operation on a table with a vector index, each followed
# by DML, a search and a check that the graph and the aux agree.
#
CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY, k INT, c VARCHAR(20),
v VECTOR(4) NOT NULL,
VECTOR KEY vk (v) TYPE hnsw (M = 4));
INSERT INTO t1 VALUES (1, 1, 'a', STRING_TO_VECTOR('[1,0,0,0]')),
(2, 2, 'b', STRING_TO_VECTOR('[0,1,0,0]')),
(3, 3, 'c', STRING_TO_VECTOR('[0,0,1,0]'));
# ADD COLUMN at the end.
ALTER TABLE t1 ADD COLUMN e1 INT DEFAULT 11, ALGORITHM = INSTANT;
INSERT INTO t1 (id, k, c, v, e1) VALUES (4, 4, 'd', STRING_TO_VECTOR('[0,0,0,1]'), 44);
UPDATE t1 SET v = STRING_TO_VECTOR('[1,1,0,0]') WHERE id = 1;
SELECT id, k, c, VECTOR_TO_STRING(v), e1 FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
id	k	c	VECTOR_TO_STRING(v)	e1
1	1	a	[1.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	11
2	2	b	[0.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	11
3	3	c	[0.00000e+00,0.00000e+00,1.00000e+00,0.00000e+00]	11
4	4	d	[0.00000e+00,0.00000e+00,0.00000e+00,1.00000e+00]	44
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,0,1]'), 'euclidean') LIMIT 1;
id
4
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=5 distinct_ids=5 distinct_base_pks=4 dup_ids=0 dup_base_pks=1 labels_contiguous_from_1=1
# ADD COLUMN in the middle.
ALTER TABLE t1 ADD COLUMN m1 INT DEFAULT 5 AFTER k, ALGORITHM = INSTANT;
INSERT INTO t1 (id, k, m1, c, v, e1) VALUES (5, 5, 55, 'e', STRING_TO_VECTOR('[2,0,0,0]'), 55);
SELECT id, k, m1, c, VECTOR_TO_STRING(v), e1 FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
id	k	m1	c	VECTOR_TO_STRING(v)	e1
1	1	5	a	[1.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	11
2	2	5	b	[0.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	11
3	3	5	c	[0.00000e+00,0.00000e+00,1.00000e+00,0.00000e+00]	11
4	4	5	d	[0.00000e+00,0.00000e+00,0.00000e+00,1.00000e+00]	44
5	5	55	e	[2.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	55
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[2,0,0,0]'), 'euclidean') LIMIT 1;
id
5
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=6 distinct_ids=6 distinct_base_pks=5 dup_ids=0 dup_base_pks=1 labels_contiguous_from_1=1
# DROP COLUMN.
ALTER TABLE t1 DROP COLUMN c, ALGORITHM = INSTANT;
INSERT INTO t1 (id, k, m1, v, e1) VALUES (6, 6, 66, STRING_TO_VECTOR('[0,2,0,0]'), 66);
UPDATE t1 SET v = STRING_TO_VECTOR('[0,0,2,0]') WHERE id = 3;
SELECT id, k, m1, VECTOR_TO_STRING(v), e1 FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
id	k	m1	VECTOR_TO_STRING(v)	e1
1	1	5	[1.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	11
2	2	5	[0.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	11
3	3	5	[0.00000e+00,0.00000e+00,2.00000e+00,0.00000e+00]	11
4	4	5	[0.00000e+00,0.00000e+00,0.00000e+00,1.00000e+00]	44
5	5	55	[2.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	55
6	6	66	[0.00000e+00,2.00000e+00,0.00000e+00,0.00000e+00]	66
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[0,0,2,0]'), 'euclidean') LIMIT 1;
id
3
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=8 distinct_ids=8 distinct_base_pks=6 dup_ids=0 dup_base_pks=2 labels_contiguous_from_1=1
# RENAME COLUMN and SET DEFAULT.
ALTER TABLE t1 RENAME COLUMN k TO k2, ALGORITHM = INSTANT;
ALTER TABLE t1 ALTER COLUMN e1 SET DEFAULT 99, ALGORITHM = INSTANT;
INSERT INTO t1 (id, k2, m1, v) VALUES (7, 7, 77, STRING_TO_VECTOR('[3,0,0,0]'));
SELECT id, k2, m1, VECTOR_TO_STRING(v), e1 FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
id	k2	m1	VECTOR_TO_STRING(v)	e1
1	1	5	[1.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	11
2	2	5	[0.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	11
3	3	5	[0.00000e+00,0.00000e+00,2.00000e+00,0.00000e+00]	11
4	4	5	[0.00000e+00,0.00000e+00,0.00000e+00,1.00000e+00]	44
5	5	55	[2.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	55
6	6	66	[0.00000e+00,2.00000e+00,0.00000e+00,0.00000e+00]	66
7	7	77	[3.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	99
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=9 distinct_ids=9 distinct_base_pks=7 dup_ids=0 dup_base_pks=2 labels_contiguous_from_1=1
# The vector column itself, the table, and virtual columns.
ALTER TABLE t1 RENAME COLUMN v TO w, ALGORITHM = INSTANT;
SELECT id FROM t1 ORDER BY DISTANCE(w, STRING_TO_VECTOR('[0,0,0,1]'), 'euclidean') LIMIT 1;
id
4
ALTER TABLE t1 RENAME COLUMN w TO v, ALGORITHM = INSTANT;
ALTER TABLE t1 RENAME TO t1r, ALGORITHM = INSTANT;
SELECT id FROM t1r ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'euclidean') LIMIT 1;
id
7
ALTER TABLE t1r RENAME TO t1, ALGORITHM = INSTANT;
ALTER TABLE t1 ADD COLUMN g INT AS (k2 + 1) VIRTUAL, ALGORITHM = INSTANT;
SELECT id, g FROM t1 FORCE INDEX (PRIMARY) WHERE id = 7;
id	g
7	8
ALTER TABLE t1 DROP COLUMN g, ALGORITHM = INSTANT;
# A restart reloads the table and its graph from the DD and the aux.
# restart
SELECT id, k2, m1, VECTOR_TO_STRING(v), e1 FROM t1 FORCE INDEX (PRIMARY) ORDER BY id;
id	k2	m1	VECTOR_TO_STRING(v)	e1
1	1	5	[1.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	11
2	2	5	[0.00000e+00,1.00000e+00,0.00000e+00,0.00000e+00]	11
3	3	5	[0.00000e+00,0.00000e+00,2.00000e+00,0.00000e+00]	11
4	4	5	[0.00000e+00,0.00000e+00,0.00000e+00,1.00000e+00]	44
5	5	55	[2.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	55
6	6	66	[0.00000e+00,2.00000e+00,0.00000e+00,0.00000e+00]	66
7	7	77	[3.00000e+00,0.00000e+00,0.00000e+00,0.00000e+00]	99
SELECT id FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR('[3,0,0,0]'), 'euclidean') LIMIT 1;
id
7
INSERT INTO t1 (id, k2, m1, v) VALUES (8, 8, 88, STRING_TO_VECTOR('[0,3,0,0]'));
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=10 distinct_ids=10 distinct_base_pks=8 dup_ids=0 dup_base_pks=2 labels_contiguous_from_1=1
# A later rebuild carries every instant column.
ALTER TABLE t1 FORCE;

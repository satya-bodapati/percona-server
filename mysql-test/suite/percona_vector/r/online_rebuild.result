#
# A rebuild that keeps a vector index runs with LOCK=NONE. DML during it
# reaches the new table through the row log, and each applied row gets
# its node in the new graph under the label it carries from the old
# table. The DML runs while the ALTER waits after its scan, so every
# change below reaches the new table only through the log.
#
CREATE TABLE t1 (id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY, k INT,
v VECTOR(4) NOT NULL,
VECTOR KEY vk (v) TYPE hnsw (M = 8));
INSERT INTO t1 (k, v) VALUES
(1, STRING_TO_VECTOR('[1,0,0,0]')), (2, STRING_TO_VECTOR('[0,1,0,0]')),
(3, STRING_TO_VECTOR('[0,0,1,0]')), (4, STRING_TO_VECTOR('[0,0,0,1]')),
(5, STRING_TO_VECTOR('[1,1,0,0]')), (6, STRING_TO_VECTOR('[0,1,1,0]')),
(7, STRING_TO_VECTOR('[0,0,1,1]')), (8, STRING_TO_VECTOR('[1,0,0,1]'));
SET DEBUG_SYNC = 'row_log_table_apply1_before SIGNAL built WAIT_FOR go';
ALTER TABLE t1 FORCE, ALGORITHM = INPLACE, LOCK = NONE;
SET DEBUG_SYNC = 'now WAIT_FOR built';
INSERT INTO t1 (k, v) VALUES (@k, STRING_TO_VECTOR(CONCAT('[', @k, ',1,0,0]')));
INSERT INTO t1 (k, v) VALUES (@k + 1, STRING_TO_VECTOR(CONCAT('[0,', @k, ',1,0]')));
UPDATE t1 SET v = STRING_TO_VECTOR(CONCAT('[0,0,', @k, ',1]')) WHERE k = 3;
UPDATE t1 SET k = k WHERE k = 4;
UPDATE t1 SET v = STRING_TO_VECTOR(CONCAT('[1,0,0,', @k, ']')) WHERE k = @k + 1;
DELETE FROM t1 WHERE k = 5;
INSERT INTO t1 (k, v) VALUES (5, STRING_TO_VECTOR(CONCAT('[', @k, ',', @k, ',1,1]')));
SET DEBUG_SYNC = 'now SIGNAL go';
SET DEBUG_SYNC = 'RESET';
# Each changed row is its own nearest neighbour.
SELECT k FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR(CONCAT('[', @k, ',1,0,0]')), 'euclidean') LIMIT 1;
k
9
SELECT k FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR(CONCAT('[0,0,', @k, ',1]')), 'euclidean') LIMIT 1;
k
3
SELECT k FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR(CONCAT('[1,0,0,', @k, ']')), 'euclidean') LIMIT 1;
k
10
SELECT k FROM t1 ORDER BY DISTANCE(v, STRING_TO_VECTOR(CONCAT('[', @k, ',', @k, ',1,1]')), 'euclidean') LIMIT 1;
k
5
SELECT COUNT(*) FROM t1 FORCE INDEX (PRIMARY);
COUNT(*)
10
SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
SELECT @@session.innodb_interpreter_output;
@@session.innodb_interpreter_output
nodes=13 distinct_ids=13 distinct_base_pks=11 dup_ids=0 dup_base_pks=2 labels_contiguous_from_1=1
query	same_nearest
1	1
query	same_nearest
2	1
query	same_nearest
3	1
query	same_nearest
4	1
query	same_nearest
5	1

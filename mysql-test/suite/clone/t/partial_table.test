# CLONE TABLE / CLONE DATABASE: the recipient (server 2) copies only the
# selected tables and the undo tablespaces of the donor (server 1), makes
# the files consistent as of the end of the clone, and imports them.

--source include/have_innodb_default_undo_tablespaces.inc
--let clone_inst_number = 2
--source ../include/clone_connection_begin.inc

--let $HOST = 127.0.0.1
--let $PORT = $SERVER_PORT_1
--let $USER = root
--let $RECIPIENT_DATADIR = $MYSQLTEST_VARDIR/mysqld.2/data

--echo # Donor
--connection default
--replace_result $CLONE_PLUGIN CLONE_PLUGIN
--eval INSTALL PLUGIN clone SONAME '$CLONE_PLUGIN'

--source ../include/create_schema.inc
call execute_dml(0, 0, 100, 100, 10, 0);

CREATE TABLE t3 (a INT) ENGINE = MyISAM;
CREATE TABLESPACE ts1 ADD DATAFILE 'ts1.ibd';
CREATE TABLE t4 (a INT) TABLESPACE ts1;

CHECKSUM TABLE t1, t2;

--echo # Recipient
--connection clone_conn_1
--replace_result $HOST HOST $PORT PORT
--eval SET GLOBAL clone_valid_donor_list = '$HOST:$PORT'

--echo # The donor refuses what it cannot clone
--replace_result $HOST HOST $PORT PORT
--error ER_CLONE_DONOR
--eval CLONE TABLE test.t_missing FROM '$USER'@'$HOST':$PORT IDENTIFIED BY ''

--replace_result $HOST HOST $PORT PORT
--error ER_CLONE_DONOR
--eval CLONE TABLE test.t3 FROM '$USER'@'$HOST':$PORT IDENTIFIED BY ''

--replace_result $HOST HOST $PORT PORT
--error ER_CLONE_DONOR
--eval CLONE TABLE test.t4 FROM '$USER'@'$HOST':$PORT IDENTIFIED BY ''

--replace_result $HOST HOST $PORT PORT
--error ER_CLONE_DONOR
--eval CLONE DATABASE db_missing FROM '$USER'@'$HOST':$PORT IDENTIFIED BY ''

--echo # Nothing is left of a failed clone
--list_files $RECIPIENT_DATADIR/#clone_stage
SHOW TABLES;

--echo # Clone two tables: a plain one and a partitioned one
--replace_result $HOST HOST $PORT PORT
--eval CLONE TABLE test.t1, test.t2 FROM '$USER'@'$HOST':$PORT IDENTIFIED BY ''

SHOW TABLES;
CHECKSUM TABLE t1, t2;
CHECK TABLE t1, t2;
SELECT col1, col2, col3 FROM t1 ORDER BY col1 LIMIT 5;
SELECT col1, col2, col3 FROM t2 ORDER BY col1 DESC LIMIT 5;
--list_files $RECIPIENT_DATADIR/#clone_stage
--list_files $RECIPIENT_DATADIR/test *.ibd

--echo # The cloned tables are tables like any other
INSERT INTO t1 VALUES (1000, 1, 'added here', NULL);
DELETE FROM t2 WHERE col1 = 1;
SELECT COUNT(*) FROM t1;
SELECT COUNT(*) FROM t2;
DROP TABLE t1, t2;

--echo # Clone a database: its InnoDB tables, not the MyISAM one
--connection default
DROP TABLE t4;
--connection clone_conn_1
--replace_result $HOST HOST $PORT PORT
--eval CLONE DATABASE test FROM '$USER'@'$HOST':$PORT IDENTIFIED BY ''

SHOW TABLES;
CHECKSUM TABLE t1, t2;
DROP TABLE t1, t2;

--echo # Clone under concurrent DML on the donor
--connection default
--echo # In connection con1 - Running Insert Random [100 - 200 Key range]
connect (con1,localhost,root,,);
--send call execute_dml(0, 100, 100, 100, 20, 1)

--echo # In connection con2 - Running Update Random [0 - 25 Key Range]
connect (con2,localhost,root,,);
--send call execute_dml(1, 0, 25, 100, 20, 1)

--echo # In connection con3 - Running Delete Random [26 - 50 Key Range]
connect (con3,localhost,root,,);
--send call execute_dml(2, 26, 25, 100, 20, 1)

--echo # In connection con4 - changes that stay uncommitted during the clone
connect (con4,localhost,root,,);
BEGIN;
UPDATE t1 SET col2 = -1 WHERE col1 BETWEEN 51 AND 75;
UPDATE t2 SET col2 = -1 WHERE col1 BETWEEN 51 AND 75;
DELETE FROM t1 WHERE col1 = 80;
DELETE FROM t2 WHERE col1 = 80;
INSERT INTO t1 VALUES (500, 500, 'never committed', NULL);
INSERT INTO t2 VALUES (500, 500, 'never committed', NULL);

--connection clone_conn_1
--replace_result $HOST HOST $PORT PORT
--eval CLONE TABLE test.t1, test.t2 FROM '$USER'@'$HOST':$PORT IDENTIFIED BY ''

--connection con1
--reap
--connection con2
--reap
--connection con3
--reap
--connection con4
ROLLBACK;
--connection default
--disconnect con1
--disconnect con2
--disconnect con3
--disconnect con4

--connection clone_conn_1
CHECK TABLE t1, t2;
--list_files $RECIPIENT_DATADIR/#clone_stage

--echo # The open transaction of the donor left nothing in the clone
SELECT col1, col2 FROM t1 WHERE col1 BETWEEN 51 AND 75 ORDER BY col1;
SELECT col1, col2 FROM t2 WHERE col1 BETWEEN 51 AND 75 ORDER BY col1;
SELECT col1 FROM t1 WHERE col1 IN (80, 500) ORDER BY col1;
SELECT col1 FROM t2 WHERE col1 IN (80, 500) ORDER BY col1;

--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_text = undo records of the open transaction were rolled back
--let $assert_select = Clone rollback: table .test.\..t1.: [1-9][0-9]* undo records of [1-9][0-9]* open transactions
--let $assert_count_condition = >= 1
--source include/assert_grep.inc

--echo # The staged redo was applied to the staged files
--let $assert_file = $MYSQLTEST_VARDIR/log/mysqld.2.err
--let $assert_text = redo records were applied to the staged pages
--let $assert_select = Clone Apply redo: [1-9][0-9]* records on [1-9][0-9]* pages
--let $assert_count_condition = >= 1
--source include/assert_grep.inc

--echo # Cleanup
DROP TABLE t1, t2;

# The objects clone_connection_begin.inc created on the recipient; a clone
# that replaces the data directory would have removed them.
DROP TABLE t_recipient;
DROP TABLESPACE tbs1_recipient;
ALTER UNDO TABLESPACE undo_005 SET INACTIVE;
--let $wait_condition = SELECT STATE = 'empty' FROM INFORMATION_SCHEMA.INNODB_TABLESPACES WHERE NAME = 'undo_005'
--source include/wait_condition.inc
DROP UNDO TABLESPACE undo_005;

--connection default
DROP TABLE t3;
DROP TABLESPACE ts1;
--source ../include/drop_schema.inc
UNINSTALL PLUGIN clone;
--source ../include/clone_connection_end.inc

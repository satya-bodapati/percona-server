DROP TABLE t1, t2;
# Clone a database: its InnoDB tables, not the MyISAM one
DROP TABLE t4;
CLONE DATABASE test FROM 'root'@'HOST':PORT IDENTIFIED BY '';
SHOW TABLES;
Tables_in_test
t1
t2
t_recipient
CHECKSUM TABLE t1, t2;
Table	Checksum
test.t1	3009907073
test.t2	3009907073
DROP TABLE t1, t2;
# Clone under concurrent DML on the donor
# In connection con1 - Running Insert Random [100 - 200 Key range]
call execute_dml(0, 100, 100, 100, 20, 1);
# In connection con2 - Running Update Random [0 - 25 Key Range]
call execute_dml(1, 0, 25, 100, 20, 1);
# In connection con3 - Running Delete Random [26 - 50 Key Range]
call execute_dml(2, 26, 25, 100, 20, 1);
# In connection con4 - changes that stay uncommitted during the clone
BEGIN;
UPDATE t1 SET col2 = -1 WHERE col1 BETWEEN 51 AND 75;
UPDATE t2 SET col2 = -1 WHERE col1 BETWEEN 51 AND 75;
DELETE FROM t1 WHERE col1 = 80;
DELETE FROM t2 WHERE col1 = 80;
INSERT INTO t1 VALUES (500, 500, 'never committed', NULL);
INSERT INTO t2 VALUES (500, 500, 'never committed', NULL);
CLONE TABLE test.t1, test.t2 FROM 'root'@'HOST':PORT IDENTIFIED BY '';
ROLLBACK;
CHECK TABLE t1, t2;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
test.t2	check	status	OK

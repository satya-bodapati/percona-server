INSTALL PLUGIN clone SONAME 'CLONE_PLUGIN';
SET GLOBAL clone_valid_donor_list = 'HOST:PORT';
CREATE TABLE t1(col1 INT PRIMARY KEY, col2 int, col3 varchar(64), col4 BLOB);
CREATE TABLE t2(col1 INT PRIMARY KEY, col2 int, col3 varchar(64), col4 BLOB)
PARTITION BY KEY(col1) PARTITIONS 5;
CREATE PROCEDURE execute_dml(
p_dml_type	INT,
p_key_min	INT,
p_key_range	INT,
p_loop_count	INT,
p_frequency	INT,
p_is_rand	INT)
BEGIN
DECLARE v_idx		INT DEFAULT 0;
DECLARE v_commit	INT DEFAULT 0;
DECLARE v_key		INT DEFAULT 0;
/* Loop and INSERT data at random position */
WHILE(v_idx < p_loop_count) DO
/* Generate key between 1 to p_loop_count */
IF p_is_rand = 1 THEN
SET v_key = p_key_min + FLOOR(RAND() * p_key_range);
ELSE
SET v_key = p_key_min + (v_idx  % p_key_range);
END IF;
CASE p_dml_type
WHEN 0 THEN
SET @clol3_text = CONCAT('Clone Test Row - ', v_key);
INSERT INTO t1 (col1, col2, col3, col4) VALUES (
v_key, v_key * 10,
@clol3_text, REPEAT('Large Column Data ', 2048))
ON DUPLICATE KEY UPDATE col2 = col2 + 1;
INSERT INTO t2 (col1, col2, col3, col4) VALUES (
v_key, v_key * 10,
@clol3_text, REPEAT('Large Column Data ', 2048))
ON DUPLICATE KEY UPDATE col2 = col2 + 1;
WHEN 1 THEN
UPDATE t1 SET col2 = v_idx + 1 WHERE col1 = v_key;
UPDATE t2 SET col2 = v_idx + 1 WHERE col1 = v_key;
WHEN 2 THEN
DELETE FROM t1 WHERE col1 = v_key;
DELETE FROM t2 WHERE col1 = v_key;
ELSE
DELETE FROM t1;
DELETE FROM t2;
END CASE;
SET v_idx = v_idx + 1;
/* Commit or rollback work at specified frequency. */
IF v_idx % p_frequency = 0 THEN
SET v_commit = FLOOR(RAND() * 2);
IF v_commit = 0 AND p_is_rand = 1 THEN
ROLLBACK;
START TRANSACTION;
ELSE
COMMIT;
START TRANSACTION;
END IF;
END IF;
END WHILE;
COMMIT;
END|
call execute_dml(0, 0, 100, 100, 10, 0);
CREATE TABLE t3 (a INT) ENGINE = MyISAM;
CREATE TABLESPACE ts1 ADD DATAFILE 'ts1.ibd';
CREATE TABLE t4 (a INT) TABLESPACE ts1;
# The donor refuses what it cannot clone
CLONE TABLE test.t_missing FROM 'root'@'HOST':PORT IDENTIFIED BY '';
ERROR HY000: Clone Donor Error: 1146 : Table 'test.t_missing' doesn't exist.
CLONE TABLE test.t3 FROM 'root'@'HOST':PORT IDENTIFIED BY '';
ERROR HY000: Clone Donor Error: 1235 : This version of MySQL doesn't yet support 'cloning a non-InnoDB table'.
CLONE TABLE test.t4 FROM 'root'@'HOST':PORT IDENTIFIED BY '';
ERROR HY000: Clone Donor Error: 1235 : This version of MySQL doesn't yet support 'cloning a table from a general or system tablespace'.
CLONE DATABASE db_missing FROM 'root'@'HOST':PORT IDENTIFIED BY '';
ERROR HY000: Clone Donor Error: 1049 : Unknown database 'db_missing'.
# Nothing was staged
# Clone two tables: a plain one and a partitioned one
CLONE TABLE t1, test.t2 FROM 'root'@'HOST':PORT IDENTIFIED BY '';
# Clone a database: its InnoDB tables, not the MyISAM one
DROP TABLE t4;
CLONE DATABASE test FROM 'root'@'HOST':PORT IDENTIFIED BY '';
# Staged files: selected tables and undo tablespaces only
2 staging directories
stage 1:
  test/t1.ibd
  test/t2#p#p0.ibd
  test/t2#p#p1.ibd
  test/t2#p#p2.ibd
  test/t2#p#p3.ibd
  test/t2#p#p4.ibd
  undo_001
  undo_002
  ibdata1: absent
  mysql.ibd: absent
  ts1.ibd: absent
  test/t3.MYD: absent
  t1.ibd size matches donor: yes
stage 2:
  test/t1.ibd
  test/t2#p#p0.ibd
  test/t2#p#p1.ibd
  test/t2#p#p2.ibd
  test/t2#p#p3.ibd
  test/t2#p#p4.ibd
  undo_001
  undo_002
  ibdata1: absent
  mysql.ibd: absent
  ts1.ibd: absent
  test/t3.MYD: absent
  t1.ibd size matches donor: yes
# Clone under concurrent DML, with an open transaction at the end
# In connection con1 - Running Insert Random [100 - 200 Key range]
call execute_dml(0, 100, 100, 100, 20, 1);
# In connection con2 - Running Update Random [0 - 25 Key Range]
call execute_dml(1, 0, 25, 100, 20, 1);
# In connection con3 - Running Delete Random [26 - 50 Key Range]
call execute_dml(2, 26, 25, 100, 20, 1);
# In connection con4 - Running Update Random uncommited [51 - 75 Key Range]
begin;
call execute_dml(1, 51, 25, 100, 200, 1);
CLONE TABLE t1, t2 FROM 'root'@'HOST':PORT IDENTIFIED BY '';
commit;
# The staged redo was applied to the staged files
include/assert_grep.inc [redo records were applied to the staged pages]
# Every staged page has a valid checksum
  test/t1.ibd: ok
  test/t2#p#p0.ibd: ok
  test/t2#p#p1.ibd: ok
  test/t2#p#p2.ibd: ok
  test/t2#p#p3.ibd: ok
  test/t2#p#p4.ibd: ok
# Cleanup
DROP TABLE t3;
DROP TABLESPACE ts1;
DROP TABLE t1;
DROP TABLE t2;
DROP PROCEDURE execute_dml;
UNINSTALL PLUGIN clone;

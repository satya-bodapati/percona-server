CREATE TABLE t1 (id INT NOT NULL PRIMARY KEY,
b VARCHAR(3000) CHARACTER SET latin1 NOT NULL, KEY kb (b))
ENGINE=InnoDB ROW_FORMAT=DYNAMIC STATS_AUTO_RECALC=0;
SET SESSION cte_max_recursion_depth = 10000;
INSERT INTO t1
WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 10000)
SELECT n, CONCAT(LPAD(n, 8, '0'), REPEAT('x', 2900)) FROM seq;
SET @old_fill_factor = @@GLOBAL.innodb_fill_factor;
SET GLOBAL innodb_fill_factor = 100;
SET SESSION innodb_parallel_read_threads = 4;
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
SET GLOBAL innodb_fill_factor = @old_fill_factor;
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
SELECT COUNT(*) FROM t1 FORCE INDEX (kb);
COUNT(*)
10000
SELECT COUNT(*) FROM t1 FORCE INDEX (kb) WHERE b < CONCAT(LPAD(5000, 8, '0'), 'x');
COUNT(*)
4999
SELECT id FROM t1 FORCE INDEX (kb) WHERE b = CONCAT(LPAD(9999, 8, '0'), REPEAT('x', 2900));
id
9999
DROP TABLE t1;
# Indexes of no, one and a few leaf pages
CREATE TABLE t2 (id INT NOT NULL PRIMARY KEY, b INT NOT NULL, KEY kb (b))
ENGINE=InnoDB ROW_FORMAT=DYNAMIC STATS_AUTO_RECALC=0;
SET SESSION innodb_parallel_read_threads = 8;
OPTIMIZE TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t2	optimize	status	OK
CHECK TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	check	status	OK
INSERT INTO t2 VALUES (1, 1);
OPTIMIZE TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t2	optimize	status	OK
CHECK TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	check	status	OK
INSERT INTO t2
WITH RECURSIVE seq(n) AS (SELECT 2 UNION ALL SELECT n + 1 FROM seq WHERE n < 3000)
SELECT n, 3000 - n FROM seq;
OPTIMIZE TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t2	optimize	status	OK
CHECK TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	check	status	OK
SELECT COUNT(*), SUM(id), SUM(b) FROM t2 FORCE INDEX (kb);
COUNT(*)	SUM(id)	SUM(b)
3000	4501500	4495502
DROP TABLE t2;

test.t1	check	status	OK
#
# Empty table.
#
CREATE TABLE t4 LIKE t1;
OPTIMIZE TABLE t4;
Table	Op	Msg_type	Msg_text
test.t4	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t4	optimize	status	OK

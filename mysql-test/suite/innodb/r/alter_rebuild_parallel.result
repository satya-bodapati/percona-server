SET SESSION innodb_parallel_read_threads = 4;
SET SESSION cte_max_recursion_depth = 100000;
#
# Off-page LOBs, JSON and a primary key with a descending column.
#
CREATE TABLE t1 (
id INT NOT NULL,
k INT NOT NULL,
a VARCHAR(100),
b LONGTEXT,
c JSON,
PRIMARY KEY (id, k DESC),
KEY ka (a)
) ENGINE=InnoDB ROW_FORMAT=DYNAMIC;
INSERT INTO t1
WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 30000)
SELECT n, n % 3, REPEAT(CHAR(97 + n % 26), n % 100),
IF(n % 50 = 0, REPEAT('b', 20000 + n), REPEAT('c', n % 300)),
JSON_OBJECT('n', n, 'pad', REPEAT('j', n % 200))
FROM seq;
SELECT COUNT(*), BIT_XOR(CRC32(CONCAT_WS('#', id, k, a, CRC32(b), c))) AS crc FROM t1;
COUNT(*)	crc
30000	1217301111
Pattern "Merging [0-9]+ subtrees created by 4 threads" not found
ALTER TABLE t1 ENGINE=InnoDB, ALGORITHM=INPLACE;
SELECT COUNT(*), BIT_XOR(CRC32(CONCAT_WS('#', id, k, a, CRC32(b), c))) AS crc FROM t1;
COUNT(*)	crc
30000	1217301111
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# The clustered index was built from more than one sub-tree.
Pattern "Merging ([2-9]|[1-9][0-9]+) subtrees created by 4 threads" found
# ADD COLUMN and DROP COLUMN rebuild the table in primary key order.
ALTER TABLE t1 ADD COLUMN d INT NOT NULL DEFAULT 7, ALGORITHM=INPLACE;
SELECT COUNT(*), SUM(d) FROM t1;
COUNT(*)	SUM(d)
30000	210000
ALTER TABLE t1 DROP COLUMN d, ALGORITHM=INPLACE;
SELECT COUNT(*), BIT_XOR(CRC32(CONCAT_WS('#', id, k, a, CRC32(b), c))) AS crc FROM t1;
COUNT(*)	crc
30000	1217301111
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# OPTIMIZE TABLE.
OPTIMIZE TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	optimize	note	Table does not support optimize, doing recreate + analyze instead
test.t1	optimize	status	OK
SELECT COUNT(*), BIT_XOR(CRC32(CONCAT_WS('#', id, k, a, CRC32(b), c))) AS crc FROM t1;
COUNT(*)	crc
30000	1217301111
#
# Online rebuild with concurrent DML. t2 gets the same DML without a
# rebuild.
#
CREATE TABLE t2 LIKE t1;
INSERT INTO t2 SELECT * FROM t1;
SET DEBUG_SYNC = 'ddl_after_scan SIGNAL scanned WAIT_FOR dml_done';
ALTER TABLE t1 ENGINE=InnoDB, ALGORITHM=INPLACE, LOCK=NONE;
SET DEBUG_SYNC = 'now WAIT_FOR scanned';
DELETE FROM t1 WHERE id BETWEEN 100 AND 200;
DELETE FROM t2 WHERE id BETWEEN 100 AND 200;
UPDATE t1 SET b = REPEAT('u', 30000) WHERE id % 1000 = 0;
UPDATE t2 SET b = REPEAT('u', 30000) WHERE id % 1000 = 0;
INSERT INTO t1 VALUES (40000, 1, 'new', REPEAT('n', 25000), '{"n": 40000}');
INSERT INTO t2 VALUES (40000, 1, 'new', REPEAT('n', 25000), '{"n": 40000}');
SET DEBUG_SYNC = 'now SIGNAL dml_done';
SET DEBUG_SYNC = 'RESET';
SELECT COUNT(*), BIT_XOR(CRC32(CONCAT_WS('#', id, k, a, CRC32(b), c))) AS crc FROM t1;
COUNT(*)	crc
29900	3566829578
SELECT COUNT(*), BIT_XOR(CRC32(CONCAT_WS('#', id, k, a, CRC32(b), c))) AS crc FROM t2;
COUNT(*)	crc
29900	3566829578
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
DROP TABLE t2;
#
# An error while the scan threads build the sub-trees leaves the table
# unchanged.
#
# The scan threads take the global debug settings.
SET GLOBAL DEBUG = '+d,builder_add_row_trigger_error';
ALTER TABLE t1 ENGINE=InnoDB, ALGORITHM=INPLACE;
ERROR HY000: Creating index 'PRIMARY' required more than 'innodb_online_alter_log_max_size' bytes of modification log. Please try again.
SET GLOBAL DEBUG = '-d,builder_add_row_trigger_error';
SELECT COUNT(*), BIT_XOR(CRC32(CONCAT_WS('#', id, k, a, CRC32(b), c))) AS crc FROM t1;
COUNT(*)	crc
29900	3566829578
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
# A sub-tree fails to finish, as on a full disk.
SET GLOBAL DEBUG = '+d,builder_subtree_finish_trigger_error';
ALTER TABLE t1 ENGINE=InnoDB, ALGORITHM=INPLACE;
ERROR HY000: The table 't1' is full
SET GLOBAL DEBUG = '-d,builder_subtree_finish_trigger_error';
SELECT COUNT(*), BIT_XOR(CRC32(CONCAT_WS('#', id, k, a, CRC32(b), c))) AS crc FROM t1;
COUNT(*)	crc
29900	3566829578
CHECK TABLE t1;
Table	Op	Msg_type	Msg_text
test.t1	check	status	OK
#
# A record that does not fit in a page fails the rebuild with the same
# error with one scan thread and with the sub-trees.
#
CREATE TABLE t6 (id INT PRIMARY KEY, c0 CHAR(200) NOT NULL DEFAULT '')
ENGINE=InnoDB CHARSET=latin1;
INSERT INTO t6 (id)
WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 20000)
SELECT n FROM seq;
SET SESSION innodb_strict_mode = OFF;
SET SESSION innodb_parallel_read_threads = 1;

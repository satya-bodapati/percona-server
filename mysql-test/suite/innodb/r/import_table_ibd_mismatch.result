#
# IMPORT TABLE FROM '<file>.ibd' with files that do not belong
# together. Each case is refused with an error.
#
#
# Only the first partition's file holds the table definition. A later
# partition copied after an INSTANT ADD COLUMN has rows that definition
# cannot parse.
#
CREATE TABLE t1 (id INT PRIMARY KEY, a INT) PARTITION BY RANGE (id)
(PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN (20));
INSERT INTO t1 VALUES (1, 1), (11, 11);
FLUSH TABLES t1 FOR EXPORT;
UNLOCK TABLES;
ALTER TABLE t1 ADD COLUMN c VARCHAR(30) DEFAULT 'dflt', ALGORITHM=INSTANT;
INSERT INTO t1 VALUES (2, 2, 'two'), (12, 12, 'twelve');
FLUSH TABLES t1 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE t1;
IMPORT TABLE FROM 'test/t1#p#*.ibd';
ERROR HY000: Schema mismatch (Table `test`.`t1` /* Partition `p1` */: page 4 of the tablespace file has rows written by a later definition of the table than the one it is imported with. The files of the table were copied at different times.)
SELECT * FROM t1;
ERROR 42S02: Table 'test.t1' doesn't exist
# The same after an INSTANT DROP COLUMN.
CREATE TABLE t2 (id INT PRIMARY KEY, a INT, x INT) PARTITION BY RANGE (id)
(PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN (20));
INSERT INTO t2 VALUES (1, 1, 1), (11, 11, 11);
FLUSH TABLES t2 FOR EXPORT;
UNLOCK TABLES;
ALTER TABLE t2 DROP COLUMN x, ALGORITHM=INSTANT;
INSERT INTO t2 VALUES (3, 3), (13, 13);
FLUSH TABLES t2 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE t2;
IMPORT TABLE FROM 'test/t2#p#*.ibd';
ERROR HY000: Schema mismatch (Table `test`.`t2` /* Partition `p1` */: page 4 of the tablespace file has rows written by a later definition of the table than the one it is imported with. The files of the table were copied at different times.)
SELECT * FROM t2;
ERROR 42S02: Table 'test.t2' doesn't exist
# Files copied together import.
IMPORT TABLE FROM 'test/t2#p#*.ibd';
SELECT * FROM t2 ORDER BY id;
id	a
1	1
3	3
11	11
13	13
CHECK TABLE t2;
Table	Op	Msg_type	Msg_text
test.t2	check	status	OK
DROP TABLE t2;
#
# A partition file holds no table definition, so it is matched to its
# partition by name and by the space id the definition records for it.
# Wrong files are refused before any file is changed, and all named
# files are kept.
#
CREATE DATABASE db2;
CREATE TABLE t3 (id INT PRIMARY KEY, v VARCHAR(20)) PARTITION BY RANGE (id)
(PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN (20),
PARTITION p2 VALUES LESS THAN MAXVALUE);
INSERT INTO t3 VALUES (1, 'a'), (11, 'k'), (21, 'u');
CREATE TABLE db2.t3 LIKE t3;
FLUSH TABLES t3, db2.t3 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE t3, db2.t3;
# The files of p0 and p1 swapped.
IMPORT TABLE FROM 'test/t3#p#*.ibd';
ERROR HY000: Schema mismatch ('DATADIRtest/t3#p#p0.ibd' holds partition `p1` of `test`.`t3`, not partition `p0` of `test`.`t3`)
t3#p#p0.ibd
t3#p#p1.ibd
t3#p#p2.ibd
# p1 is the file of the same table in another schema.
IMPORT TABLE FROM 'test/t3#p#*.ibd';
ERROR HY000: Schema mismatch ('DATADIRtest/t3#p#p1.ibd' holds the tablespace with space id N, not the one of partition `p1` of `test`.`t3` (space id N): it is a file of another table)
t3#p#p0.ibd
t3#p#p1.ibd
t3#p#p2.ibd
# A named file that is no partition, with the real p2 file present but
# not named: the unnamed file must not be imported.
IMPORT TABLE FROM 'test/t3#p#p0.ibd', 'test/t3#p#p1.ibd', 'test/t3#p#zz.ibd';
ERROR HY000: Schema mismatch ('DATADIRtest/t3#p#zz.ibd' is not a tablespace file of `test`.`t3`)
t3#p#p0.ibd
t3#p#p1.ibd
t3#p#p2.ibd
t3#p#zz.ibd
# One partition file in another schema directory.
IMPORT TABLE FROM 'test/t3#p#p0.ibd', 'db2/t3#p#p1.ibd', 'test/t3#p#p2.ibd';
ERROR HY000: Schema mismatch ('DATADIRdb2/t3#p#p1.ibd' is not in the same directory as the other files of its table)
# The right files import.
IMPORT TABLE FROM 'test/t3#p#*.ibd';
SELECT * FROM t3 ORDER BY id;
id	v
1	a
11	k
21	u
DROP TABLE t3;
DROP DATABASE db2;
#
# Every table of the statement is checked before any is created: a
# failure on a later table would delete the files of the earlier ones.
#
CREATE TABLE p (id INT PRIMARY KEY);
CREATE TABLE c (id INT PRIMARY KEY, pid INT,
FOREIGN KEY (pid) REFERENCES p (id));
CREATE TABLE a1 (id INT PRIMARY KEY);
INSERT INTO a1 VALUES (1);
FLUSH TABLES c, a1 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE c, a1, p;
# The parent of c does not exist, and foreign_key_checks is on.
IMPORT TABLE FROM 'test/a1.ibd', 'test/c.ibd';
ERROR HY000: Failed to open the referenced table 'p'
a1.ibd
c.ibd
SHOW TABLES;
Tables_in_test
#
# As for CREATE TABLE, a column's spatial reference system must exist.
#
CREATE SPATIAL REFERENCE SYSTEM 4000001 NAME 'TEST4000001 Long-Lat WGS 84' DEFINITION 'GEOGCS["Long-Lat WGS 84",DATUM["World Geodetic System 1984",SPHEROID["WGS 84",6378137,298.257223563,AUTHORITY["EPSG","7030"]],AUTHORITY["EPSG","6326"]],PRIMEM["Greenwich",0,AUTHORITY["EPSG","8901"]],UNIT["degree",0.017453292519943278,AUTHORITY["EPSG","9122"]],AXIS["Lon",EAST],AXIS["Lat",NORTH],AUTHORITY["EPSG","4326"]]';
CREATE TABLE g (id INT PRIMARY KEY, pt POINT NOT NULL SRID 4000001,
SPATIAL INDEX sp (pt));
INSERT INTO g VALUES (1, ST_GeomFromText('POINT(1 1)', 4000001));
FLUSH TABLES g FOR EXPORT;
UNLOCK TABLES;
DROP TABLE g;
DROP SPATIAL REFERENCE SYSTEM 4000001;
IMPORT TABLE FROM 'test/g.ibd';
ERROR SR001: There's no spatial reference system with SRID 4000001.

INSTALL COMPONENT 'file://component_mysqlbackup';
CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, b VARCHAR(4000))
ENGINE=InnoDB;
INSERT INTO t1 (b) VALUES (REPEAT('x', 4000));
#
# Fill the archive files up to ib_page_34
#
SET GLOBAL debug = '+d,page_archiver_one_page_per_block';
SET GLOBAL debug = '-d,page_archiver_one_page_per_block';
#
# A reset point above block 65535
#
UPDATE t1 SET b = REPEAT('z', 4000) WHERE id < 100;
SET GLOBAL innodb_buf_flush_list_now = ON;
SET GLOBAL innodb_log_checkpoint_now = ON;
# restart
#
# The changed pages since the reset point are read back
#
#
# Cleanup
#
SELECT mysqlbackup_page_track_set(0);
DROP TABLE t1;
UNINSTALL COMPONENT 'file://component_mysqlbackup';

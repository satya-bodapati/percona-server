#
# IMPORT TABLE FROM '<file>.ibd' creates a table, so it makes the checks
# that CREATE TABLE makes.
#
#
# The parent table of a foreign key is created before its child,
# whatever order the files are named in.
#
CREATE TABLE p (id INT PRIMARY KEY);
CREATE TABLE c (id INT PRIMARY KEY, pid INT,
FOREIGN KEY (pid) REFERENCES p (id));
CREATE TABLE a1 (id INT PRIMARY KEY);
INSERT INTO p VALUES (1);
INSERT INTO c VALUES (1, 1);
INSERT INTO a1 VALUES (1);
FLUSH TABLES p, c, a1 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE c, p, a1;
IMPORT TABLE FROM 'test/a1.ibd', 'test/c.ibd', 'test/p.ibd';
SELECT * FROM c;
id	pid
1	1
SHOW CREATE TABLE c;
Table	Create Table
c	CREATE TABLE `c` (
  `id` int NOT NULL,
  `pid` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `pid` (`pid`),
  CONSTRAINT `c_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `p` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
INSERT INTO c VALUES (2, 2);
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails (`test`.`c`, CONSTRAINT `c_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `p` (`id`))
DROP TABLE c, p, a1;
# Tables that reference each other need foreign_key_checks off, as for
# CREATE TABLE. With it on they are refused before any file is changed.
SET foreign_key_checks = 0;
CREATE TABLE x1 (id INT PRIMARY KEY, y INT, FOREIGN KEY (y) REFERENCES x2 (id));
CREATE TABLE x2 (id INT PRIMARY KEY, x INT, FOREIGN KEY (x) REFERENCES x1 (id));
SET foreign_key_checks = 1;
CREATE TABLE a2 (id INT PRIMARY KEY);
INSERT INTO a2 VALUES (1);
FLUSH TABLES x1, x2, a2 FOR EXPORT;
UNLOCK TABLES;
SET foreign_key_checks = 0;
DROP TABLE x1, x2, a2;
SET foreign_key_checks = 1;
IMPORT TABLE FROM 'test/a2.ibd', 'test/x1.ibd', 'test/x2.ibd';
ERROR HY000: Failed to open the referenced table 'x2'
a2.ibd
x1.ibd
x2.ibd
SET foreign_key_checks = 0;
IMPORT TABLE FROM 'test/a2.ibd', 'test/x1.ibd', 'test/x2.ibd';
SET foreign_key_checks = 1;
SELECT TABLE_NAME, REFERENCED_TABLE_NAME
FROM INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS
WHERE CONSTRAINT_SCHEMA = 'test' ORDER BY TABLE_NAME;
TABLE_NAME	REFERENCED_TABLE_NAME
x1	x2
x2	x1
SET foreign_key_checks = 0;
DROP TABLE x1, x2, a2;
SET foreign_key_checks = 1;
#
# REFERENCES is needed on the parent table of every foreign key.
#
CREATE TABLE p2 (id INT PRIMARY KEY);
CREATE TABLE c2 (id INT PRIMARY KEY, pid INT,
FOREIGN KEY (pid) REFERENCES p2 (id));
FLUSH TABLES c2 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE c2;
CREATE USER importer@localhost;
GRANT CREATE, ALTER ON test.* TO importer@localhost;
IMPORT TABLE FROM 'test/c2.ibd';
ERROR 42000: REFERENCES command denied to user 'importer'@'localhost' for table 'test.p2'
GRANT REFERENCES ON test.p2 TO importer@localhost;
IMPORT TABLE FROM 'test/c2.ibd';
DROP TABLE c2, p2;
DROP USER importer@localhost;
#
# With table_encryption_privilege_check on, a table encrypted unlike
# the schema's default needs TABLE_ENCRYPTION_ADMIN.
#
CREATE DATABASE edb DEFAULT ENCRYPTION = 'Y';
CREATE TABLE edb.e1 (id INT PRIMARY KEY) ENCRYPTION = 'N';
Warnings:
Warning	3824	Creating an unencrypted table in a database with default encryption enabled.
INSERT INTO edb.e1 VALUES (1);
FLUSH TABLES edb.e1 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE edb.e1;
CREATE USER importer@localhost;
GRANT CREATE, ALTER ON edb.* TO importer@localhost;
SET GLOBAL table_encryption_privilege_check = ON;
IMPORT TABLE FROM 'edb/e1.ibd';
ERROR HY000: Table encryption differ from its database default encryption, and user doesn't have enough privilege.
# With the check off, the table is imported with a warning.
SET GLOBAL table_encryption_privilege_check = OFF;
IMPORT TABLE FROM 'edb/e1.ibd';
Warnings:
Warning	3824	Creating an unencrypted table in a database with default encryption enabled.
SELECT * FROM edb.e1;
id
1
DROP TABLE edb.e1;
# With TABLE_ENCRYPTION_ADMIN, the check passes.
SET GLOBAL table_encryption_privilege_check = ON;
GRANT TABLE_ENCRYPTION_ADMIN ON *.* TO importer@localhost;
IMPORT TABLE FROM 'edb/e1.ibd';
SET GLOBAL table_encryption_privilege_check = OFF;
SELECT * FROM edb.e1;
id
1
DROP DATABASE edb;
DROP USER importer@localhost;

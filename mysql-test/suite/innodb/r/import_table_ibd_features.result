#
# IMPORT TABLE FROM '<file>.ibd' with partitions, ROW_FORMAT=COMPRESSED,
# INSTANT columns, FULLTEXT indexes and foreign keys.
#
#
# A partitioned table: all partition files are named, with a pattern.
#
CREATE TABLE tp (id INT PRIMARY KEY, a VARCHAR(20))
PARTITION BY HASH (id) PARTITIONS 4;
INSERT INTO tp VALUES (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e');
FLUSH TABLES tp FOR EXPORT;
UNLOCK TABLES;
DROP TABLE tp;
# A missing partition file is an error.
IMPORT TABLE FROM 'test/tp#p#*.ibd';
ERROR HY000: Schema mismatch (IMPORT TABLE of `test`.`tp` needs all 4 partition files, 3 were named)
IMPORT TABLE FROM 'test/tp#p#*.ibd';
SHOW CREATE TABLE tp;
Table	Create Table
tp	CREATE TABLE `tp` (
  `id` int NOT NULL,
  `a` varchar(20) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
/*!50100 PARTITION BY HASH (`id`)
PARTITIONS 4 */
SELECT * FROM tp ORDER BY id;
id	a
1	a
2	b
3	c
4	d
5	e
SELECT * FROM tp PARTITION (p1) ORDER BY id;
id	a
1	a
5	e
CHECK TABLE tp;
Table	Op	Msg_type	Msg_text
test.tp	check	status	OK
DROP TABLE tp;
#
# Subpartitions.
#
CREATE TABLE tsp (id INT, d INT, PRIMARY KEY (id, d))
PARTITION BY RANGE (id) SUBPARTITION BY HASH (d) SUBPARTITIONS 2
(PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN MAXVALUE);
INSERT INTO tsp VALUES (1, 1), (2, 2), (11, 1), (12, 2);
FLUSH TABLES tsp FOR EXPORT;
UNLOCK TABLES;
DROP TABLE tsp;
IMPORT TABLE FROM 'test/tsp#p#*.ibd';
SELECT * FROM tsp ORDER BY id, d;
id	d
1	1
2	2
11	1
12	2
CHECK TABLE tsp;
Table	Op	Msg_type	Msg_text
test.tsp	check	status	OK
DROP TABLE tsp;
#
# ROW_FORMAT=COMPRESSED, with a BLOB stored off-page.
#
CREATE TABLE tz (id INT PRIMARY KEY, b LONGBLOB)
ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=8;
INSERT INTO tz VALUES (1, REPEAT('z', 50000)), (2, 'short');
FLUSH TABLES tz FOR EXPORT;
UNLOCK TABLES;
DROP TABLE tz;
IMPORT TABLE FROM 'test/tz.ibd';
SHOW CREATE TABLE tz;
Table	Create Table
tz	CREATE TABLE `tz` (
  `id` int NOT NULL,
  `b` longblob,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=COMPRESSED KEY_BLOCK_SIZE=8
SELECT id, LENGTH(b) FROM tz ORDER BY id;
id	LENGTH(b)
1	50000
2	5
CHECK TABLE tz;
Table	Op	Msg_type	Msg_text
test.tz	check	status	OK
DROP TABLE tz;
#
# Columns added and dropped with ALGORITHM=INSTANT (row versions).
#
CREATE TABLE ti (id INT PRIMARY KEY, a INT, b INT);
INSERT INTO ti VALUES (1, 1, 1);
ALTER TABLE ti ADD COLUMN c INT DEFAULT 5, ALGORITHM=INSTANT;
INSERT INTO ti VALUES (2, 2, 2, 2);
ALTER TABLE ti DROP COLUMN a, ALGORITHM=INSTANT;
INSERT INTO ti VALUES (3, 3, 3);
SELECT TOTAL_ROW_VERSIONS FROM INFORMATION_SCHEMA.INNODB_TABLES
WHERE NAME = 'test/ti';
TOTAL_ROW_VERSIONS
2
FLUSH TABLES ti FOR EXPORT;
UNLOCK TABLES;
DROP TABLE ti;
IMPORT TABLE FROM 'test/ti.ibd';
SHOW CREATE TABLE ti;
Table	Create Table
ti	CREATE TABLE `ti` (
  `id` int NOT NULL,
  `b` int DEFAULT NULL,
  `c` int DEFAULT '5',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT * FROM ti ORDER BY id;
id	b	c
1	1	5
2	2	2
3	3	3
SELECT TOTAL_ROW_VERSIONS FROM INFORMATION_SCHEMA.INNODB_TABLES
WHERE NAME = 'test/ti';
TOTAL_ROW_VERSIONS
2
CHECK TABLE ti;
Table	Op	Msg_type	Msg_text
test.ti	check	status	OK
INSERT INTO ti VALUES (4, 4, 4);
# restart
SELECT * FROM ti ORDER BY id;
id	b	c
1	1	5
2	2	2
3	3	3
4	4	4
CHECK TABLE ti;
Table	Op	Msg_type	Msg_text
test.ti	check	status	OK
DROP TABLE ti;
#
# A FULLTEXT index is not imported: it is marked corrupted and is
# rebuilt with ALTER TABLE.
#
call mtr.add_suppression("\\[Warning\\] .* Skip adjustment of root pages for index `ft`");
CREATE TABLE tf (id INT PRIMARY KEY, txt TEXT, FULLTEXT KEY ft (txt));
INSERT INTO tf VALUES (1, 'hello world'), (2, 'goodbye moon');
FLUSH TABLES tf FOR EXPORT;
Warnings:
Warning	1235	InnoDB: This version of MySQL doesn't yet support 'FLUSH TABLES on tables that have an FTS index. FTS auxiliary tables will not be flushed.'
Warning	1235	InnoDB: This version of MySQL doesn't yet support 'FLUSH TABLES on tables that have an FTS index. FTS auxiliary tables will not be flushed.'
UNLOCK TABLES;
Warnings:
Warning	1235	InnoDB: This version of MySQL doesn't yet support 'FLUSH TABLES on tables that have an FTS index. FTS auxiliary tables will not be flushed.'
DROP TABLE tf;
IMPORT TABLE FROM 'test/tf.ibd';
Warnings:
Warning	1817	InnoDB: Index corrupt: Index ft not found or corrupt, you should recreate this index.
SELECT * FROM tf ORDER BY id;
id	txt
1	hello world
2	goodbye moon
SELECT id FROM tf WHERE MATCH (txt) AGAINST ('hello');
ERROR HY000: The table does not have FULLTEXT index to support this query
# One statement that drops and adds the same index keeps it unusable;
# rebuild it with two.
ALTER TABLE tf DROP INDEX ft;
ALTER TABLE tf ADD FULLTEXT INDEX ft (txt);
SELECT id FROM tf WHERE MATCH (txt) AGAINST ('hello');
id
1
CHECK TABLE tf;
Table	Op	Msg_type	Msg_text
test.tf	check	status	OK
DROP TABLE tf;
#
# Foreign keys are kept. With foreign_key_checks on, the parent must
# exist; with it off, a missing parent is allowed, as for CREATE TABLE.
#
CREATE TABLE parent (id INT PRIMARY KEY);
CREATE TABLE child (id INT PRIMARY KEY, pid INT,
FOREIGN KEY fk (pid) REFERENCES parent (id));
INSERT INTO parent VALUES (1);
INSERT INTO child VALUES (1, 1);
FLUSH TABLES child FOR EXPORT;
UNLOCK TABLES;
DROP TABLE child;
IMPORT TABLE FROM 'test/child.ibd';
SHOW CREATE TABLE child;
Table	Create Table
child	CREATE TABLE `child` (
  `id` int NOT NULL,
  `pid` int DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `fk` (`pid`),
  CONSTRAINT `child_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `parent` (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci
SELECT * FROM child;
id	pid
1	1
INSERT INTO child VALUES (2, 99);
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails (`test`.`child`, CONSTRAINT `child_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `parent` (`id`))
DELETE FROM parent;
ERROR 23000: Cannot delete or update a parent row: a foreign key constraint fails (`test`.`child`, CONSTRAINT `child_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `parent` (`id`))
DROP TABLE child;
DROP TABLE parent;
IMPORT TABLE FROM 'test/child.ibd';
ERROR HY000: Failed to open the referenced table 'parent'
SET foreign_key_checks = 0;
IMPORT TABLE FROM 'test/child.ibd';
SET foreign_key_checks = 1;
CREATE TABLE parent (id INT PRIMARY KEY);
INSERT INTO parent VALUES (1);
INSERT INTO child VALUES (3, 42);
ERROR 23000: Cannot add or update a child row: a foreign key constraint fails (`test`.`child`, CONSTRAINT `child_ibfk_1` FOREIGN KEY (`pid`) REFERENCES `parent` (`id`))
INSERT INTO child VALUES (3, 1);
SELECT * FROM child ORDER BY id;
id	pid
1	1
3	1
DROP TABLE child;
DROP TABLE parent;

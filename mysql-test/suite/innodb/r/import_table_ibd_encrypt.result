#
# IMPORT TABLE FROM '<file>.ibd' of an encrypted table: the key comes
# from the .cfp file next to the .ibd.
#
# ----------------------------------------------------------------------
# Setup
# Creating custom global manifest file for MySQL server
# Creating custom global configuration file for keyring component: component_keyring_file
# Re-starting mysql server with manifest file
# ----------------------------------------------------------------------
CREATE TABLE te (id INT PRIMARY KEY, a VARCHAR(100), KEY (a))
ENCRYPTION = 'Y';
INSERT INTO te VALUES (1, 'secret one'), (2, 'secret two');
FLUSH TABLES te FOR EXPORT;
UNLOCK TABLES;
DROP TABLE te;
# Without the .cfp the table definition cannot even be read.
IMPORT TABLE FROM 'test/te.ibd';
ERROR HY000: Schema mismatch (Table is in an encrypted tablespace, but the encryption meta-data file 'te.cfp' cannot be found while importing.)
# With it, the table is imported and re-encrypted with this server's
# master key.
IMPORT TABLE FROM 'test/te.ibd';
SHOW CREATE TABLE te;
Table	Create Table
te	CREATE TABLE `te` (
  `id` int NOT NULL,
  `a` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `a` (`a`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ENCRYPTION='Y'
SELECT * FROM te ORDER BY id;
id	a
1	secret one
2	secret two
CHECK TABLE te;
Table	Op	Msg_type	Msg_text
test.te	check	status	OK
# restart: --plugin-dir=/home/satya/WORK/ps/ps-8.4-import-refactor/bld/plugin_output_directory
SELECT * FROM te ORDER BY id;
id	a
1	secret one
2	secret two
ALTER INSTANCE ROTATE INNODB MASTER KEY;
SELECT * FROM te ORDER BY id;
id	a
1	secret one
2	secret two
DROP TABLE te;
# ----------------------------------------------------------------------
# Teardown
# Removing local keyring file for keyring component: component_keyring_file
# Removing global configuration file for keyring component: component_keyring_file
# Removing global manifest file for MySQL server
# Restarting server without the manifest file
# ----------------------------------------------------------------------

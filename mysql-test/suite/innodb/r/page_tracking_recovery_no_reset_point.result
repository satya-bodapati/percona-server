INSTALL COMPONENT 'file://component_mysqlbackup';
CREATE TABLE t1 (id INT PRIMARY KEY, pad VARCHAR(1000)) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1, REPEAT('a', 1000));
SET GLOBAL DEBUG = '+d,page_archiver_skip_reset_block_write';
SET GLOBAL DEBUG = '-d,page_archiver_skip_reset_block_write';
# Kill and restart
# Recovery rejects the group
Pattern "has no reset point" found
# The group keeps its files and is no longer active
Old group: durable ib_page_0
# Page tracking starts a new group
# Clone works
INSTALL PLUGIN clone SONAME 'CLONE_PLUGIN';
CLONE LOCAL DATA DIRECTORY = 'CLONE_DATADIR';
UNINSTALL PLUGIN clone;
# The next restart leaves the old group as it is
# restart
Old group: durable ib_page_0
#
# Cleanup
#
SELECT mysqlbackup_page_track_set(0);
DROP TABLE t1;
UNINSTALL COMPONENT 'file://component_mysqlbackup';

--echo #
--echo # IMPORT TABLE FROM '<file>.ibd' creates a table, so it makes the checks
--echo # that CREATE TABLE makes.
--echo #

--source include/have_innodb_16k.inc

let $MYSQLD_DATADIR = `SELECT @@datadir`;
let $A = $MYSQL_TMP_DIR/import_checks;
--mkdir $A

--echo #
--echo # The parent table of a foreign key is created before its child,
--echo # whatever order the files are named in.
--echo #
CREATE TABLE p (id INT PRIMARY KEY);
CREATE TABLE c (id INT PRIMARY KEY, pid INT,
                FOREIGN KEY (pid) REFERENCES p (id));
CREATE TABLE a1 (id INT PRIMARY KEY);
INSERT INTO p VALUES (1);
INSERT INTO c VALUES (1, 1);
INSERT INTO a1 VALUES (1);
FLUSH TABLES p, c, a1 FOR EXPORT;
--copy_file $MYSQLD_DATADIR/test/p.ibd $A/p.ibd
--copy_file $MYSQLD_DATADIR/test/c.ibd $A/c.ibd
--copy_file $MYSQLD_DATADIR/test/a1.ibd $A/a1.ibd
UNLOCK TABLES;
DROP TABLE c, p, a1;
--copy_file $A/a1.ibd $MYSQLD_DATADIR/test/a1.ibd
--copy_file $A/c.ibd $MYSQLD_DATADIR/test/c.ibd
--copy_file $A/p.ibd $MYSQLD_DATADIR/test/p.ibd
IMPORT TABLE FROM 'test/a1.ibd', 'test/c.ibd', 'test/p.ibd';
SELECT * FROM c;
SHOW CREATE TABLE c;
--error ER_NO_REFERENCED_ROW_2
INSERT INTO c VALUES (2, 2);
DROP TABLE c, p, a1;

--echo # Tables that reference each other need foreign_key_checks off, as for
--echo # CREATE TABLE. With it on they are refused before any file is changed.
SET foreign_key_checks = 0;
CREATE TABLE x1 (id INT PRIMARY KEY, y INT, FOREIGN KEY (y) REFERENCES x2 (id));
CREATE TABLE x2 (id INT PRIMARY KEY, x INT, FOREIGN KEY (x) REFERENCES x1 (id));
SET foreign_key_checks = 1;
CREATE TABLE a2 (id INT PRIMARY KEY);
INSERT INTO a2 VALUES (1);
FLUSH TABLES x1, x2, a2 FOR EXPORT;
--copy_file $MYSQLD_DATADIR/test/x1.ibd $A/x1.ibd
--copy_file $MYSQLD_DATADIR/test/x2.ibd $A/x2.ibd
--copy_file $MYSQLD_DATADIR/test/a2.ibd $A/a2.ibd
UNLOCK TABLES;
SET foreign_key_checks = 0;
DROP TABLE x1, x2, a2;
SET foreign_key_checks = 1;
--copy_file $A/a2.ibd $MYSQLD_DATADIR/test/a2.ibd
--copy_file $A/x1.ibd $MYSQLD_DATADIR/test/x1.ibd
--copy_file $A/x2.ibd $MYSQLD_DATADIR/test/x2.ibd
--error ER_FK_CANNOT_OPEN_PARENT
IMPORT TABLE FROM 'test/a2.ibd', 'test/x1.ibd', 'test/x2.ibd';
--list_files $MYSQLD_DATADIR/test *.ibd
SET foreign_key_checks = 0;
IMPORT TABLE FROM 'test/a2.ibd', 'test/x1.ibd', 'test/x2.ibd';
SET foreign_key_checks = 1;
SELECT TABLE_NAME, REFERENCED_TABLE_NAME
  FROM INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS
  WHERE CONSTRAINT_SCHEMA = 'test' ORDER BY TABLE_NAME;
SET foreign_key_checks = 0;
DROP TABLE x1, x2, a2;
SET foreign_key_checks = 1;

--echo #
--echo # REFERENCES is needed on the parent table of every foreign key.
--echo #
CREATE TABLE p2 (id INT PRIMARY KEY);
CREATE TABLE c2 (id INT PRIMARY KEY, pid INT,
                 FOREIGN KEY (pid) REFERENCES p2 (id));
FLUSH TABLES c2 FOR EXPORT;
--copy_file $MYSQLD_DATADIR/test/c2.ibd $A/c2.ibd
UNLOCK TABLES;
DROP TABLE c2;
CREATE USER importer@localhost;
GRANT CREATE, ALTER ON test.* TO importer@localhost;
--copy_file $A/c2.ibd $MYSQLD_DATADIR/test/c2.ibd
--connect (con1, localhost, importer,,test)
--error ER_TABLEACCESS_DENIED_ERROR
IMPORT TABLE FROM 'test/c2.ibd';
--disconnect con1
--connection default
GRANT REFERENCES ON test.p2 TO importer@localhost;
--connect (con1, localhost, importer,,test)
IMPORT TABLE FROM 'test/c2.ibd';
--disconnect con1
--connection default
DROP TABLE c2, p2;
DROP USER importer@localhost;

--echo #
--echo # With table_encryption_privilege_check on, a table encrypted unlike
--echo # the schema's default needs TABLE_ENCRYPTION_ADMIN.
--echo #
CREATE DATABASE edb DEFAULT ENCRYPTION = 'Y';
CREATE TABLE edb.e1 (id INT PRIMARY KEY) ENCRYPTION = 'N';
INSERT INTO edb.e1 VALUES (1);
FLUSH TABLES edb.e1 FOR EXPORT;
--copy_file $MYSQLD_DATADIR/edb/e1.ibd $A/e1.ibd
UNLOCK TABLES;
DROP TABLE edb.e1;
CREATE USER importer@localhost;
GRANT CREATE, ALTER ON edb.* TO importer@localhost;
--copy_file $A/e1.ibd $MYSQLD_DATADIR/edb/e1.ibd
SET GLOBAL table_encryption_privilege_check = ON;
--connect (con1, localhost, importer,,test)
--error ER_CANNOT_SET_TABLE_ENCRYPTION
IMPORT TABLE FROM 'edb/e1.ibd';
--disconnect con1
--connection default

--echo # With the check off, the table is imported with a warning.
SET GLOBAL table_encryption_privilege_check = OFF;
--connect (con1, localhost, importer,,test)
IMPORT TABLE FROM 'edb/e1.ibd';
--disconnect con1
--connection default
SELECT * FROM edb.e1;
DROP TABLE edb.e1;

--echo # With TABLE_ENCRYPTION_ADMIN, the check passes.
--copy_file $A/e1.ibd $MYSQLD_DATADIR/edb/e1.ibd
SET GLOBAL table_encryption_privilege_check = ON;
GRANT TABLE_ENCRYPTION_ADMIN ON *.* TO importer@localhost;
--connect (con1, localhost, importer,,test)
IMPORT TABLE FROM 'edb/e1.ibd';
--disconnect con1
--connection default
SET GLOBAL table_encryption_privilege_check = OFF;
SELECT * FROM edb.e1;
DROP DATABASE edb;
DROP USER importer@localhost;

--echo #
--echo # An engine listed in disabled_storage_engines does not create tables,
--echo # so it does not import them either. The file is kept.
--echo #
CREATE TABLE d1 (id INT PRIMARY KEY);
INSERT INTO d1 VALUES (1);
FLUSH TABLES d1 FOR EXPORT;
--copy_file $MYSQLD_DATADIR/test/d1.ibd $A/d1.ibd
UNLOCK TABLES;
DROP TABLE d1;
--let $restart_parameters = restart: --disabled-storage-engines=InnoDB
--source include/restart_mysqld.inc
--error ER_DISABLED_STORAGE_ENGINE
CREATE TABLE d1 (id INT PRIMARY KEY) ENGINE = InnoDB;
--copy_file $A/d1.ibd $MYSQLD_DATADIR/test/d1.ibd
--error ER_DISABLED_STORAGE_ENGINE
IMPORT TABLE FROM 'test/d1.ibd';
--let $restart_parameters = restart:
--source include/restart_mysqld.inc
IMPORT TABLE FROM 'test/d1.ibd';
SELECT * FROM d1;
DROP TABLE d1;

--force-rmdir $A

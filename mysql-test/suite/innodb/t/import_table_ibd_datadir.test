--echo #
--echo # IMPORT TABLE FROM '<file>.ibd' of a table created with DATA DIRECTORY:
--echo # the file is named by its full path, in the schema directory under the
--echo # DATA DIRECTORY, which must be a known directory.
--echo #

--source include/have_innodb_16k.inc
--source include/not_windows.inc

let $MYSQLD_DATADIR = `SELECT @@datadir`;
let $EXT = $MYSQL_TMP_DIR/import_ext;
--mkdir $EXT

--let $restart_parameters = restart: --innodb-directories=$EXT
--replace_result $EXT EXT
--source include/restart_mysqld.inc

--replace_result $EXT EXT
eval CREATE TABLE td (id INT PRIMARY KEY, a VARCHAR(20)) DATA DIRECTORY = '$EXT';
INSERT INTO td VALUES (1, 'one'), (2, 'two');
FLUSH TABLES td FOR EXPORT;
--copy_file $EXT/test/td.ibd $MYSQL_TMP_DIR/td.ibd
UNLOCK TABLES;
DROP TABLE td;

--copy_file $MYSQL_TMP_DIR/td.ibd $EXT/test/td.ibd
--replace_result $EXT EXT
eval IMPORT TABLE FROM '$EXT/test/td.ibd';
--replace_result $EXT EXT
SHOW CREATE TABLE td;
SELECT * FROM td ORDER BY id;
CHECK TABLE td;
--replace_result $EXT EXT
SELECT PATH FROM INFORMATION_SCHEMA.INNODB_DATAFILES
  WHERE PATH LIKE '%td.ibd';
--replace_result $EXT EXT
--source include/restart_mysqld.inc
SELECT * FROM td ORDER BY id;
DROP TABLE td;

--echo # A directory InnoDB does not know is refused, as for CREATE TABLE.
call mtr.add_suppression("\\[ERROR\\] .* The DATA DIRECTORY location must be in a known directory");
--let $restart_parameters = restart:
--source include/restart_mysqld.inc
--copy_file $MYSQL_TMP_DIR/td.ibd $EXT/test/td.ibd
--replace_result $EXT EXT
--error ER_WRONG_FILE_NAME,ER_ILLEGAL_HA_CREATE_OPTION,ER_CANT_CREATE_TABLE
eval IMPORT TABLE FROM '$EXT/test/td.ibd';
--error ER_NO_SUCH_TABLE
SELECT * FROM td;

--remove_file $MYSQL_TMP_DIR/td.ibd
--force-rmdir $EXT

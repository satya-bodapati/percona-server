--echo #
--echo # IMPORT TABLE FROM '<file>.ibd' with files that do not belong
--echo # together. Each case is refused with an error.
--echo #

--source include/have_innodb_16k.inc

let $MYSQLD_DATADIR = `SELECT @@datadir`;
let $A = $MYSQL_TMP_DIR/import_mismatch_a;
let $B = $MYSQL_TMP_DIR/import_mismatch_b;
--mkdir $A
--mkdir $B

--echo #
--echo # Only the first partition's file holds the table definition. A later
--echo # partition copied after an INSTANT ADD COLUMN has rows that definition
--echo # cannot parse.
--echo #
CREATE TABLE t1 (id INT PRIMARY KEY, a INT) PARTITION BY RANGE (id)
  (PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN (20));
INSERT INTO t1 VALUES (1, 1), (11, 11);
FLUSH TABLES t1 FOR EXPORT;
--copy_files_wildcard $MYSQLD_DATADIR/test $A t1#p#*.ibd
UNLOCK TABLES;
ALTER TABLE t1 ADD COLUMN c VARCHAR(30) DEFAULT 'dflt', ALGORITHM=INSTANT;
INSERT INTO t1 VALUES (2, 2, 'two'), (12, 12, 'twelve');
FLUSH TABLES t1 FOR EXPORT;
--copy_files_wildcard $MYSQLD_DATADIR/test $B t1#p#*.ibd
UNLOCK TABLES;
DROP TABLE t1;

--copy_file $A/t1#p#p0.ibd $MYSQLD_DATADIR/test/t1#p#p0.ibd
--copy_file $B/t1#p#p1.ibd $MYSQLD_DATADIR/test/t1#p#p1.ibd
--error ER_TABLE_SCHEMA_MISMATCH
IMPORT TABLE FROM 'test/t1#p#*.ibd';
--error ER_NO_SUCH_TABLE
SELECT * FROM t1;
--remove_files_wildcard $MYSQLD_DATADIR/test t1#p#*

--echo # The same after an INSTANT DROP COLUMN.
CREATE TABLE t2 (id INT PRIMARY KEY, a INT, x INT) PARTITION BY RANGE (id)
  (PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN (20));
INSERT INTO t2 VALUES (1, 1, 1), (11, 11, 11);
FLUSH TABLES t2 FOR EXPORT;
--copy_files_wildcard $MYSQLD_DATADIR/test $A t2#p#*.ibd
UNLOCK TABLES;
ALTER TABLE t2 DROP COLUMN x, ALGORITHM=INSTANT;
INSERT INTO t2 VALUES (3, 3), (13, 13);
FLUSH TABLES t2 FOR EXPORT;
--copy_files_wildcard $MYSQLD_DATADIR/test $B t2#p#*.ibd
UNLOCK TABLES;
DROP TABLE t2;

--copy_file $A/t2#p#p0.ibd $MYSQLD_DATADIR/test/t2#p#p0.ibd
--copy_file $B/t2#p#p1.ibd $MYSQLD_DATADIR/test/t2#p#p1.ibd
--error ER_TABLE_SCHEMA_MISMATCH
IMPORT TABLE FROM 'test/t2#p#*.ibd';
--error ER_NO_SUCH_TABLE
SELECT * FROM t2;
--remove_files_wildcard $MYSQLD_DATADIR/test t2#p#*

--echo # Files copied together import.
--copy_files_wildcard $B $MYSQLD_DATADIR/test t2#p#*.ibd
IMPORT TABLE FROM 'test/t2#p#*.ibd';
SELECT * FROM t2 ORDER BY id;
CHECK TABLE t2;
DROP TABLE t2;

--echo #
--echo # A partition file holds no table definition, so it is matched to its
--echo # partition by name and by the space id the definition records for it.
--echo # Wrong files are refused before any file is changed, and all named
--echo # files are kept.
--echo #
CREATE DATABASE db2;
CREATE TABLE t3 (id INT PRIMARY KEY, v VARCHAR(20)) PARTITION BY RANGE (id)
  (PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN (20),
   PARTITION p2 VALUES LESS THAN MAXVALUE);
INSERT INTO t3 VALUES (1, 'a'), (11, 'k'), (21, 'u');
CREATE TABLE db2.t3 LIKE t3;
FLUSH TABLES t3, db2.t3 FOR EXPORT;
--copy_files_wildcard $MYSQLD_DATADIR/test $A t3#p#*.ibd
--copy_files_wildcard $MYSQLD_DATADIR/db2 $B t3#p#*.ibd
UNLOCK TABLES;
DROP TABLE t3, db2.t3;

--echo # The files of p0 and p1 swapped.
--copy_file $A/t3#p#p0.ibd $MYSQLD_DATADIR/test/t3#p#p1.ibd
--copy_file $A/t3#p#p1.ibd $MYSQLD_DATADIR/test/t3#p#p0.ibd
--copy_file $A/t3#p#p2.ibd $MYSQLD_DATADIR/test/t3#p#p2.ibd
--replace_result $MYSQLD_DATADIR DATADIR
--error ER_TABLE_SCHEMA_MISMATCH
IMPORT TABLE FROM 'test/t3#p#*.ibd';
--list_files $MYSQLD_DATADIR/test t3*
--remove_files_wildcard $MYSQLD_DATADIR/test t3#p#*

--echo # p1 is the file of the same table in another schema.
--copy_file $A/t3#p#p0.ibd $MYSQLD_DATADIR/test/t3#p#p0.ibd
--copy_file $B/t3#p#p1.ibd $MYSQLD_DATADIR/test/t3#p#p1.ibd
--copy_file $A/t3#p#p2.ibd $MYSQLD_DATADIR/test/t3#p#p2.ibd
--replace_result $MYSQLD_DATADIR DATADIR
--replace_regex /space id [0-9]+/space id N/
--error ER_TABLE_SCHEMA_MISMATCH
IMPORT TABLE FROM 'test/t3#p#*.ibd';
--list_files $MYSQLD_DATADIR/test t3*
--remove_files_wildcard $MYSQLD_DATADIR/test t3#p#*

--echo # A named file that is no partition, with the real p2 file present but
--echo # not named: the unnamed file must not be imported.
--copy_files_wildcard $A $MYSQLD_DATADIR/test t3#p#*.ibd
--copy_file $A/t3#p#p2.ibd $MYSQLD_DATADIR/test/t3#p#zz.ibd
--replace_result $MYSQLD_DATADIR DATADIR
--error ER_TABLE_SCHEMA_MISMATCH
IMPORT TABLE FROM 'test/t3#p#p0.ibd', 'test/t3#p#p1.ibd', 'test/t3#p#zz.ibd';
--list_files $MYSQLD_DATADIR/test t3*
--remove_files_wildcard $MYSQLD_DATADIR/test t3#p#*

--echo # One partition file in another schema directory.
--copy_file $A/t3#p#p0.ibd $MYSQLD_DATADIR/test/t3#p#p0.ibd
--copy_file $A/t3#p#p1.ibd $MYSQLD_DATADIR/db2/t3#p#p1.ibd
--copy_file $A/t3#p#p2.ibd $MYSQLD_DATADIR/test/t3#p#p2.ibd
--replace_result $MYSQLD_DATADIR DATADIR
--error ER_TABLE_SCHEMA_MISMATCH
IMPORT TABLE FROM 'test/t3#p#p0.ibd', 'db2/t3#p#p1.ibd', 'test/t3#p#p2.ibd';
--remove_files_wildcard $MYSQLD_DATADIR/test t3#p#*
--remove_files_wildcard $MYSQLD_DATADIR/db2 t3#p#*

--echo # The right files import.
--copy_files_wildcard $A $MYSQLD_DATADIR/test t3#p#*.ibd
IMPORT TABLE FROM 'test/t3#p#*.ibd';
SELECT * FROM t3 ORDER BY id;
DROP TABLE t3;
DROP DATABASE db2;

--echo #
--echo # Every table of the statement is checked before any is created: a
--echo # failure on a later table would delete the files of the earlier ones.
--echo #
CREATE TABLE p (id INT PRIMARY KEY);
CREATE TABLE c (id INT PRIMARY KEY, pid INT,
                FOREIGN KEY (pid) REFERENCES p (id));
CREATE TABLE a1 (id INT PRIMARY KEY);
INSERT INTO a1 VALUES (1);
FLUSH TABLES c, a1 FOR EXPORT;
--copy_file $MYSQLD_DATADIR/test/c.ibd $A/c.ibd
--copy_file $MYSQLD_DATADIR/test/a1.ibd $A/a1.ibd
UNLOCK TABLES;
DROP TABLE c, a1, p;

--echo # The parent of c does not exist, and foreign_key_checks is on.
--copy_file $A/a1.ibd $MYSQLD_DATADIR/test/a1.ibd
--copy_file $A/c.ibd $MYSQLD_DATADIR/test/c.ibd
--error ER_FK_CANNOT_OPEN_PARENT
IMPORT TABLE FROM 'test/a1.ibd', 'test/c.ibd';
--list_files $MYSQLD_DATADIR/test *.ibd
SHOW TABLES;
--remove_file $MYSQLD_DATADIR/test/a1.ibd
--remove_file $MYSQLD_DATADIR/test/c.ibd

--echo #
--echo # As for CREATE TABLE, a column's spatial reference system must exist.
--echo #
CREATE SPATIAL REFERENCE SYSTEM 4000001 NAME 'TEST4000001 Long-Lat WGS 84' DEFINITION 'GEOGCS["Long-Lat WGS 84",DATUM["World Geodetic System 1984",SPHEROID["WGS 84",6378137,298.257223563,AUTHORITY["EPSG","7030"]],AUTHORITY["EPSG","6326"]],PRIMEM["Greenwich",0,AUTHORITY["EPSG","8901"]],UNIT["degree",0.017453292519943278,AUTHORITY["EPSG","9122"]],AXIS["Lon",EAST],AXIS["Lat",NORTH],AUTHORITY["EPSG","4326"]]';
CREATE TABLE g (id INT PRIMARY KEY, pt POINT NOT NULL SRID 4000001,
                SPATIAL INDEX sp (pt));
INSERT INTO g VALUES (1, ST_GeomFromText('POINT(1 1)', 4000001));
FLUSH TABLES g FOR EXPORT;
--copy_file $MYSQLD_DATADIR/test/g.ibd $A/g.ibd
UNLOCK TABLES;
DROP TABLE g;
DROP SPATIAL REFERENCE SYSTEM 4000001;
--copy_file $A/g.ibd $MYSQLD_DATADIR/test/g.ibd
--error ER_SRS_NOT_FOUND
IMPORT TABLE FROM 'test/g.ibd';
--remove_file $MYSQLD_DATADIR/test/g.ibd

--force-rmdir $A
--force-rmdir $B

# Recovery must ignore an entry of #ib_archive that is not a page tracking
# group directory, such as a copy of a group directory set aside under
# another name.
#
# The test copies the directory of the active page tracking group from
# page_group_<lsn> to page_group_<lsn>.hidden and restarts the server twice.
# The group must keep tracking pages, and the copy must stay as it is.

--source include/have_debug.inc
--source include/not_valgrind.inc

let MYSQLD_DATADIR = `SELECT @@datadir`;

call mtr.add_suppression("Page archiver: ignoring .*page_group_[0-9]+\\.hidden, which is not a page-tracking group directory");

INSTALL COMPONENT 'file://component_mysqlbackup';
CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, b VARCHAR(1000))
  ENGINE=InnoDB;

--let $start_lsn = `SELECT mysqlbackup_page_track_set(1)`
INSERT INTO t1 (b) VALUES (REPEAT('x', 1000));
SET GLOBAL innodb_buf_flush_list_now = ON;

--source include/shutdown_mysqld.inc

--echo #
--echo # Copy the group directory
--echo #
--perl
  my @dirs = glob("$ENV{MYSQLD_DATADIR}#ib_archive/page_group_*");
  die "Expected one group directory\n" unless @dirs == 1;
  my $dir = $dirs[0];
  use File::Copy;
  use Digest::MD5;
  mkdir("$dir.hidden") or die "mkdir $dir.hidden: $!\n";
  opendir(my $dh, $dir) or die "$dir: $!\n";
  my @files = sort grep { !/^\./ } readdir($dh);
  open(my $out, '>', "$ENV{MYSQLTEST_VARDIR}/tmp/copied_group_files") or die;
  foreach my $file (@files) {
    copy("$dir/$file", "$dir.hidden/$file") or die "copy $file: $!\n";
    open(my $fh, '<:raw', "$dir.hidden/$file") or die;
    print $out "$file " . Digest::MD5->new->addfile($fh)->hexdigest . "\n";
  }
EOF

--source include/start_mysqld.inc
--source include/restart_mysqld.inc

--echo #
--echo # The group tracks new pages after the restarts
--echo #
# A checkpoint sets the latest stop LSN of page tracking.
SET GLOBAL innodb_log_checkpoint_now = ON;
--let $pages_before = `SELECT mysqlbackup_page_track_get_changed_page_count($start_lsn, 0)`

--disable_query_log
--let $i = 8
while ($i)
{
  INSERT INTO t1 (b) SELECT b FROM t1;
  --dec $i
}
--enable_query_log
SET GLOBAL innodb_buf_flush_list_now = ON;
SET GLOBAL innodb_log_checkpoint_now = ON;
--let $pages_after = `SELECT mysqlbackup_page_track_get_changed_page_count($start_lsn, 0)`
if ($pages_after <= $pages_before)
{
  --echo Changed pages before: $pages_before, after: $pages_after
  --die The group does not track new pages after the restarts
}

--echo #
--echo # The copy is unchanged
--echo #
--perl
  my @dirs = glob("$ENV{MYSQLD_DATADIR}#ib_archive/page_group_*.hidden");
  die "The copy is missing\n" unless @dirs == 1;
  my $dir = $dirs[0];
  use Digest::MD5;
  opendir(my $dh, $dir) or die "$dir: $!\n";
  my $after = '';
  foreach my $file (sort grep { !/^\./ } readdir($dh)) {
    open(my $fh, '<:raw', "$dir/$file") or die;
    $after .= "$file " . Digest::MD5->new->addfile($fh)->hexdigest . "\n";
  }
  open(my $in, '<', "$ENV{MYSQLTEST_VARDIR}/tmp/copied_group_files") or die;
  my $before = do { local $/; <$in> };
  die "Files before:\n$before" . "Files after:\n$after" unless $after eq $before;
EOF
--remove_file $MYSQLTEST_VARDIR/tmp/copied_group_files

--echo #
--echo # Cleanup
--echo #
--disable_result_log
SELECT mysqlbackup_page_track_set(0);
--enable_result_log
DROP TABLE t1;
UNINSTALL COMPONENT 'file://component_mysqlbackup';
--force-rmdir $MYSQLD_DATADIR/#ib_archive

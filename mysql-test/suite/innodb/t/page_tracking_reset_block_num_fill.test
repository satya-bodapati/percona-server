# A page tracking reset point whose block number does not fit in 16 bits
# must be read back after a restart.
#
# The reset block of a file stores 2 bytes for the block number of each reset
# point. Block numbers pass 65535 in ib_page_32. page_archiver_one_page_per_
# block makes a block full after one page ID, so updating and flushing a table
# fills ib_page_0 to ib_page_33 in a few minutes. A reset point taken then is
# above 65535.

--source include/have_debug.inc
--source include/big_test.inc
--source include/not_valgrind.inc

let MYSQLD_DATADIR = `SELECT @@datadir`;

INSTALL COMPONENT 'file://component_mysqlbackup';

# 4096 rows of 4000 bytes: about 1400 pages.
CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, b VARCHAR(4000))
  ENGINE=InnoDB;
INSERT INTO t1 (b) VALUES (REPEAT('x', 4000));
--disable_query_log
--let $i = 12
while ($i)
{
  INSERT INTO t1 (b) SELECT b FROM t1;
  --dec $i
}
--enable_query_log

--let $group_lsn = `SELECT mysqlbackup_page_track_set(1)`
--let $file = $MYSQLD_DATADIR#ib_archive/page_group_$group_lsn/ib_page_34

--echo #
--echo # Fill the archive files up to ib_page_34
--echo #
SET GLOBAL debug = '+d,page_archiver_one_page_per_block';

--let $have_file = 0
--let $round = 0
while (!$have_file)
{
  --inc $round
  if ($round > 200)
  {
    --die ib_page_34 was not created
  }
  --disable_query_log
  eval UPDATE t1 SET b = REPEAT(CHAR(65 + $round % 26), 4000);
  SET GLOBAL innodb_buf_flush_list_now = ON;
  --enable_query_log

  --let $have_file = `SELECT LOAD_FILE('$file') IS NOT NULL`
}

SET GLOBAL debug = '-d,page_archiver_one_page_per_block';

--echo #
--echo # A reset point above block 65535
--echo #
--let $start_lsn = `SELECT mysqlbackup_page_track_set(1)`

UPDATE t1 SET b = REPEAT('z', 4000) WHERE id < 100;
SET GLOBAL innodb_buf_flush_list_now = ON;
# A checkpoint sets the latest stop LSN of page tracking.
SET GLOBAL innodb_log_checkpoint_now = ON;

--let $pages_before = `SELECT mysqlbackup_page_track_get_changed_page_count($start_lsn, 0)`
if ($pages_before <= 0)
{
  --echo Changed pages before the restart: $pages_before
  --die No changed pages before the restart
}

--source include/restart_mysqld.inc

--echo #
--echo # The changed pages since the reset point are read back
--echo #
--let $pages_after = `SELECT mysqlbackup_page_track_get_changed_page_count($start_lsn, 0)`
if ($pages_after < $pages_before)
{
  --echo Changed pages after the restart: $pages_after, before: $pages_before
  --die Changed pages are missing after the restart
}

--echo #
--echo # Cleanup
--echo #
--disable_result_log
SELECT mysqlbackup_page_track_set(0);
--enable_result_log
DROP TABLE t1;
UNINSTALL COMPONENT 'file://component_mysqlbackup';
--force-rmdir $MYSQLD_DATADIR/#ib_archive

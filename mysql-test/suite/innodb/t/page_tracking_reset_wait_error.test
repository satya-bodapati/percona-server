# A durable mysqlbackup_page_track_set(1) returns only a reset point whose
# reset block is on disk. It returns an error, and does not start, when the
# wait for the reset block times out or the page archiver fails to write it.
# After a clean restart, a durable start that attaches to the recovered reset
# point returns at once. When the first start of a group fails, page tracking
# stops.
#
# page_archiver_reset_wait_timeout makes the wait time out at once.
# page_archiver_reset_block_write_error makes every write of a reset block
# fail.

--source include/have_debug.inc
--source include/not_valgrind.inc
--source include/have_innodb_16k.inc

--disable_query_log
call mtr.add_suppression("\\[InnoDB\\] .*[Pp]age [Aa]rchiv");
call mtr.add_suppression("\\[InnoDB\\] .*[Pp]age [Tt]racking");
--enable_query_log

let MYSQLD_DATADIR = `SELECT @@datadir`;

INSTALL COMPONENT 'file://component_mysqlbackup';

# About 6000 pages: more than the 2044 page IDs that fit in one data block, so
# that the next start saves a new reset point.
CREATE TABLE t1 (id INT PRIMARY KEY, pad VARCHAR(7000)) ENGINE=InnoDB;
SET SESSION cte_max_recursion_depth = 12000;
INSERT INTO t1
  WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq
                            WHERE n < 12000)
  SELECT n, REPEAT('a', 7000) FROM seq;

--disable_result_log
SELECT mysqlbackup_page_track_set(1);
--enable_result_log

--echo #
--echo # The wait for the reset block times out
--echo #
UPDATE t1 SET pad = REPEAT('b', 7000);
SET GLOBAL innodb_buf_flush_list_now = ON;
SET GLOBAL DEBUG = '+d,page_archiver_reset_wait_timeout';
--error ER_INTERNAL_ERROR
SELECT mysqlbackup_page_track_set(1);
SET GLOBAL DEBUG = '-d,page_archiver_reset_wait_timeout';

--echo # Page tracking starts after the error
SELECT mysqlbackup_page_track_set(1) > 0;

--echo #
--echo # A durable start after a clean restart attaches to the recovered reset
--echo # point
--echo #
--let $last_lsn = `SELECT mysqlbackup_page_track_set(1)`
--source include/restart_mysqld.inc
--let $attach_lsn = `SELECT mysqlbackup_page_track_set(1)`
if ($attach_lsn != $last_lsn)
{
  --echo Start after the restart: $attach_lsn, last reset point: $last_lsn
  --die The start did not attach to the recovered reset point
}

--echo #
--echo # The page archiver fails to write the reset block
--echo #
UPDATE t1 SET pad = REPEAT('c', 7000);
SET GLOBAL innodb_buf_flush_list_now = ON;
SET GLOBAL DEBUG = '+d,page_archiver_reset_block_write_error';
--error ER_QUERY_INTERRUPTED
SELECT mysqlbackup_page_track_set(1);
SET GLOBAL DEBUG = '-d,page_archiver_reset_block_write_error';

--echo # The page archiver has stopped; page tracking starts after a restart
--source include/restart_mysqld.inc
SELECT mysqlbackup_page_track_set(1) > 0;

--echo #
--echo # The wait of the first start of a group times out
--echo #
--disable_result_log
SELECT mysqlbackup_page_track_set(0);
--enable_result_log
SET GLOBAL DEBUG = '+d,page_archiver_reset_wait_timeout';
--error ER_INTERNAL_ERROR
SELECT mysqlbackup_page_track_set(1);
SET GLOBAL DEBUG = '-d,page_archiver_reset_wait_timeout';

--echo # Page tracking stops: changed pages are not archived
--perl
my $size = 0;
sleep(2);
$size += -s $_ for glob("$ENV{MYSQLD_DATADIR}/#ib_archive/page_group_*/ib_page_*");
open(my $fh, '>', "$ENV{MYSQLTEST_VARDIR}/tmp/page_tracking_size") or die;
print $fh $size;
close($fh);
EOF
UPDATE t1 SET pad = REPEAT('d', 7000);
SET GLOBAL innodb_buf_flush_list_now = ON;
--perl
my $size = 0;
sleep(2);
$size += -s $_ for glob("$ENV{MYSQLD_DATADIR}/#ib_archive/page_group_*/ib_page_*");
open(my $fh, '<', "$ENV{MYSQLTEST_VARDIR}/tmp/page_tracking_size") or die;
my $before = <$fh>;
close($fh);
die "The archive grew from $before to $size bytes\n" if $size != $before;
EOF
--remove_file $MYSQLTEST_VARDIR/tmp/page_tracking_size

--echo # Page tracking starts again
SELECT mysqlbackup_page_track_set(1) > 0;

--echo #
--echo # Cleanup
--echo #
--disable_result_log
SELECT mysqlbackup_page_track_set(0);
--enable_result_log
DROP TABLE t1;
UNINSTALL COMPONENT 'file://component_mysqlbackup';
--force-rmdir $MYSQLD_DATADIR/#ib_archive

# A page tracking reset point whose block number does not fit in 16 bits
# must be read back after a restart.
#
# The reset block of a file stores 2 bytes for the block number of each reset
# point. page_archiver_start_group_at_file_33 starts a new group at the first
# data block of ib_page_33, block 67419, so its first reset point is above
# 65535.

--source include/have_debug.inc
--source include/not_valgrind.inc

let MYSQLD_DATADIR = `SELECT @@datadir`;

INSTALL COMPONENT 'file://component_mysqlbackup';
CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, b VARCHAR(1000))
  ENGINE=InnoDB;

--let $start_lsn = `SELECT mysqlbackup_page_track_set(1)`

INSERT INTO t1 (b) VALUES (REPEAT('x', 1000));
--disable_query_log
--let $i = 10
while ($i)
{
  INSERT INTO t1 (b) SELECT b FROM t1;
  --dec $i
}
--enable_query_log
SET GLOBAL innodb_buf_flush_list_now = ON;
# A checkpoint sets the latest stop LSN of page tracking.
SET GLOBAL innodb_log_checkpoint_now = ON;

--let $pages_before = `SELECT mysqlbackup_page_track_get_changed_page_count($start_lsn, 0)`
if ($pages_before <= 0)
{
  --echo Changed pages before the restart: $pages_before
  --die No changed pages before the restart
}

--echo #
--echo # The group starts at ib_page_33
--echo #
--let $file = $MYSQLD_DATADIR#ib_archive/page_group_$start_lsn/ib_page_33
if (`SELECT LOAD_FILE('$file') IS NULL`)
{
  --die ib_page_33 does not exist
}

--source include/restart_mysqld.inc

--echo #
--echo # The changed pages since the first reset point are read back
--echo #
--let $pages_after = `SELECT mysqlbackup_page_track_get_changed_page_count($start_lsn, 0)`
if ($pages_after < $pages_before)
{
  --echo Changed pages after the restart: $pages_after, before: $pages_before
  --die Changed pages are missing after the restart
}

--echo #
--echo # Cleanup
--echo #
--disable_result_log
SELECT mysqlbackup_page_track_set(0);
--enable_result_log
DROP TABLE t1;
UNINSTALL COMPONENT 'file://component_mysqlbackup';
--force-rmdir $MYSQLD_DATADIR/#ib_archive

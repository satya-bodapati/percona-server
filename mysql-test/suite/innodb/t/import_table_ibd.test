--echo #
--echo # IMPORT TABLE FROM '<file>.ibd' creates a table from the table
--echo # definition (SDI) stored in its InnoDB tablespace file.
--echo #

--source include/have_innodb_16k.inc

let $MYSQLD_DATADIR = `SELECT @@datadir`;

--echo # A table with a secondary index, an externally stored BLOB and an
--echo # AUTO_INCREMENT column.
CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, a VARCHAR(100),
                 b LONGBLOB, KEY k_a (a)) ENGINE=InnoDB;
INSERT INTO t1 (a, b) VALUES ('one', REPEAT('x', 100)),
                             ('two', REPEAT('y', 40000)),
                             ('three', NULL);
DELETE FROM t1 WHERE a = 'three';

--echo # Keep a consistent copy of the tablespace file, then drop the table.
FLUSH TABLES t1 FOR EXPORT;
--copy_file $MYSQLD_DATADIR/test/t1.ibd $MYSQL_TMP_DIR/t1.ibd
UNLOCK TABLES;
DROP TABLE t1;

--echo # Put the file back where the table keeps it and import it.
--copy_file $MYSQL_TMP_DIR/t1.ibd $MYSQLD_DATADIR/test/t1.ibd
IMPORT TABLE FROM 'test/t1.ibd';

SHOW CREATE TABLE t1;
SELECT id, a, LENGTH(b) FROM t1 ORDER BY id;
SELECT id, a FROM t1 FORCE INDEX (k_a) ORDER BY a;
CHECK TABLE t1;

--echo # AUTO_INCREMENT continues after the highest value, also after a
--echo # restart.
INSERT INTO t1 (a) VALUES ('four');
--source include/restart_mysqld.inc
INSERT INTO t1 (a) VALUES ('five');
SELECT id, a FROM t1 ORDER BY id;
CHECK TABLE t1;

--echo # The table is an ordinary table: DDL and DML work.
ALTER TABLE t1 ADD COLUMN c INT DEFAULT 7, ALGORITHM=INSTANT;
UPDATE t1 SET c = id;
SELECT id, a, c FROM t1 ORDER BY id;
DROP TABLE t1;

--echo #
--echo # A table that exists is not replaced.
--echo #
CREATE TABLE t1 (id INT PRIMARY KEY) ENGINE=InnoDB;
--echo # The file of a live table is refused before it is read.
--error ER_IMP_TABLE_ALREADY_EXISTS
IMPORT TABLE FROM 'test/t1.ibd';
DROP TABLE t1;

--echo #
--echo # The file must be in the directory of the table's schema, named after
--echo # the table.
--echo #
CREATE DATABASE test2;
--copy_file $MYSQL_TMP_DIR/t1.ibd $MYSQLD_DATADIR/test2/t1.ibd
--replace_result $MYSQLD_DATADIR DATADIR/
--error ER_TABLE_SCHEMA_MISMATCH
IMPORT TABLE FROM 'test2/t1.ibd';
--remove_file $MYSQLD_DATADIR/test2/t1.ibd
DROP DATABASE test2;

--copy_file $MYSQL_TMP_DIR/t1.ibd $MYSQLD_DATADIR/test/other.ibd
--replace_result $MYSQLD_DATADIR DATADIR/
--error ER_TABLE_SCHEMA_MISMATCH
IMPORT TABLE FROM 'test/other.ibd';
--remove_file $MYSQLD_DATADIR/test/other.ibd

--echo #
--echo # The schema must exist.
--echo #
CREATE DATABASE db1;
CREATE TABLE db1.t1 (id INT PRIMARY KEY) ENGINE=InnoDB;
FLUSH TABLES db1.t1 FOR EXPORT;
--copy_file $MYSQLD_DATADIR/db1/t1.ibd $MYSQL_TMP_DIR/db1_t1.ibd
UNLOCK TABLES;
DROP DATABASE db1;
--mkdir $MYSQLD_DATADIR/db1
--copy_file $MYSQL_TMP_DIR/db1_t1.ibd $MYSQLD_DATADIR/db1/t1.ibd
--error ER_IMP_SCHEMA_DOES_NOT_EXIST
IMPORT TABLE FROM 'db1/t1.ibd';
--remove_file $MYSQLD_DATADIR/db1/t1.ibd
--rmdir $MYSQLD_DATADIR/db1
--remove_file $MYSQL_TMP_DIR/db1_t1.ibd

--echo #
--echo # .sdi and .ibd files cannot be mixed, and a pattern must match.
--echo #
--error ER_WRONG_ARGUMENTS
IMPORT TABLE FROM 'test/t1.ibd', 'test/t1.sdi';
--error ER_IMP_NO_FILES_MATCHED
IMPORT TABLE FROM 'test/no_such_table.ibd';

--echo #
--echo # A general tablespace cannot be imported.
--echo #
CREATE TABLESPACE ts1 ADD DATAFILE 'ts1.ibd' ENGINE=InnoDB;
CREATE TABLE t2 (id INT PRIMARY KEY) TABLESPACE ts1;
FLUSH TABLES t2 FOR EXPORT;
UNLOCK TABLES;
let $ts1_file = `SELECT CONCAT(@@datadir, 'ts1.ibd')`;
--replace_result $MYSQLD_DATADIR DATADIR/
--error ER_NOT_SUPPORTED_YET
eval IMPORT TABLE FROM '$ts1_file';
DROP TABLE t2;
DROP TABLESPACE ts1;

--echo #
--echo # Privileges: CREATE and ALTER on the table; FILE is not needed.
--echo #
CREATE USER importer@localhost;
GRANT CREATE ON test.* TO importer@localhost;
--copy_file $MYSQL_TMP_DIR/t1.ibd $MYSQLD_DATADIR/test/t1.ibd
--connect (con1, localhost, importer,,test)
--error ER_TABLEACCESS_DENIED_ERROR
IMPORT TABLE FROM 'test/t1.ibd';
--disconnect con1
--connection default
GRANT ALTER ON test.* TO importer@localhost;
--connect (con1, localhost, importer,,test)
IMPORT TABLE FROM 'test/t1.ibd';
--disconnect con1
--connection default
SELECT COUNT(*) FROM t1;
DROP TABLE t1;
DROP USER importer@localhost;

--echo #
--echo # With innodb_file_per_table off, the table still gets its own
--echo # tablespace: the file being imported.
--echo #
SET @saved_file_per_table = @@GLOBAL.innodb_file_per_table;
SET GLOBAL innodb_file_per_table = OFF;
--copy_file $MYSQL_TMP_DIR/t1.ibd $MYSQLD_DATADIR/test/t1.ibd
IMPORT TABLE FROM 'test/t1.ibd';
SELECT SPACE_TYPE FROM INFORMATION_SCHEMA.INNODB_TABLES WHERE NAME = 'test/t1';
SELECT COUNT(*) FROM t1;
CHECK TABLE t1;
DROP TABLE t1;
SET GLOBAL innodb_file_per_table = @saved_file_per_table;

--remove_file $MYSQL_TMP_DIR/t1.ibd

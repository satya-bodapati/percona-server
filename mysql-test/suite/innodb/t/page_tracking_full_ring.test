# A page writer that finds no free page tracking block must wait for the
# archiver to write one.
#
# The archiver keeps 32 blocks of page IDs in memory. page_archiver_one_page_
# per_block makes a block full after one page ID. page_archiver_wait_for_full_
# ring makes the archiver write no block until a page writer finds no free
# block; the archiver then signals page_archiver_writer_waits and waits for
# page_archiver_write_blocks.

--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_valgrind.inc

let MYSQLD_DATADIR = `SELECT @@datadir`;

INSTALL COMPONENT 'file://component_mysqlbackup';

# 256 rows of 4000 bytes: more pages than the 32 blocks hold page IDs.
CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, b VARCHAR(4000))
  ENGINE=InnoDB;
INSERT INTO t1 (b) VALUES (REPEAT('x', 4000));
--disable_query_log
--let $i = 8
while ($i)
{
  INSERT INTO t1 (b) SELECT b FROM t1;
  --dec $i
}
--enable_query_log

--disable_result_log
SELECT mysqlbackup_page_track_set(1);
--enable_result_log

DELIMITER |;
CREATE PROCEDURE update_and_flush()
BEGIN
  UPDATE t1 SET b = REPEAT('y', 4000);
  SET GLOBAL innodb_buf_flush_list_now = ON;
END|
DELIMITER ;|

# SET GLOBAL innodb_buf_flush_list_now blocks new connections and other
# SET GLOBAL statements until the flush ends, so connect first.
--connect (con1, localhost, root)

--connection default
SET GLOBAL debug = '+d,page_archiver_one_page_per_block,page_archiver_wait_for_full_ring';

--connection con1
--send CALL update_and_flush()

--connection default
--echo # A page writer finds no free block
SET DEBUG_SYNC = 'now WAIT_FOR page_archiver_writer_waits';

--echo # The archiver writes the blocks
SET DEBUG_SYNC = 'now SIGNAL page_archiver_write_blocks';

--connection con1
--reap
--disconnect con1

--connection default
SET GLOBAL debug = '-d,page_archiver_one_page_per_block,page_archiver_wait_for_full_ring';
SET DEBUG_SYNC = 'RESET';

--echo #
--echo # Cleanup
--echo #
--disable_result_log
SELECT mysqlbackup_page_track_set(0);
--enable_result_log
DROP PROCEDURE update_and_flush;
DROP TABLE t1;
UNINSTALL COMPONENT 'file://component_mysqlbackup';
--force-rmdir $MYSQLD_DATADIR/#ib_archive

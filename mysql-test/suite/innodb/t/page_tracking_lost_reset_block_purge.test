# The reset point that a purge keeps must be on disk, so that the server
# restarts after mysqlbackup_page_track_purge_up_to().
#
# A purge up to a reset point removes the files before the file of that reset
# point. If the reset block of that file was never written, and no later file
# has a written reset block, recovery finds no reset point in the group and
# loads it with an empty list of start points.
#
# page_archiver_simulate_more_archived_files makes each file hold 7 data
# blocks. page_archiver_hold_reset_flush holds the archiver after it has taken
# the reset point to write, until the writer has moved past the data block of
# the reset point, and signals page_archiver_reset_flush_held when it starts
# holding.
#
# After the purge and a restart, a reset block of the group has the reset
# point, and the changed pages since it are read back.

--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/not_valgrind.inc
# t1 needs more pages than one archive block holds page IDs.
--source include/have_innodb_16k.inc

--disable_query_log
call mtr.add_suppression("Page archiver");
--enable_query_log

let MYSQLD_DATADIR = `SELECT @@datadir`;

INSTALL COMPONENT 'file://component_mysqlbackup';

CREATE TABLE reset_lsn (lsn BIGINT UNSIGNED) ENGINE=InnoDB;

# 8192 rows of 5000 bytes: about 2700 pages, more than one archive block
# holds page IDs.
CREATE TABLE t1 (id INT AUTO_INCREMENT PRIMARY KEY, n INT, pad VARCHAR(5000))
  ENGINE=InnoDB;
INSERT INTO t1 (n, pad) VALUES (0, REPEAT('a', 5000));
--disable_query_log
--let $i = 13
while ($i)
{
  INSERT INTO t1 (n, pad) SELECT n, pad FROM t1;
  --dec $i
}
--enable_query_log

--let $page_tracking_start_lsn = `SELECT mysqlbackup_page_track_set(1)`

--echo #
--echo # Track pages into ib_page_0 and ib_page_1
--echo #
--let $file_index = 1
--source suite/innodb/include/page_tracking_write_until_file.inc

--echo #
--echo # Start a reset point in ib_page_1 while the archiver holds its reset
--echo # block flush, and fill its data block
--echo #
# Keep the changed pages dirty until the reset point is taken.
SET GLOBAL innodb_page_cleaner_disabled_debug = ON;
UPDATE t1 SET n = n + 1;
SET GLOBAL DEBUG = '+d,page_archiver_hold_reset_flush';

--connect (con1, localhost, root)
--send INSERT INTO reset_lsn SELECT mysqlbackup_page_track_set(1)

--connection default
SET DEBUG_SYNC = 'now WAIT_FOR page_archiver_reset_flush_held';
SET GLOBAL innodb_page_cleaner_disabled_debug = OFF;
SET GLOBAL innodb_buf_flush_list_now = ON;

--connection con1
--reap
--disconnect con1

--connection default
SET GLOBAL DEBUG = '-d,page_archiver_hold_reset_flush';
SET DEBUG_SYNC = 'RESET';
--let $purge_lsn = `SELECT lsn FROM reset_lsn`

--echo #
--echo # Purge the files before the reset point
--echo #
--disable_query_log
--disable_result_log
eval SELECT mysqlbackup_page_track_purge_up_to($purge_lsn);
--enable_result_log
--enable_query_log

--perl
my @files = glob("$ENV{MYSQLD_DATADIR}/#ib_archive/page_group_*/ib_page_0");
die "ib_page_0 was not purged\n" if @files;
EOF

--source include/restart_mysqld.inc

--let $reset_file_index = any
--let $reset_lsn = $purge_lsn
--let $data_blocks_per_file = 7
--source suite/innodb/include/page_tracking_check_reset_point.inc

--echo #
--echo # The changed pages since the reset point are read back
--echo #
# A checkpoint sets the latest stop LSN of page tracking.
SET GLOBAL innodb_log_checkpoint_now = ON;
--let $pages = `SELECT mysqlbackup_page_track_get_changed_page_count($purge_lsn, 0)`
if ($pages <= 0)
{
  --echo Changed pages since the reset point: $pages
  --die No changed pages since the reset point after the restart
}

--echo #
--echo # Cleanup
--echo #
--disable_result_log
SELECT mysqlbackup_page_track_set(0);
--enable_result_log
DROP TABLE t1;
DROP TABLE reset_lsn;
UNINSTALL COMPONENT 'file://component_mysqlbackup';
--force-rmdir $MYSQLD_DATADIR/#ib_archive

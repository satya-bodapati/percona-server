diff --git a/mysql-test/suite/percona/t/vector_alter_instant_label_race.test b/mysql-test/suite/percona/t/vector_alter_instant_label_race.test
new file mode 100644
index 00000000000..39dc9a1f4f9
--- /dev/null
+++ b/mysql-test/suite/percona/t/vector_alter_instant_label_race.test
@@ -0,0 +1,44 @@
+--echo #
+--echo # PS-11299: no ALTER of a vector-indexed table runs with
+--echo # ALGORITHM=INSTANT.
+--echo #
+--echo # INSTANT runs its prepare phase under MDL_SHARED_UPGRADABLE, with
+--echo # concurrent DML live throughout. Phase 1 refuses it and takes the
+--echo # INPLACE path, which blocks writers. The label counter itself is
+--echo # carried forward in the commit phase, under MDL_EXCLUSIVE.
+--echo #
+
+CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
+                 pad INT,
+                 v VECTOR(4) NOT NULL);
+INSERT INTO t1 (id, pad, v) VALUES (1,10,STRING_TO_VECTOR('[1,0,0,0]')),
+                                   (2,20,STRING_TO_VECTOR('[2,0,0,0]'));
+ALTER TABLE t1 ADD KEY (v) TYPE hnsw WITH (M = 8);
+
+--echo # Pure metadata, and still refused: the table carries a vector index.
+--error ER_ALTER_OPERATION_NOT_SUPPORTED_REASON
+ALTER TABLE t1 RENAME COLUMN pad TO pad2, ALGORITHM=INSTANT;
+
+--echo # Without ALGORITHM=INSTANT the server picks a supported algorithm.
+ALTER TABLE t1 RENAME COLUMN pad TO pad2;
+
+INSERT INTO t1 (id, pad2, v) VALUES (3,30,STRING_TO_VECTOR('[3,0,0,0]'));
+SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
+SELECT @@session.innodb_interpreter_output;
+
+--echo # The counter survives the restart: the next label is 4, not a reissue
+--echo # of 1. Note vec_next_id mints the label it reports, so it consumes 4
+--echo # and the INSERT below gets 5 - which is why the labels are no longer
+--echo # contiguous and why no row carries 4.
+SET GLOBAL innodb_log_checkpoint_now = ON;
+--source include/restart_mysqld.inc
+
+SET SESSION innodb_interpreter = 'vec_next_id test/t1';
+SELECT @@session.innodb_interpreter_output;
+INSERT INTO t1 (id, pad2, v) VALUES (4,40,STRING_TO_VECTOR('[4,0,0,0]'));
+
+--echo # What matters is that no label was handed out twice.
+SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
+SELECT @@session.innodb_interpreter_output;
+
+DROP TABLE t1;

diff --git a/mysql-test/suite/percona/r/vector_alter_instant_label_race.result b/mysql-test/suite/percona/r/vector_alter_instant_label_race.result
new file mode 100644
index 00000000000..e5bd2ed0576
--- /dev/null
+++ b/mysql-test/suite/percona/r/vector_alter_instant_label_race.result
@@ -0,0 +1,42 @@
+#
+# PS-11299: no ALTER of a vector-indexed table runs with
+# ALGORITHM=INSTANT.
+#
+# INSTANT runs its prepare phase under MDL_SHARED_UPGRADABLE, with
+# concurrent DML live throughout. Phase 1 refuses it and takes the
+# INPLACE path, which blocks writers. The label counter itself is
+# carried forward in the commit phase, under MDL_EXCLUSIVE.
+#
+CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
+pad INT,
+v VECTOR(4) NOT NULL);
+INSERT INTO t1 (id, pad, v) VALUES (1,10,STRING_TO_VECTOR('[1,0,0,0]')),
+(2,20,STRING_TO_VECTOR('[2,0,0,0]'));
+ALTER TABLE t1 ADD KEY (v) TYPE hnsw WITH (M = 8);
+# Pure metadata, and still refused: the table carries a vector index.
+ALTER TABLE t1 RENAME COLUMN pad TO pad2, ALGORITHM=INSTANT;
+ERROR 0A000: ALGORITHM=INSTANT is not supported. Reason: InnoDB does not support ALGORITHM=INSTANT on a table carrying vector index metadata. Try ALGORITHM=COPY/INPLACE.
+# Without ALGORITHM=INSTANT the server picks a supported algorithm.
+ALTER TABLE t1 RENAME COLUMN pad TO pad2;
+INSERT INTO t1 (id, pad2, v) VALUES (3,30,STRING_TO_VECTOR('[3,0,0,0]'));
+SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
+SELECT @@session.innodb_interpreter_output;
+@@session.innodb_interpreter_output
+nodes=3 distinct_ids=3 distinct_base_pks=3 dup_ids=0 dup_base_pks=0 labels_contiguous_from_1=1
+# The counter survives the restart: the next label is 4, not a reissue
+# of 1. Note vec_next_id mints the label it reports, so it consumes 4
+# and the INSERT below gets 5 - which is why the labels are no longer
+# contiguous and why no row carries 4.
+SET GLOBAL innodb_log_checkpoint_now = ON;
+# restart
+SET SESSION innodb_interpreter = 'vec_next_id test/t1';
+SELECT @@session.innodb_interpreter_output;
+@@session.innodb_interpreter_output
+id=4
+INSERT INTO t1 (id, pad2, v) VALUES (4,40,STRING_TO_VECTOR('[4,0,0,0]'));
+# What matters is that no label was handed out twice.
+SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
+SELECT @@session.innodb_interpreter_output;
+@@session.innodb_interpreter_output
+nodes=4 distinct_ids=4 distinct_base_pks=4 dup_ids=0 dup_base_pks=0 labels_contiguous_from_1=0
+DROP TABLE t1;
diff --git a/mysql-test/suite/percona/r/vector_alter_online_label_race.result b/mysql-test/suite/percona/r/vector_alter_online_label_race.result
new file mode 100644
index 00000000000..a9a8e0b86ee
--- /dev/null
+++ b/mysql-test/suite/percona/r/vector_alter_online_label_race.result
@@ -0,0 +1,42 @@
+#
+# PS-11299: no ALTER of a vector-indexed table runs with LOCK=NONE.
+#
+# The label counter is read in the prepare phase and written to the new
+# dd::Table at commit. DML in between keeps minting labels, so the
+# value committed would be behind the labels already stamped into rows
+# and a later mint could reissue one. LOCK=NONE is refused instead.
+#
+CREATE TABLE t1 (id BIGINT UNSIGNED PRIMARY KEY,
+serial BIGINT UNSIGNED AUTO_INCREMENT UNIQUE,
+v VECTOR(4) NOT NULL);
+INSERT INTO t1 (id, v) VALUES (1,STRING_TO_VECTOR('[1,0,0,0]')),
+(2,STRING_TO_VECTOR('[2,0,0,0]'));
+ALTER TABLE t1 ADD KEY (v) TYPE hnsw WITH (M = 8);
+SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
+SELECT @@session.innodb_interpreter_output;
+@@session.innodb_interpreter_output
+nodes=2 distinct_ids=2 distinct_base_pks=2 dup_ids=0 dup_base_pks=0 labels_contiguous_from_1=1
+# An ordinary secondary index: not a rebuild, does not touch the vector
+# key. Refused anyway, because the table carries a vector index.
+ALTER TABLE t1 ADD INDEX id_idx (id), ALGORITHM=INPLACE, LOCK=NONE;
+ERROR 0A000: LOCK=NONE is not supported. Reason: InnoDB does not support building a vector index with LOCK=NONE; rows written while it is built would not reach the graph. Try LOCK=SHARED.
+# The same ALTER without LOCK=NONE is supported.
+ALTER TABLE t1 ADD INDEX id_idx (id), ALGORITHM=INPLACE;
+# Rows inserted after it keep minting labels from where the build left
+# off: 3,4,5 with no reissue.
+INSERT INTO t1 (id, v) VALUES (3,STRING_TO_VECTOR('[3,0,0,0]')),
+(4,STRING_TO_VECTOR('[4,0,0,0]')),
+(5,STRING_TO_VECTOR('[5,0,0,0]'));
+SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
+SELECT @@session.innodb_interpreter_output;
+@@session.innodb_interpreter_output
+nodes=5 distinct_ids=5 distinct_base_pks=5 dup_ids=0 dup_base_pks=0 labels_contiguous_from_1=1
+# And the counter survives a restart: the next label is 6, not a reissue.
+SET GLOBAL innodb_log_checkpoint_now = ON;
+# restart
+INSERT INTO t1 (id, v) VALUES (6,STRING_TO_VECTOR('[6,0,0,0]'));
+SET SESSION innodb_interpreter = 'vec_aux_verify test/t1';
+SELECT @@session.innodb_interpreter_output;
+@@session.innodb_interpreter_output
+nodes=6 distinct_ids=6 distinct_base_pks=6 dup_ids=0 dup_base_pks=0 labels_contiguous_from_1=1
+DROP TABLE t1;
